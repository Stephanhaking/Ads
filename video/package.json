{
  "name": "ad-video",
  "version": "0.1.0",
  "private": true,
  "description": "30-second vertical motion ad for the app, built with Remotion.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:en": "remotion render src/index.ts Ad-EN out/ad-en.mp4 --crf=20",
    "render:pt": "remotion render src/index.ts Ad-PT out/ad-pt.mp4 --crf=20",
    "still": "remotion still src/index.ts Ad-EN out/poster.png --frame=240"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.547",
    "@remotion/cli": "4.0.547",
    "@remotion/renderer": "^4.0.547",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.547"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.6.3"
  }
}
