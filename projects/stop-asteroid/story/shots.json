   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s052",
   "start": 172.04,
   "end": 176.5,
   "line": "The problem is, you don't have ten years. You have three weeks.",
