   "set": null,
   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s050",
   "start": 162.46,
   "end": 167.82,
   "line": "Bo gets bored and kicks the football into the next street. Kai makes her go and get it.",
   "set": null,
   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s051",
   "start": 167.82,
   "end": 172.04,
   "line": "By the end of the night, Ravi can keep a gentle push going for as long as you like.",
