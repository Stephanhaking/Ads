   "set": null,
   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s011",
   "start": 32.72,
   "end": 35.6,
   "line": "But never, ever back.",
   "set": null,
   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s012",
   "start": 35.6,
   "end": 39.9,
   "line": "So what if you could only travel forward in time? Here's the twist.",
   "set": null,
   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s013",
   "start": 39.9,
   "end": 41.44,
   "line": "You already do.",
   "set": null,
   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s014",
   "start": 41.44,
   "end": 45.8,
   "line": "At first, it's the best power in the world. The dentist?",
