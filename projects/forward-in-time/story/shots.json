   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s004",
   "start": 10.02,
   "end": 14.66,
   "line": "And it's three fifteen. The classroom is empty. Your bag is packed.",
