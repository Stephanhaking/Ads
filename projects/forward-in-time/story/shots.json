   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s005",
   "start": 14.66,
   "end": 18.64,
   "line": "The bell rang, and you weren't there for it. Your friend is in the doorway.",
   "set": null,
   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s006",
   "start": 18.64,
   "end": 20.28,
   "line": "Why are you just sitting there?",
   "set": null,
   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s007",
   "start": 20.28,
   "end": 26.08,
   "line": "You've been staring at the wall for twenty minutes! You weren't staring. You were skipping.",
   "set": null,
   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s008",
   "start": 26.08,
   "end": 27.48,
   "line": "Over the next few days you work it out.",
   "set": null,
   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s009",
   "start": 27.48,
   "end": 29.6,
