[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 2.06,
  "text": "Your phone slips out of your hand",
  "end": 1.94
 },
 {
  "i": 1,
  "start": 1.94,
  "speechStart": 2.06,
  "speechEnd": 3.9,
  "text": "on a balcony twelve floors up,",
  "end": 3.98
 },
 {
  "i": 2,
  "start": 3.98,
  "speechStart": 4.1,
  "speechEnd": 7.58,
  "text": "and it stops. Not in your hand.",
  "end": 7.78
 },
 {
  "i": 3,
  "start": 7.78,
  "speechStart": 7.9,
  "speechEnd": 8.6,
  "text": "In the air,",
  "end": 8.94
 },
 {
  "i": 4,
  "start": 8.94,
  "speechStart": 9.06,
  "speechEnd": 11.42,
  "text": "a metre below the railing, screen still glowing.",
  "end": 12.06
 },
 {
  "i": 5,
  "start": 12.06,
  "speechStart": 12.18,
  "speechEnd": 15.28,
  "text": "A pigeon hangs over the street with its wings half open.",
  "end": 15.74
 },
 {
  "i": 6,
  "start": 15.74,
  "speechStart": 15.86,
  "speechEnd": 18.26,
  "text": "The smoke from a chimney is a grey sculpture.",
  "end": 18.92
 },
 {
  "i": 7,
  "start": 18.92,
  "speechStart": 19.04,
  "speechEnd": 22.18,
  "text": "The cars below are parked in the middle of the road.",
  "end": 22.32
 },
 {
  "i": 8,
  "start": 22.32,
  "speechStart": 22.44,
  "speechEnd": 24.7,
  "text": "And there is no sound at all.",
  "end": 25.1
 },
 {
  "i": 9,
  "start": 25.1,
  "speechStart": 25.22,
  "speechEnd": 28.5,
  "text": "You reach down, take your phone out of the air, and count.",
  "end": 28.38
 },
 {
  "i": 10,
  "start": 28.38,
  "speechStart": 28.5,
  "speechEnd": 31.68,
  "text": "One. Two. Three.",
  "end": 31.56
 },
 {
  "i": 11,
  "start": 31.56,
  "speechStart": 31.68,
  "speechEnd": 34.68,
  "text": "Four. Five. And the city starts again,",
  "end": 35.26
 },
 {
  "i": 12,
  "start": 35.26,
  "speechStart": 35.38,
  "speechEnd": 36.58,
  "text": "like someone pressed play.",
  "end": 37.54
 },
 {
  "i": 13,
  "start": 37.54,
  "speechStart": 37.66,
  "speechEnd": 40.16,
  "text": "Overnight, you got the power of The World,",
  "end": 40.44
 },
 {
  "i": 14,
  "start": 40.44,
  "speechStart": 40.56,
  "speechEnd": 43.72,
  "text": "the time-stopping ability from JoJo's Bizarre Adventure.",
  "end": 44.42
 },
 {
  "i": 15,
  "start": 44.42,
  "speechStart": 44.54,
  "speechEnd": 47.82,
  "text": "Not Dio's mansion. Not his knives. Just this:",
  "end": 48.24
 },
 {
  "i": 16,
  "start": 48.24,
  "speechStart": 48.36,
  "speechEnd": 51.2,
  "text": "you can stop time for everyone except you.",
  "end": 51.62
 },
 {
  "i": 17,
  "start": 51.62,
  "speechStart": 51.74,
  "speechEnd": 53.7,
  "text": "In the story, it starts at about five seconds.",
  "end": 54.14
 },
 {
  "i": 18,
  "start": 54.14,
  "speechStart": 54.26,
  "speechEnd": 55.52,
  "text": "Over the next forty days,",
  "end": 55.4
 },
 {
  "i": 19,
  "start": 55.4,
  "speechStart": 55.52,
  "speechEnd": 60.12,
  "text": "you're going to learn what five seconds is really worth. Breakfast.",
  "end": 60.82
 },
 {
  "i": 20,
  "start": 60.82,
  "speechStart": 60.94,
  "speechEnd": 64.96,
  "text": "Your elbow knocks a glass of orange juice off the table. You don't even think.",
  "end": 65.38
 },
 {
  "i": 21,
  "start": 65.38,
  "speechStart": 65.5,
  "speechEnd": 66.58,
  "text": "Everything stops.",
  "end": 67.36
 },
 {
  "i": 22,
  "start": 67.36,
  "speechStart": 67.48,
  "speechEnd": 71.12,
  "text": "The juice hangs in the air like an orange ribbon, half in the glass, half out.",
  "end": 71.74
 },
 {
  "i": 23,
  "start": 71.74,
  "speechStart": 71.86,
  "speechEnd": 72.76,
  "text": "You walk around it.",
  "end": 73.14
 },
 {
  "i": 24,
  "start": 73.14,
  "speechStart": 73.26,
  "speechEnd": 76.52,
  "text": "You poke it, and it's oddly stiff, like jelly.",
  "end": 77.18
 },
 {
  "i": 25,
  "start": 77.18,
  "speechStart": 77.3,
  "speechEnd": 79.42,
  "text": "You put the glass back under it, and when time starts,",
  "end": 79.3
 },
 {
  "i": 26,
  "start": 79.3,
  "speechStart": 79.42,
  "speechEnd": 82.56,
  "text": "the juice falls right back in. You try again.",
  "end": 83.16
 },
 {
  "i": 27,
  "start": 83.16,
  "speechStart": 83.28,
  "speechEnd": 83.72,
  "text": "And again.",
  "end": 84.22
 },
 {
  "i": 28,
  "start": 84.22,
  "speechStart": 84.34,
  "speechEnd": 86.44,
  "text": "You count every time, and it's always the same:",
  "end": 87.06
 },
 {
  "i": 29,
  "start": 87.06,
  "speechStart": 87.18,
  "speechEnd": 90.06,
  "text": "five seconds, then the world moves. Rule one:",
  "end": 90.66
 },
 {
  "i": 30,
  "start": 90.66,
  "speechStart": 90.78,
  "speechEnd": 92.98,
  "text": "you get five seconds. Not six.",
  "end": 93.3
 },
 {
  "i": 31,
  "start": 93.3,
  "speechStart": 93.42,
  "speechEnd": 95.8,
  "text": "Not \"a bit longer if you really need it\". Five.",
  "end": 96.9
 },
 {
  "i": 32,
  "start": 96.9,
  "speechStart": 97.02,
  "speechEnd": 100.14,
  "text": "On day two you stop time in the middle of a busy street,",
  "end": 100.58
 },
 {
  "i": 33,
  "start": 100.58,
  "speechStart": 100.7,
  "speechEnd": 104.8,
  "text": "and the first thing that hits you isn't the frozen people. It's the silence.",
  "end": 105.68
 },
 {
  "i": 34,
  "start": 105.68,
  "speechStart": 105.8,
  "speechEnd": 107.46,
  "text": "Sound is just air bumping into air.",
  "end": 107.8
 },
 {
  "i": 35,
  "start": 107.8,
  "speechStart": 107.92,
  "speechEnd": 111.16,
  "text": "In normal life it moves at about 343 metres per second,",
  "end": 111.4
 },
 {
  "i": 36,
  "start": 111.4,
  "speechStart": 111.52,
  "speechEnd": 113.2,
  "text": "passed from molecule to molecule.",
  "end": 113.84
 },
 {
  "i": 37,
  "start": 113.84,
  "speechStart": 113.96,
  "speechEnd": 117.3,
  "text": "The molecules themselves are flying around at about 500 metres per second.",
  "end": 117.74
 },
 {
  "i": 38,
  "start": 117.74,
  "speechStart": 117.86,
  "speechEnd": 120.0,
  "text": "In your five seconds, none of them move.",
  "end": 120.56
 },
 {
  "i": 39,
  "start": 120.56,
  "speechStart": 120.68,
  "speechEnd": 122.02,
  "text": "So nothing reaches your ears.",
  "end": 122.44
 },
 {
  "i": 40,
  "start": 122.44,
  "speechStart": 122.56,
  "speechEnd": 125.36,
  "text": "Not the guitar, not the dog, not your own footsteps.",
  "end": 126.04
 },
 {
  "i": 41,
  "start": 126.04,
  "speechStart": 126.16,
  "speechEnd": 129.9,
  "text": "You clap your hands. Nothing. You shout. Nothing.",
  "end": 130.5
 },
 {
  "i": 42,
  "start": 130.5,
  "speechStart": 130.62,
  "speechEnd": 132.78,
  "text": "It's the quietest place you have ever been,",
  "end": 133.2
 },
 {
  "i": 43,
  "start": 133.2,
  "speechStart": 133.32,
  "speechEnd": 135.64,
  "text": "and it's in the middle of a city. Rule two:",
  "end": 136.16
 },
 {
  "i": 44,
  "start": 136.16,
  "speechStart": 136.28,
  "speechEnd": 137.5,
  "text": "frozen time is silent.",
  "end": 137.38
 },
 {
  "i": 45,
  "start": 137.38,
  "speechStart": 137.5,
  "speechEnd": 140.22,
  "text": "If you want to talk to someone, you have to wait.",
  "end": 141.22
 },
 {
  "i": 46,
  "start": 141.22,
  "speechStart": 141.34,
  "speechEnd": 143.78,
  "text": "On day four you test the strangest part.",
  "end": 144.24
 },
 {
  "i": 47,
  "start": 144.24,
  "speechStart": 144.36,
  "speechEnd": 145.52,
  "text": "You stop time in a park,",
  "end": 145.72
 },
 {
  "i": 48,
  "start": 145.72,
  "speechStart": 145.84,
  "speechEnd": 148.86,
  "text": "move a frisbee two metres to the left, and let go.",
  "end": 149.48
 },
 {
  "i": 49,
  "start": 149.48,
  "speechStart": 149.6,
  "speechEnd": 151.92,
  "text": "The dog jumps for where the frisbee was.",
  "end": 152.38
 },
 {
  "i": 50,
  "start": 152.38,
  "speechStart": 152.5,
  "speechEnd": 154.4,
  "text": "Then it looks around, confused.",
  "end": 155.2
 },
 {
  "i": 51,
  "start": 155.2,
  "speechStart": 155.32,
  "speechEnd": 156.66,
  "text": "But nobody else even blinks.",
  "end": 157.38
 },
 {
  "i": 52,
  "start": 157.38,
  "speechStart": 157.5,
  "speechEnd": 159.84,
  "text": "That's because a human needs about a quarter of a",
  "end": 159.72
 },
 {
  "i": 53,
  "start": 159.72,
  "speechStart": 159.84,
  "speechEnd": 162.12,
  "text": "second just to react to something they see.",
  "end": 162.76
 },
 {
  "i": 54,
  "start": 162.76,
  "speechStart": 162.88,
  "speechEnd": 164.78,
  "text": "Five seconds is about twenty of those.",
  "end": 164.66
 },
 {
  "i": 55,
  "start": 164.66,
  "speechStart": 164.78,
  "speechEnd": 167.14,
  "text": "You can do a lot in twenty reactions,",
  "end": 167.5
 },
 {
  "i": 56,
  "start": 167.5,
  "speechStart": 167.62,
  "speechEnd": 171.54,
  "text": "and to everyone else it looks like one. Rule three:",
  "end": 171.42
 },
 {
  "i": 57,
  "start": 171.42,
  "speechStart": 171.54,
  "speechEnd": 174.92,
  "text": "from the outside, there's no gap. Things just jump.",
  "end": 175.88
 },
 {
  "i": 58,
  "start": 175.88,
  "speechStart": 176.0,
  "speechEnd": 178.6,
  "text": "On day seven you go to a running track to",
  "end": 178.48
 },
 {
  "i": 59,
  "start": 178.48,
  "speechStart": 178.6,
  "speechEnd": 181.08,
  "text": "find out how far five seconds can take you.",
  "end": 181.54
 },
 {
  "i": 60,
  "start": 181.54,
  "speechStart": 181.66,
  "speechEnd": 183.78,
  "text": "The fastest man ever, Usain Bolt,",
  "end": 184.1
 },
 {
  "i": 61,
  "start": 184.1,
  "speechStart": 184.22,
  "speechEnd": 187.12,
  "text": "ran 100 metres in 9.58 seconds.",
  "end": 187.48
 },
 {
  "i": 62,
  "start": 187.48,
  "speechStart": 187.6,
  "speechEnd": 189.88,
  "text": "That's an average of about ten metres per second.",
  "end": 190.32
 },
 {
  "i": 63,
  "start": 190.32,
  "speechStart": 190.44,
  "speechEnd": 193.62,
  "text": "In five seconds, even he would only get about fifty metres.",
  "end": 193.5
 },
 {
  "i": 64,
  "start": 193.5,
  "speechStart": 193.62,
  "speechEnd": 195.5,
  "text": "You are not Usain Bolt.",
  "end": 196.2
 },
 {
  "i": 65,
  "start": 196.2,
  "speechStart": 196.32,
  "speechEnd": 199.06,
  "text": "You stop time, run as hard as you can, and",
  "end": 198.94
 },
 {
  "i": 66,
  "start": 198.94,
  "speechStart": 199.06,
  "speechEnd": 202.02,
  "text": "when it restarts you're a lot less than fifty metres away,",
  "end": 202.38
 },
 {
  "i": 67,
  "start": 202.38,
  "speechStart": 202.5,
  "speechEnd": 205.64,
  "text": "out of breath, with your shoelace untied. Rule four:",
  "end": 206.24
 },
 {
  "i": 68,
  "start": 206.24,
  "speechStart": 206.36,
  "speechEnd": 208.3,
  "text": "stopping time doesn't make you faster.",
  "end": 208.64
 },
 {
  "i": 69,
  "start": 208.64,
  "speechStart": 208.76,
  "speechEnd": 210.6,
  "text": "It only makes everyone else slower.",
  "end": 211.74
 },
 {
  "i": 70,
  "start": 211.74,
  "speechStart": 211.86,
  "speechEnd": 213.96,
  "text": "On day eleven you film yourself.",
  "end": 214.68
 },
 {
  "i": 71,
  "start": 214.68,
  "speechStart": 214.8,
  "speechEnd": 216.9,
  "text": "Phone on a tripod, you stop time,",
  "end": 217.4
 },
 {
  "i": 72,
  "start": 217.4,
  "speechStart": 217.52,
  "speechEnd": 219.76,
  "text": "walk across the room, and let go.",
  "end": 220.22
 },
 {
  "i": 73,
  "start": 220.22,
  "speechStart": 220.34,
  "speechEnd": 222.52,
  "text": "On the video, you are on the left, and then,",
  "end": 222.42
 },
 {
  "i": 74,
  "start": 222.42,
  "speechStart": 222.54,
  "speechEnd": 225.72,
  "text": "in a single frame, you are on the right. No blur.",
  "end": 226.0
 },
 {
  "i": 75,
  "start": 226.0,
  "speechStart": 226.12,
  "speechEnd": 228.24,
  "text": "No in-between. You just teleport.",
  "end": 229.16
 },
 {
  "i": 76,
  "start": 229.16,
  "speechStart": 229.28,
  "speechEnd": 232.36,
  "text": "And here's a real thing that sounds made up: in 2013,",
  "end": 232.96
 },
 {
  "i": 77,
  "start": 232.96,
  "speechStart": 233.08,
  "speechEnd": 235.08,
  "text": "physicists in Darmstadt, in Germany,",
  "end": 234.96
 },
 {
  "i": 78,
  "start": 234.96,
  "speechStart": 235.08,
  "speechEnd": 236.84,
  "text": "managed to hold light still",
  "end": 236.72
 },
 {
  "i": 79,
  "start": 236.72,
  "speechStart": 236.84,
  "speechEnd": 238.94,
  "text": "inside a crystal for up to a minute,",
  "end": 238.82
 },
 {
  "i": 80,
  "start": 238.82,
  "speechStart": 238.94,
  "speechEnd": 240.5,
  "text": "and store an image in it.",
  "end": 240.6
 },
 {
  "i": 81,
  "start": 240.6,
  "speechStart": 240.72,
  "speechEnd": 243.64,
  "text": "So the light around you in your frozen world isn't impossible.",
  "end": 244.04
 },
 {
  "i": 82,
  "start": 244.04,
  "speechStart": 244.16,
  "speechEnd": 248.12,
  "text": "It's just very, very hard. Rule five:",
  "end": 248.0
 },
 {
  "i": 83,
  "start": 248.0,
  "speechStart": 248.12,
  "speechEnd": 251.12,
  "text": "cameras never see the frozen part. They only see the jump.",
  "end": 252.02
 },
 {
  "i": 84,
  "start": 252.02,
  "speechStart": 252.14,
  "speechEnd": 255.56,
  "text": "Someone else filmed it too. On day eighteen,",
  "end": 255.44
 },
 {
  "i": 85,
  "start": 255.44,
  "speechStart": 255.56,
  "speechEnd": 259.02,
  "text": "a video called \"Glitch Man\" has nine million views.",
  "end": 259.6
 },
 {
  "i": 86,
  "start": 259.6,
  "speechStart": 259.72,
  "speechEnd": 262.84,
  "text": "A person on a pedestrian crossing is on one side of a bus,",
  "end": 262.72
 },
 {
  "i": 87,
  "start": 262.72,
  "speechStart": 262.84,
  "speechEnd": 265.08,
  "text": "and in the next frame they're on the other side.",
  "end": 265.8
 },
 {
  "i": 88,
  "start": 265.8,
  "speechStart": 265.92,
  "speechEnd": 267.4,
  "text": "Half the comments say it's editing.",
  "end": 267.74
 },
 {
  "i": 89,
  "start": 267.74,
  "speechStart": 267.86,
  "speechEnd": 270.26,
  "text": "The other half say it's a time traveller.",
  "end": 270.14
 },
 {
  "i": 90,
  "start": 270.14,
  "speechStart": 270.26,
  "speechEnd": 273.38,
  "text": "Nobody says \"time stopper\", because that's not a real thing.",
  "end": 273.96
 },
 {
  "i": 91,
  "start": 273.96,
  "speechStart": 274.08,
  "speechEnd": 276.12,
  "text": "And you notice what everyone notices first:",
  "end": 276.52
 },
 {
  "i": 92,
  "start": 276.52,
  "speechStart": 276.64,
  "speechEnd": 279.92,
  "text": "how easy it would be to take things. A wallet.",
  "end": 280.3
 },
 {
  "i": 93,
  "start": 280.3,
  "speechStart": 280.42,
  "speechEnd": 281.42,
  "text": "An exam answer.",
  "end": 281.92
 },
 {
  "i": 94,
  "start": 281.92,
  "speechStart": 282.04,
  "speechEnd": 285.24,
  "text": "A card at a casino table. You walk past the casino.",
  "end": 285.92
 },
 {
  "i": 95,
  "start": 285.92,
  "speechStart": 286.04,
  "speechEnd": 287.14,
  "text": "Rule six:",
  "end": 287.02
 },
 {
  "i": 96,
  "start": 287.02,
  "speechStart": 287.14,
  "speechEnd": 290.64,
  "text": "if it isn't yours in normal time, it isn't yours in frozen time.",
  "end": 291.54
 },
 {
  "i": 97,
  "start": 291.54,
  "speechStart": 291.66,
  "speechEnd": 294.72,
  "text": "On day twenty-five, two people in grey suits find you.",
  "end": 294.96
 },
 {
  "i": 98,
  "start": 294.96,
  "speechStart": 295.08,
  "speechEnd": 295.54,
  "text": "Very polite.",
  "end": 296.2
 },
 {
  "i": 99,
  "start": 296.2,
  "speechStart": 296.32,
  "speechEnd": 298.0,
  "text": "They have a room full of stopwatches",
  "end": 297.88
 },
 {
  "i": 100,
  "start": 297.88,
  "speechStart": 298.0,
  "speechEnd": 301.06,
  "text": "and a laser beam you're supposed to cross without breaking.",
  "end": 301.68
 },
 {
  "i": 101,
  "start": 301.68,
  "speechStart": 301.8,
  "speechEnd": 303.88,
  "text": "You stop time, step through the beam,",
  "end": 304.06
 },
 {
  "i": 102,
  "start": 304.06,
  "speechStart": 304.18,
  "speechEnd": 305.46,
  "text": "and stand on the other side.",
  "end": 305.9
 },
 {
  "i": 103,
  "start": 305.9,
  "speechStart": 306.02,
  "speechEnd": 307.62,
  "text": "To them, you just appear.",
  "end": 307.5
 },
 {
  "i": 104,
  "start": 307.5,
  "speechStart": 307.62,
  "speechEnd": 310.58,
  "text": "They do it again and again, all afternoon.",
  "end": 311.3
 },
 {
  "i": 105,
  "start": 311.3,
  "speechStart": 311.42,
  "speechEnd": 313.2,
  "text": "And something happens that you didn't expect:",
  "end": 313.56
 },
 {
  "i": 106,
  "start": 313.56,
  "speechStart": 313.68,
  "speechEnd": 316.72,
  "text": "the more you practise, the longer it gets.",
  "end": 317.44
 },
 {
  "i": 107,
  "start": 317.44,
  "speechStart": 317.56,
  "speechEnd": 321.64,
  "text": "Five seconds. Six. Seven. In the story,",
  "end": 322.08
 },
 {
  "i": 108,
  "start": 322.08,
  "speechStart": 322.2,
  "speechEnd": 324.78,
  "text": "Dio pushes his time stop to about nine seconds,",
  "end": 325.1
 },
 {
  "i": 109,
  "start": 325.1,
  "speechStart": 325.22,
  "speechEnd": 326.32,
  "text": "according to the Wikipedia summary.",
  "end": 327.06
 },
 {
  "i": 110,
  "start": 327.06,
  "speechStart": 327.18,
  "speechEnd": 329.02,
  "text": "On day thirty-nine, in a white room,",
  "end": 329.22
 },
 {
  "i": 111,
  "start": 329.22,
  "speechStart": 329.34,
  "speechEnd": 331.94,
  "text": "with a woman holding a clipboard, you reach nine.",
  "end": 332.46
 },
 {
  "i": 112,
  "start": 332.46,
  "speechStart": 332.58,
  "speechEnd": 335.12,
  "text": "She writes one line in her report: \"Duration:",
  "end": 335.0
 },
 {
  "i": 113,
  "start": 335.0,
  "speechStart": 335.12,
  "speechEnd": 336.34,
  "text": "increasing.\"",
  "end": 337.5
 },
 {
  "i": 114,
  "start": 337.5,
  "speechStart": 337.62,
  "speechEnd": 339.7,
  "text": "On day forty, you're walking home",
  "end": 339.58
 },
 {
  "i": 115,
  "start": 339.58,
  "speechStart": 339.7,
  "speechEnd": 341.62,
  "text": "when an apartment block catches fire.",
  "end": 341.9
 },
 {
  "i": 116,
  "start": 341.9,
  "speechStart": 342.02,
  "speechEnd": 344.16,
  "text": "A family is stuck on a fourth-floor balcony.",
  "end": 344.62
 },
 {
  "i": 117,
  "start": 344.62,
  "speechStart": 344.74,
  "speechEnd": 347.64,
  "text": "The fire escape is gone. You stop time.",
  "end": 348.26
 },
 {
  "i": 118,
  "start": 348.26,
  "speechStart": 348.38,
  "speechEnd": 350.02,
  "text": "The flames look like orange glass.",
  "end": 350.48
 },
 {
  "i": 119,
  "start": 350.48,
  "speechStart": 350.6,
  "speechEnd": 353.64,
  "text": "The smoke is grey cotton you can push aside with your hand.",
  "end": 354.06
 },
 {
  "i": 120,
  "start": 354.06,
  "speechStart": 354.18,
  "speechEnd": 356.26,
  "text": "It's the most beautiful thing you have ever seen,",
  "end": 356.52
 },
 {
  "i": 121,
  "start": 356.52,
  "speechStart": 356.64,
  "speechEnd": 357.94,
  "text": "and you only have nine seconds.",
  "end": 358.46
 },
 {
  "i": 122,
  "start": 358.46,
  "speechStart": 358.58,
  "speechEnd": 360.8,
  "text": "You get up the stairs inside the building in four.",
  "end": 361.2
 },
 {
  "i": 123,
  "start": 361.2,
  "speechStart": 361.32,
  "speechEnd": 365.12,
  "text": "You pick up the youngest child. Two seconds to the window. Three to the ground.",
  "end": 365.76
 },
 {
  "i": 124,
  "start": 365.76,
  "speechStart": 365.88,
  "speechEnd": 366.26,
  "text": "Time starts.",
  "end": 366.14
 },
 {
  "i": 125,
  "start": 366.14,
  "speechStart": 366.26,
  "speechEnd": 369.56,
  "text": "The crowd sees a child appear on the pavement and screams.",
  "end": 369.44
 },
 {
  "i": 126,
  "start": 369.44,
  "speechStart": 369.56,
  "speechEnd": 370.8,
  "text": "You wait.",
  "end": 370.68
 },
 {
  "i": 127,
  "start": 370.68,
  "speechStart": 370.8,
  "speechEnd": 372.14,
  "text": "You catch your breath.",
  "end": 372.02
 },
 {
  "i": 128,
  "start": 372.02,
  "speechStart": 372.14,
  "speechEnd": 373.36,
  "text": "You stop it again.",
  "end": 373.24
 },
 {
  "i": 129,
  "start": 373.24,
  "speechStart": 373.36,
  "speechEnd": 375.22,
  "text": "Nine seconds at a time,",
  "end": 375.1
 },
 {
  "i": 130,
  "start": 375.1,
  "speechStart": 375.22,
  "speechEnd": 377.9,
  "text": "you bring down the whole family, one by one.",
  "end": 377.78
 },
 {
  "i": 131,
  "start": 377.78,
  "speechStart": 377.9,
  "speechEnd": 380.64,
  "text": "To everyone outside, it takes less than a minute.",
  "end": 380.52
 },
 {
  "i": 132,
  "start": 380.52,
  "speechStart": 380.64,
  "speechEnd": 382.94,
  "text": "For you, it takes much longer,",
  "end": 382.82
 },
 {
  "i": 133,
  "start": 382.82,
  "speechStart": 382.94,
  "speechEnd": 386.44,
  "text": "and every one of those seconds is silent, and yours alone.",
  "end": 386.32
 },
 {
  "i": 134,
  "start": 386.32,
  "speechStart": 386.44,
  "speechEnd": 389.66,
  "text": "This is the part nobody warns you about.",
  "end": 389.54
 },
 {
  "i": 135,
  "start": 389.54,
  "speechStart": 389.66,
  "speechEnd": 392.76,
  "text": "Every time you stop the world, you keep living.",
  "end": 393.1
 },
 {
  "i": 136,
  "start": 393.1,
  "speechStart": 393.22,
  "speechEnd": 396.54,
  "text": "Your heart beats, your hair grows, you get a little older.",
  "end": 397.08
 },
 {
  "i": 137,
  "start": 397.08,
  "speechStart": 397.2,
  "speechEnd": 398.4,
  "text": "The rest of the world doesn't.",
  "end": 398.8
 },
 {
  "i": 138,
  "start": 398.8,
  "speechStart": 398.92,
  "speechEnd": 402.08,
  "text": "Over forty days you've lived hours that nobody else lived.",
  "end": 402.54
 },
 {
  "i": 139,
  "start": 402.54,
  "speechStart": 402.66,
  "speechEnd": 403.88,
  "text": "And you spent all of them alone,",
  "end": 404.36
 },
 {
  "i": 140,
  "start": 404.36,
  "speechStart": 404.48,
  "speechEnd": 406.86,
  "text": "in a silent city where nobody could answer you.",
  "end": 407.14
 },
 {
  "i": 141,
  "start": 407.14,
  "speechStart": 407.26,
  "speechEnd": 408.96,
  "text": "The next day you meet a friend for coffee.",
  "end": 409.66
 },
 {
  "i": 142,
  "start": 409.66,
  "speechStart": 409.78,
  "speechEnd": 411.7,
  "text": "Halfway through a story, they start to laugh,",
  "end": 411.94
 },
 {
  "i": 143,
  "start": 411.94,
  "speechStart": 412.06,
  "speechEnd": 414.32,
  "text": "the big kind of laugh where they can't finish the sentence.",
  "end": 414.88
 },
 {
  "i": 144,
  "start": 414.88,
  "speechStart": 415.0,
  "speechEnd": 416.66,
  "text": "And you realise you could freeze this.",
  "end": 417.32
 },
 {
  "i": 145,
  "start": 417.32,
  "speechStart": 417.44,
  "speechEnd": 421.58,
  "text": "You could walk around it and look at it for nine seconds. You don't.",
  "end": 421.96
 },
 {
  "i": 146,
  "start": 421.96,
  "speechStart": 422.08,
  "speechEnd": 422.46,
  "text": "Rule seven:",
  "end": 423.14
 },
 {
  "i": 147,
  "start": 423.14,
  "speechStart": 423.26,
  "speechEnd": 425.36,
  "text": "the moments worth keeping are the ones you share.",
  "end": 425.92
 },
 {
  "i": 148,
  "start": 425.92,
  "speechStart": 426.04,
  "speechEnd": 428.24,
  "text": "You can't share a moment you've stopped. So:",
  "end": 428.68
 },
 {
  "i": 149,
  "start": 428.68,
  "speechStart": 428.8,
  "speechEnd": 432.08,
  "text": "if you woke up tomorrow able to stop time for five seconds,",
  "end": 432.44
 },
 {
  "i": 150,
  "start": 432.44,
  "speechStart": 432.56,
  "speechEnd": 433.9,
  "text": "what's the first thing you'd do with it?",
  "end": 434.42
 },
 {
  "i": 151,
  "start": 434.42,
  "speechStart": 434.54,
  "speechEnd": 437.92,
  "text": "And what's the one moment you'd never stop? Tell us in the comments.",
  "end": 439.52
 }
]