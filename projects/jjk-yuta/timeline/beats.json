[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 2.82,
  "text": "You've woken up with Yuta Okkotsu's Copy,",
  "end": 2.7
 },
 {
  "i": 1,
  "start": 2.7,
  "speechStart": 2.82,
  "speechEnd": 4.2,
  "text": "from Jujutsu Kaisen.",
  "end": 4.08
 },
 {
  "i": 2,
  "start": 4.08,
  "speechStart": 4.2,
  "speechEnd": 5.64,
  "text": "In real life.",
  "end": 6.16
 },
 {
  "i": 3,
  "start": 6.16,
  "speechStart": 6.28,
  "speechEnd": 8.7,
  "text": "It can copy anything you watch someone do.",
  "end": 8.94
 },
 {
  "i": 4,
  "start": 8.94,
  "speechStart": 9.06,
  "speechEnd": 11.82,
  "text": "And the thing standing behind you decides what it costs.",
  "end": 12.52
 },
 {
  "i": 5,
  "start": 12.52,
  "speechStart": 12.64,
  "speechEnd": 13.52,
  "text": "In forty days,",
  "end": 13.82
 },
 {
  "i": 6,
  "start": 13.82,
  "speechStart": 13.94,
  "speechEnd": 15.96,
  "text": "five of the things you've copied will save",
  "end": 15.84
 },
 {
  "i": 7,
  "start": 15.84,
  "speechStart": 15.96,
  "speechEnd": 18.1,
  "text": "fourteen people in a flooded tunnel.",
  "end": 18.54
 },
 {
  "i": 8,
  "start": 18.54,
  "speechStart": 18.66,
  "speechEnd": 21.24,
  "text": "But right now it's eleven forty-seven at night,",
  "end": 21.84
 },
 {
  "i": 9,
  "start": 21.84,
  "speechStart": 21.96,
  "speechEnd": 24.36,
  "text": "there's a ring on your finger you've never seen,",
  "end": 24.24
 },
 {
  "i": 10,
  "start": 24.24,
  "speechStart": 24.36,
  "speechEnd": 27.42,
  "text": "and something huge is breathing behind you.",
  "end": 28.5
 },
 {
  "i": 11,
  "start": 28.5,
  "speechStart": 28.62,
  "speechEnd": 30.88,
  "text": "In the story, the ring was a promise.",
  "end": 31.48
 },
 {
  "i": 12,
  "start": 31.48,
  "speechStart": 31.6,
  "speechEnd": 34.22,
  "text": "Rika Orimoto was Yuta's friend when they were children.",
  "end": 34.74
 },
 {
  "i": 13,
  "start": 34.74,
  "speechStart": 34.86,
  "speechEnd": 38.48,
  "text": "She gave him her mother's ring and promised to marry him. Then she died young.",
  "end": 39.5
 },
 {
  "i": 14,
  "start": 39.5,
  "speechStart": 39.62,
  "speechEnd": 40.72,
  "text": "Yuta couldn't let go.",
  "end": 41.26
 },
 {
  "i": 15,
  "start": 41.26,
  "speechStart": 41.38,
  "speechEnd": 44.2,
  "text": "Her soul stayed, tied to his cursed energy,",
  "end": 44.5
 },
 {
  "i": 16,
  "start": 44.5,
  "speechStart": 44.62,
  "speechEnd": 48.18,
  "text": "and it became a special-grade curse, the Queen of Curses.",
  "end": 48.8
 },
 {
  "i": 17,
  "start": 48.8,
  "speechStart": 48.92,
  "speechEnd": 50.98,
  "text": "Now it's behind you. Pale,",
  "end": 51.58
 },
 {
  "i": 18,
  "start": 51.58,
  "speechStart": 51.7,
  "speechEnd": 54.58,
  "text": "huge, all teeth, and standing very close.",
  "end": 55.44
 },
 {
  "i": 19,
  "start": 55.44,
  "speechStart": 55.56,
  "speechEnd": 59.26,
  "text": "Your mum walks past the door and says goodnight to the wardrobe. It doesn't attack.",
  "end": 59.76
 },
 {
  "i": 20,
  "start": 59.76,
  "speechStart": 59.88,
  "speechEnd": 62.78,
  "text": "It just looks at the ring. Lesson one:",
  "end": 63.16
 },
 {
  "i": 21,
  "start": 63.16,
  "speechStart": 63.28,
  "speechEnd": 64.44,
  "text": "it isn't a weapon.",
  "end": 65.06
 },
 {
  "i": 22,
  "start": 65.06,
  "speechStart": 65.18,
  "speechEnd": 69.48,
  "text": "It's a promise with a very big shadow. In the story,",
  "end": 69.76
 },
 {
  "i": 23,
  "start": 69.76,
  "speechStart": 69.88,
  "speechEnd": 72.62,
  "text": "Copy lets Yuta reproduce other people's techniques.",
  "end": 73.06
 },
 {
  "i": 24,
  "start": 73.06,
  "speechStart": 73.18,
  "speechEnd": 76.44,
  "text": "And nobody is completely sure of the exact conditions.",
  "end": 76.32
 },
 {
  "i": 25,
  "start": 76.32,
  "speechStart": 76.44,
  "speechEnd": 78.02,
  "text": "So, at breakfast,",
  "end": 78.2
 },
 {
  "i": 26,
  "start": 78.2,
  "speechStart": 78.32,
  "speechEnd": 80.28,
  "text": "you watch your dad flip an omelette.",
  "end": 80.16
 },
 {
  "i": 27,
  "start": 80.16,
  "speechStart": 80.28,
  "speechEnd": 83.76,
  "text": "You've never flipped one in your life. Your hands do it.",
  "end": 84.64
 },
 {
  "i": 28,
  "start": 84.64,
  "speechStart": 84.76,
  "speechEnd": 85.24,
  "text": "Perfectly.",
  "end": 85.5
 },
 {
  "i": 29,
  "start": 85.5,
  "speechStart": 85.62,
  "speechEnd": 88.24,
  "text": "The little tilt of the wrist, the fold at the end,",
  "end": 88.66
 },
 {
  "i": 30,
  "start": 88.66,
  "speechStart": 88.78,
  "speechEnd": 91.38,
  "text": "even the way he blows a strand of hair out of his eyes.",
  "end": 92.2
 },
 {
  "i": 31,
  "start": 92.2,
  "speechStart": 92.32,
  "speechEnd": 95.58,
  "text": "You try the second one on your own, and it's a disaster.",
  "end": 96.22
 },
 {
  "i": 32,
  "start": 96.22,
  "speechStart": 96.34,
  "speechEnd": 100.32,
  "text": "Lesson two: you copy what you see, not what you understand.",
  "end": 101.18
 },
 {
  "i": 33,
  "start": 101.18,
  "speechStart": 101.3,
  "speechEnd": 104.42,
  "text": "At lunch you stop in front of a busker with a guitar.",
  "end": 105.06
 },
 {
  "i": 34,
  "start": 105.06,
  "speechStart": 105.18,
  "speechEnd": 107.12,
  "text": "You watch his hands for one song.",
  "end": 107.98
 },
 {
  "i": 35,
  "start": 107.98,
  "speechStart": 108.1,
  "speechEnd": 111.34,
  "text": "Then you borrow the guitar and play his whole piece,",
  "end": 111.22
 },
 {
  "i": 36,
  "start": 111.22,
  "speechStart": 111.34,
  "speechEnd": 114.0,
  "text": "note for note, the little slides and all.",
  "end": 115.04
 },
 {
  "i": 37,
  "start": 115.04,
  "speechStart": 115.16,
  "speechEnd": 117.78,
  "text": "A small crowd stops. Somebody films it.",
  "end": 118.14
 },
 {
  "i": 38,
  "start": 118.14,
  "speechStart": 118.26,
  "speechEnd": 120.46,
  "text": "He stares at you like you've stolen something,",
  "end": 120.74
 },
 {
  "i": 39,
  "start": 120.74,
  "speechStart": 120.86,
  "speechEnd": 122.9,
  "text": "and he isn't entirely wrong.",
  "end": 123.92
 },
 {
  "i": 40,
  "start": 123.92,
  "speechStart": 124.04,
  "speechEnd": 125.32,
  "text": "Then your fingers start to shake.",
  "end": 125.92
 },
 {
  "i": 41,
  "start": 125.92,
  "speechStart": 126.04,
  "speechEnd": 129.82,
  "text": "They can do it, but they've never done it before, and the body notices.",
  "end": 129.7
 },
 {
  "i": 42,
  "start": 129.7,
  "speechStart": 129.82,
  "speechEnd": 132.22,
  "text": "Lesson three:",
  "end": 132.1
 },
 {
  "i": 43,
  "start": 132.1,
  "speechStart": 132.22,
  "speechEnd": 135.58,
  "text": "copying a skill isn't the same as being built for it.",
  "end": 136.58
 },
 {
  "i": 44,
  "start": 136.58,
  "speechStart": 136.7,
  "speechEnd": 139.04,
  "text": "In the evening you watch a climber on a wall,",
  "end": 139.12
 },
 {
  "i": 45,
  "start": 139.12,
  "speechStart": 139.24,
  "speechEnd": 140.82,
  "text": "then copy every move.",
  "end": 141.32
 },
 {
  "i": 46,
  "start": 141.32,
  "speechStart": 141.44,
  "speechEnd": 143.84,
  "text": "Halfway up, you realise you copied his reach",
  "end": 143.96
 },
 {
  "i": 47,
  "start": 143.96,
  "speechStart": 144.08,
  "speechEnd": 146.84,
  "text": "but not his arms. You slip.",
  "end": 147.62
 },
 {
  "i": 48,
  "start": 147.62,
  "speechStart": 147.74,
  "speechEnd": 150.3,
  "text": "Something huge and pale grabs you by the hood,",
  "end": 150.18
 },
 {
  "i": 49,
  "start": 150.18,
  "speechStart": 150.3,
  "speechEnd": 153.12,
  "text": "in mid-air, and sets you down very gently.",
  "end": 153.74
 },
 {
  "i": 50,
  "start": 153.74,
  "speechStart": 153.86,
  "speechEnd": 154.82,
  "text": "It looks at you.",
  "end": 155.32
 },
 {
  "i": 51,
  "start": 155.32,
  "speechStart": 155.44,
  "speechEnd": 159.78,
  "text": "It doesn't",
  "end": 159.66
 },
 {
  "i": 52,
  "start": 159.66,
  "speechStart": 159.78,
  "speechEnd": 163.58,
  "text": "look pleased. You never find out if that was a rescue or a warning. Lesson four: she's not your servant.",
  "end": 164.46
 },
 {
  "i": 53,
  "start": 164.46,
  "speechStart": 164.58,
  "speechEnd": 166.26,
  "text": "Sometimes she catches you anyway.",
  "end": 167.56
 },
 {
  "i": 54,
  "start": 167.56,
  "speechStart": 167.68,
  "speechEnd": 170.78,
  "text": "On day three, you have to give a presentation at work.",
  "end": 171.3
 },
 {
  "i": 55,
  "start": 171.3,
  "speechStart": 171.42,
  "speechEnd": 173.86,
  "text": "In the film, Yuta uses Cursed Speech,",
  "end": 174.04
 },
 {
  "i": 56,
  "start": 174.04,
  "speechStart": 174.16,
  "speechEnd": 176.6,
  "text": "the technique that belongs to Toge Inumaki's family.",
  "end": 177.1
 },
 {
  "i": 57,
  "start": 177.1,
  "speechStart": 177.22,
  "speechEnd": 180.94,
  "text": "It's normally passed down only inside that clan. You don't have that.",
  "end": 181.34
 },
 {
  "i": 58,
  "start": 181.34,
  "speechStart": 181.46,
  "speechEnd": 183.9,
  "text": "But you've copied your old teacher's voice, the one",
  "end": 183.78
 },
 {
  "i": 59,
  "start": 183.78,
  "speechStart": 183.9,
  "speechEnd": 189.783,
  "text": "that made",
  "end": 189.663
 },
 {
  "i": 60,
  "start": 189.663,
  "speechStart": 189.783,
  "speechEnd": 190.78,
  "text": "a whole classroom go quiet. You open your mouth, and the room stops. It's a little too good.",
  "end": 191.38
 },
 {
  "i": 61,
  "start": 191.38,
  "speechStart": 191.5,
  "speechEnd": 194.68,
  "text": "A colleague goes pale and asks you not to do that again.",
  "end": 195.28
 },
 {
  "i": 62,
  "start": 195.28,
  "speechStart": 195.4,
  "speechEnd": 196.54,
  "text": "Lesson five:",
  "end": 196.42
 },
 {
  "i": 63,
  "start": 196.42,
  "speechStart": 196.54,
  "speechEnd": 200.02,
  "text": "when you copy a voice, you copy what it does to other people.",
  "end": 200.72
 },
 {
  "i": 64,
  "start": 200.72,
  "speechStart": 200.84,
  "speechEnd": 203.82,
  "text": "On day six, your friend says something odd.",
  "end": 204.28
 },
 {
  "i": 65,
  "start": 204.28,
  "speechStart": 204.4,
  "speechEnd": 207.84,
  "text": "You've started talking like the man who shouted at you on the bus.",
  "end": 208.78
 },
 {
  "i": 66,
  "start": 208.78,
  "speechStart": 208.9,
  "speechEnd": 209.96,
  "text": "You didn't decide it.",
  "end": 210.04
 },
 {
  "i": 67,
  "start": 210.04,
  "speechStart": 210.16,
  "speechEnd": 211.8,
  "text": "You just watched him, and it stuck.",
  "end": 212.42
 },
 {
  "i": 68,
  "start": 212.42,
  "speechStart": 212.54,
  "speechEnd": 214.02,
  "text": "In nineteen sixty-one,",
  "end": 213.9
 },
 {
  "i": 69,
  "start": 213.9,
  "speechStart": 214.02,
  "speechEnd": 216.52,
  "text": "the psychologist Albert Bandura showed that children",
  "end": 216.4
 },
 {
  "i": 70,
  "start": 216.4,
  "speechStart": 216.52,
  "speechEnd": 218.6,
  "text": "who watched an adult hit an inflatable",
  "end": 218.48
 },
 {
  "i": 71,
  "start": 218.48,
  "speechStart": 218.6,
  "speechEnd": 222.22,
  "text": "doll later did the same, without being told to.",
  "end": 223.0
 },
 {
  "i": 72,
  "start": 223.0,
  "speechStart": 223.12,
  "speechEnd": 224.92,
  "text": "We copy more than we think.",
  "end": 225.46
 },
 {
  "i": 73,
  "start": 225.46,
  "speechStart": 225.58,
  "speechEnd": 227.84,
  "text": "You count how many strangers you've copied this week.",
  "end": 228.32
 },
 {
  "i": 74,
  "start": 228.32,
  "speechStart": 228.44,
  "speechEnd": 230.02,
  "text": "You stop at twenty.",
  "end": 229.9
 },
 {
  "i": 75,
  "start": 229.9,
  "speechStart": 230.02,
  "speechEnd": 231.3,
  "text": "Lesson six:",
  "end": 231.18
 },
 {
  "i": 76,
  "start": 231.18,
  "speechStart": 231.3,
  "speechEnd": 232.9,
  "text": "you don't choose everything you copy.",
  "end": 234.28
 },
 {
  "i": 77,
  "start": 234.28,
  "speechStart": 234.4,
  "speechEnd": 235.9,
  "text": "A boy films you in the park:",
  "end": 236.34
 },
 {
  "i": 78,
  "start": 236.34,
  "speechStart": 236.46,
  "speechEnd": 238.76,
  "text": "first juggling, then a handstand,",
  "end": 239.06
 },
 {
  "i": 79,
  "start": 239.06,
  "speechStart": 239.18,
  "speechEnd": 242.12,
  "text": "then a perfect cartwheel. He posts it.",
  "end": 242.44
 },
 {
  "i": 80,
  "start": 242.44,
  "speechStart": 242.56,
  "speechEnd": 243.74,
  "text": "People say it's editing.",
  "end": 244.14
 },
 {
  "i": 81,
  "start": 244.14,
  "speechStart": 244.26,
  "speechEnd": 245.94,
  "text": "People say you're hiding something.",
  "end": 245.82
 },
 {
  "i": 82,
  "start": 245.82,
  "speechStart": 245.94,
  "speechEnd": 249.22,
  "text": "Nobody says \"Rika\", because nobody knows",
  "end": 249.1
 },
 {
  "i": 83,
  "start": 249.1,
  "speechStart": 249.22,
  "speechEnd": 252.56,
  "text": "who that is, and the few who do think it's a joke.",
  "end": 253.28
 },
 {
  "i": 84,
  "start": 253.28,
  "speechStart": 253.4,
  "speechEnd": 253.82,
  "text": "Lesson seven:",
  "end": 253.7
 },
 {
  "i": 85,
  "start": 253.7,
  "speechStart": 253.82,
  "speechEnd": 255.56,
  "text": "the ones who'd understand",
  "end": 255.44
 },
 {
  "i": 86,
  "start": 255.44,
  "speechStart": 255.56,
  "speechEnd": 258.06,
  "text": "are the ones who'd never believe it.",
  "end": 258.96
 },
 {
  "i": 87,
  "start": 258.96,
  "speechStart": 259.08,
  "speechEnd": 262.28,
  "text": "On day twelve you watch a dancer rehearse in a studio,",
  "end": 262.16
 },
 {
  "i": 88,
  "start": 262.16,
  "speechStart": 262.28,
  "speechEnd": 264.32,
  "text": "through the window, for twenty minutes.",
  "end": 264.2
 },
 {
  "i": 89,
  "start": 264.2,
  "speechStart": 264.32,
  "speechEnd": 267.18,
  "text": "Then you walk in and do the whole routine,",
  "end": 267.06
 },
 {
  "i": 90,
  "start": 267.06,
  "speechStart": 267.18,
  "speechEnd": 269.1,
  "text": "every turn, every pause,",
  "end": 268.98
 },
 {
  "i": 91,
  "start": 268.98,
  "speechStart": 269.1,
  "speechEnd": 271.02,
  "text": "as if you'd practised it for years.",
  "end": 271.28
 },
 {
  "i": 92,
  "start": 271.28,
  "speechStart": 271.4,
  "speechEnd": 273.02,
  "text": "Her teacher claps.",
  "end": 272.9
 },
 {
  "i": 93,
  "start": 272.9,
  "speechStart": 273.02,
  "speechEnd": 275.14,
  "text": "She wants you in the show on Friday.",
  "end": 276.06
 },
 {
  "i": 94,
  "start": 276.06,
  "speechStart": 276.18,
  "speechEnd": 279.28,
  "text": "On Friday, the lights come on, and you freeze.",
  "end": 280.18
 },
 {
  "i": 95,
  "start": 280.18,
  "speechStart": 280.3,
  "speechEnd": 281.62,
  "text": "Your feet know every step.",
  "end": 282.48
 },
 {
  "i": 96,
  "start": 282.48,
  "speechStart": 282.6,
  "speechEnd": 283.86,
  "text": "Your stomach doesn't.",
  "end": 284.58
 },
 {
  "i": 97,
  "start": 284.58,
  "speechStart": 284.7,
  "speechEnd": 287.14,
  "text": "Someone huge and pale stands in the wings,",
  "end": 287.02
 },
 {
  "i": 98,
  "start": 287.02,
  "speechStart": 287.14,
  "speechEnd": 290.04,
  "text": "and you could swear she's covering her face.",
  "end": 290.66
 },
 {
  "i": 99,
  "start": 290.66,
  "speechStart": 290.78,
  "speechEnd": 293.32,
  "text": "Lesson eight: you can copy the steps,",
  "end": 293.76
 },
 {
  "i": 100,
  "start": 293.76,
  "speechStart": 293.88,
  "speechEnd": 297.94,
  "text": "but not the nerves that go with them. On day fifteen,",
  "end": 297.82
 },
 {
  "i": 101,
  "start": 297.82,
  "speechStart": 297.94,
  "speechEnd": 300.48,
  "text": "an old chess player lets you sit down across from him.",
  "end": 300.82
 },
 {
  "i": 102,
  "start": 300.82,
  "speechStart": 300.94,
  "speechEnd": 304.56,
  "text": "You copy his opening, move for move. It's beautiful.",
  "end": 305.38
 },
 {
  "i": 103,
  "start": 305.38,
  "speechStart": 305.5,
  "speechEnd": 309.1,
  "text": "Then he makes a move you've never seen, and you don't know why.",
  "end": 309.68
 },
 {
  "i": 104,
  "start": 309.68,
  "speechStart": 309.8,
  "speechEnd": 312.18,
  "text": "You lose in eleven turns. He smiles.",
  "end": 313.04
 },
 {
  "i": 105,
  "start": 313.04,
  "speechStart": 313.16,
  "speechEnd": 314.68,
  "text": "\"You have my hands,\" he says.",
  "end": 315.22
 },
 {
  "i": 106,
  "start": 315.22,
  "speechStart": 315.34,
  "speechEnd": 316.62,
  "text": "\"You don't have my reasons.\"",
  "end": 317.64
 },
 {
  "i": 107,
  "start": 317.64,
  "speechStart": 317.76,
  "speechEnd": 320.0,
  "text": "Lesson nine: Copy shows you the move.",
  "end": 320.32
 },
 {
  "i": 108,
  "start": 320.32,
  "speechStart": 320.44,
  "speechEnd": 322.06,
  "text": "It never shows you the why.",
  "end": 323.28
 },
 {
  "i": 109,
  "start": 323.28,
  "speechStart": 323.4,
  "speechEnd": 325.62,
  "text": "On day seventeen you notice something.",
  "end": 326.08
 },
 {
  "i": 110,
  "start": 326.08,
  "speechStart": 326.2,
  "speechEnd": 328.66,
  "text": "Every skill you copy stays in your hands,",
  "end": 328.54
 },
 {
  "i": 111,
  "start": 328.54,
  "speechStart": 328.66,
  "speechEnd": 330.08,
  "text": "but not all at once.",
  "end": 330.58
 },
 {
  "i": 112,
  "start": 330.58,
  "speechStart": 330.7,
  "speechEnd": 332.42,
  "text": "You can hold five of them at a time.",
  "end": 332.66
 },
 {
  "i": 113,
  "start": 332.66,
  "speechStart": 332.78,
  "speechEnd": 336.1,
  "text": "The sixth pushes the oldest one out, like a drawer that's too full.",
  "end": 336.68
 },
 {
  "i": 114,
  "start": 336.68,
  "speechStart": 336.8,
  "speechEnd": 338.44,
  "text": "You write the five on a sheet of paper,",
  "end": 338.32
 },
 {
  "i": 115,
  "start": 338.32,
  "speechStart": 338.44,
  "speechEnd": 340.94,
  "text": "and stick it on the wardrobe, because you keep forgetting.",
  "end": 341.44
 },
 {
  "i": 116,
  "start": 341.44,
  "speechStart": 341.56,
  "speechEnd": 343.56,
  "text": "It looks like a very strange shopping list.",
  "end": 344.14
 },
 {
  "i": 117,
  "start": 344.14,
  "speechStart": 344.26,
  "speechEnd": 346.78,
  "text": "Your mum asks what \"locksmith, swimmer,",
  "end": 346.98
 },
 {
  "i": 118,
  "start": 346.98,
  "speechStart": 347.1,
  "speechEnd": 350.92,
  "text": "climber, driver, strongman\" is for. You say:",
  "end": 351.2
 },
 {
  "i": 119,
  "start": 351.2,
  "speechStart": 351.32,
  "speechEnd": 352.12,
  "text": "\"Just in case.\"",
  "end": 352.84
 },
 {
  "i": 120,
  "start": 352.84,
  "speechStart": 352.96,
  "speechEnd": 354.36,
  "text": "Lesson ten:",
  "end": 354.24
 },
 {
  "i": 121,
  "start": 354.24,
  "speechStart": 354.36,
  "speechEnd": 357.28,
  "text": "choose carefully what you keep. You can't keep everything.",
  "end": 358.54
 },
 {
  "i": 122,
  "start": 358.54,
  "speechStart": 358.66,
  "speechEnd": 362.04,
  "text": "On day twenty you take the ring off, to see what happens.",
  "end": 362.76
 },
 {
  "i": 123,
  "start": 362.76,
  "speechStart": 362.88,
  "speechEnd": 363.6,
  "text": "In the story,",
  "end": 363.92
 },
 {
  "i": 124,
  "start": 363.92,
  "speechStart": 364.04,
  "speechEnd": 366.46,
  "text": "Yuta calls Rika out using that ring.",
  "end": 366.34
 },
 {
  "i": 125,
  "start": 366.34,
  "speechStart": 366.46,
  "speechEnd": 369.42,
  "text": "And her cursed energy is vast.",
  "end": 370.22
 },
 {
  "i": 126,
  "start": 370.22,
  "speechStart": 370.34,
  "speechEnd": 371.3,
  "text": "The lights go out.",
  "end": 371.68
 },
 {
  "i": 127,
  "start": 371.68,
  "speechStart": 371.8,
  "speechEnd": 373.74,
  "text": "The room gets very cold.",
  "end": 374.88
 },
 {
  "i": 128,
  "start": 374.88,
  "speechStart": 375.0,
  "speechEnd": 377.84,
  "text": "Something huge unfolds behind you,",
  "end": 378.0
 },
 {
  "i": 129,
  "start": 378.0,
  "speechStart": 378.12,
  "speechEnd": 381.06,
  "text": "taller than the ceiling, and the walls start to hum.",
  "end": 381.72
 },
 {
  "i": 130,
  "start": 381.72,
  "speechStart": 381.84,
  "speechEnd": 383.1,
  "text": "You put the ring back on.",
  "end": 383.42
 },
 {
  "i": 131,
  "start": 383.42,
  "speechStart": 383.54,
  "speechEnd": 385.46,
  "text": "It all folds away, slowly.",
  "end": 385.98
 },
 {
  "i": 132,
  "start": 385.98,
  "speechStart": 386.1,
  "speechEnd": 388.8,
  "text": "She never moved from where she was.",
  "end": 389.04
 },
 {
  "i": 133,
  "start": 389.04,
  "speechStart": 389.16,
  "speechEnd": 390.58,
  "text": "Lesson eleven:",
  "end": 390.46
 },
 {
  "i": 134,
  "start": 390.46,
  "speechStart": 390.58,
  "speechEnd": 393.44,
  "text": "the ring isn't a leash. It's a door,",
  "end": 394.02
 },
 {
  "i": 135,
  "start": 394.02,
  "speechStart": 394.14,
  "speechEnd": 396.62,
  "text": "and you're the only one who can close it.",
  "end": 397.4
 },
 {
  "i": 136,
  "start": 397.4,
  "speechStart": 397.52,
  "speechEnd": 398.94,
  "text": "On day twenty-five,",
  "end": 398.82
 },
 {
  "i": 137,
  "start": 398.82,
  "speechStart": 398.94,
  "speechEnd": 401.62,
  "text": "a man collapses on a pavement in front of you.",
  "end": 401.8
 },
 {
  "i": 138,
  "start": 401.8,
  "speechStart": 401.92,
  "speechEnd": 403.02,
  "text": "People step back.",
  "end": 403.26
 },
 {
  "i": 139,
  "start": 403.26,
  "speechStart": 403.38,
  "speechEnd": 405.2,
  "text": "Someone is already shouting for an ambulance.",
  "end": 405.96
 },
 {
  "i": 140,
  "start": 405.96,
  "speechStart": 406.08,
  "speechEnd": 407.52,
  "text": "Months ago, on a training video,",
  "end": 407.74
 },
 {
  "i": 141,
  "start": 407.74,
  "speechStart": 407.86,
  "speechEnd": 411.54,
  "text": "you watched a paramedic do chest compressions. You've never done one.",
  "end": 411.42
 },
 {
  "i": 142,
  "start": 411.42,
  "speechStart": 411.54,
  "speechEnd": 412.86,
  "text": "You kneel down.",
  "end": 413.28
 },
 {
  "i": 143,
  "start": 413.28,
  "speechStart": 413.4,
  "speechEnd": 415.42,
  "text": "Your hands do it. Steady,",
  "end": 416.14
 },
 {
  "i": 144,
  "start": 416.14,
  "speechStart": 416.26,
  "speechEnd": 419.7,
  "text": "strong, in rhythm, and you keep going while your arms burn.",
  "end": 420.46
 },
 {
  "i": 145,
  "start": 420.46,
  "speechStart": 420.58,
  "speechEnd": 421.82,
  "text": "You don't know why it works.",
  "end": 422.3
 },
 {
  "i": 146,
  "start": 422.3,
  "speechStart": 422.42,
  "speechEnd": 425.44,
  "text": "You only know it works until the real paramedics arrive.",
  "end": 425.98
 },
 {
  "i": 147,
  "start": 425.98,
  "speechStart": 426.1,
  "speechEnd": 429.2,
  "text": "They take over, look at you, and ask where you trained.",
  "end": 430.22
 },
 {
  "i": 148,
  "start": 430.22,
  "speechStart": 430.34,
  "speechEnd": 431.3,
  "text": "Lesson twelve:",
  "end": 431.18
 },
 {
  "i": 149,
  "start": 431.18,
  "speechStart": 431.3,
  "speechEnd": 433.34,
  "text": "sometimes you don't need to understand the move.",
  "end": 433.74
 },
 {
  "i": 150,
  "start": 433.74,
  "speechStart": 433.86,
  "speechEnd": 435.58,
  "text": "You only need to buy someone time.",
  "end": 436.5
 },
 {
  "i": 151,
  "start": 436.5,
  "speechStart": 436.62,
  "speechEnd": 440.08,
  "text": "By day thirty you have a hundred skills in your hands,",
  "end": 439.96
 },
 {
  "i": 152,
  "start": 439.96,
  "speechStart": 440.08,
  "speechEnd": 441.64,
  "text": "and not one you can explain.",
  "end": 442.24
 },
 {
  "i": 153,
  "start": 442.24,
  "speechStart": 442.36,
  "speechEnd": 444.6,
  "text": "You're tired in a way sleep doesn't fix.",
  "end": 445.3
 },
 {
  "i": 154,
  "start": 445.3,
  "speechStart": 445.42,
  "speechEnd": 446.92,
  "text": "You can do anything you've watched,",
  "end": 446.8
 },
 {
  "i": 155,
  "start": 446.8,
  "speechStart": 446.92,
  "speechEnd": 449.74,
  "text": "and you've forgotten how to do the things you used to love.",
  "end": 450.36
 },
 {
  "i": 156,
  "start": 450.36,
  "speechStart": 450.48,
  "speechEnd": 451.48,
  "text": "You find your old guitar.",
  "end": 451.86
 },
 {
  "i": 157,
  "start": 451.86,
  "speechStart": 451.98,
  "speechEnd": 453.9,
  "text": "You can't play it any more.",
  "end": 453.78
 },
 {
  "i": 158,
  "start": 453.78,
  "speechStart": 453.9,
  "speechEnd": 455.14,
  "text": "Only the busker's song.",
  "end": 455.78
 },
 {
  "i": 159,
  "start": 455.78,
  "speechStart": 455.9,
  "speechEnd": 457.3,
  "text": "Lesson thirteen:",
  "end": 457.18
 },
 {
  "i": 160,
  "start": 457.18,
  "speechStart": 457.3,
  "speechEnd": 460.58,
  "text": "you can borrow a lot, but you can't borrow a self.",
  "end": 461.44
 },
 {
  "i": 161,
  "start": 461.44,
  "speechStart": 461.56,
  "speechEnd": 463.98,
  "text": "On day forty, the rain is",
  "end": 463.86
 },
 {
  "i": 162,
  "start": 463.86,
  "speechStart": 463.98,
  "speechEnd": 466.02,
  "text": "so heavy that an underpass",
  "end": 465.9
 },
 {
  "i": 163,
  "start": 465.9,
  "speechStart": 466.02,
  "speechEnd": 467.68,
  "text": "floods around a stopped bus,",
  "end": 467.56
 },
 {
  "i": 164,
  "start": 467.56,
  "speechStart": 467.68,
  "speechEnd": 469.58,
  "text": "with fourteen people inside.",
  "end": 470.5
 },
 {
  "i": 165,
  "start": 470.5,
  "speechStart": 470.62,
  "speechEnd": 471.9,
  "text": "You're the only one who can do anything.",
  "end": 472.52
 },
 {
  "i": 166,
  "start": 472.52,
  "speechStart": 472.64,
  "speechEnd": 474.68,
  "text": "You have a hundred skills in your hands,",
  "end": 475.12
 },
 {
  "i": 167,
  "start": 475.12,
  "speechStart": 475.24,
  "speechEnd": 476.46,
  "text": "but only five fit.",
  "end": 476.94
 },
 {
  "i": 168,
  "start": 476.94,
  "speechStart": 477.06,
  "speechEnd": 481.18,
  "text": "You swap them in your head, the way you'd swap cards: the old chess player goes,",
  "end": 481.4
 },
 {
  "i": 169,
  "start": 481.4,
  "speechStart": 481.52,
  "speechEnd": 490.356,
  "text": "the dancer goes, the busker goes. The swimmer's stroke, to get across.",
  "end": 490.236
 },
 {
  "i": 170,
  "start": 490.236,
  "speechStart": 490.356,
  "speechEnd": 490.546,
  "text": "The climber's grip, to reach the roof.",
  "end": 490.426
 },
 {
  "i": 171,
  "start": 490.426,
  "speechStart": 490.546,
  "speechEnd": 492.2,
  "text": "The driver's calm, to open the door.",
  "end": 493.0
 },
 {
  "i": 172,
  "start": 493.0,
  "speechStart": 493.12,
  "speechEnd": 495.12,
  "text": "The locksmith's fingers, for the jammed window.",
  "end": 495.64
 },
 {
  "i": 173,
  "start": 495.64,
  "speechStart": 495.76,
  "speechEnd": 497.84,
  "text": "The strongman's back, to hold it.",
  "end": 498.4
 },
 {
  "i": 174,
  "start": 498.4,
  "speechStart": 498.52,
  "speechEnd": 500.48,
  "text": "You put the ring on your finger and say nothing.",
  "end": 500.8
 },
 {
  "i": 175,
  "start": 500.8,
  "speechStart": 500.92,
  "speechEnd": 502.64,
  "text": "There isn't time to say anything.",
  "end": 503.08
 },
 {
  "i": 176,
  "start": 503.08,
  "speechStart": 503.2,
  "speechEnd": 505.92,
  "text": "Something huge and pale rises behind you,",
  "end": 506.44
 },
 {
  "i": 177,
  "start": 506.44,
  "speechStart": 506.56,
  "speechEnd": 508.0,
  "text": "and the water goes very still.",
  "end": 508.44
 },
 {
  "i": 178,
  "start": 508.44,
  "speechStart": 508.56,
  "speechEnd": 512.46,
  "text": "For the first time, it doesn't look at the ring. It looks at the bus.",
  "end": 512.98
 },
 {
  "i": 179,
  "start": 512.98,
  "speechStart": 513.1,
  "speechEnd": 514.9,
  "text": "You get them out one by one.",
  "end": 514.78
 },
 {
  "i": 180,
  "start": 514.78,
  "speechStart": 514.9,
  "speechEnd": 517.26,
  "text": "Fourteen people on a wet pavement,",
  "end": 517.14
 },
 {
  "i": 181,
  "start": 517.14,
  "speechStart": 517.26,
  "speechEnd": 520.3,
  "text": "shaking, wrapped in whatever coats were nearby.",
  "end": 521.52
 },
 {
  "i": 182,
  "start": 521.52,
  "speechStart": 521.64,
  "speechEnd": 522.82,
  "text": "Nobody asks what you are.",
  "end": 523.88
 },
 {
  "i": 183,
  "start": 523.88,
  "speechStart": 524.0,
  "speechEnd": 526.24,
  "text": "The next morning you can't lift your arms,",
  "end": 526.44
 },
 {
  "i": 184,
  "start": 526.44,
  "speechStart": 526.56,
  "speechEnd": 528.3,
  "text": "and she's sitting at the foot of your bed.",
  "end": 528.78
 },
 {
  "i": 185,
  "start": 528.78,
  "speechStart": 528.9,
  "speechEnd": 530.46,
  "text": "In the story, after the film,",
  "end": 531.0
 },
 {
  "i": 186,
  "start": 531.0,
  "speechStart": 531.12,
  "speechEnd": 534.22,
  "text": "Rika's soul moves on, and Yuta keeps using her power.",
  "end": 534.94
 },
 {
  "i": 187,
  "start": 534.94,
  "speechStart": 535.06,
  "speechEnd": 537.66,
  "text": "Yours doesn't move on. She stays.",
  "end": 538.48
 },
 {
  "i": 188,
  "start": 538.48,
  "speechStart": 538.6,
  "speechEnd": 541.24,
  "text": "You say thank you, out loud, to a wardrobe,",
  "end": 541.56
 },
 {
  "i": 189,
  "start": 541.56,
  "speechStart": 541.68,
  "speechEnd": 543.86,
  "text": "and for a moment the ring feels warm.",
  "end": 543.74
 },
 {
  "i": 190,
  "start": 543.74,
  "speechStart": 543.86,
  "speechEnd": 545.32,
  "text": "Lesson fourteen:",
  "end": 545.2
 },
 {
  "i": 191,
  "start": 545.2,
  "speechStart": 545.32,
  "speechEnd": 548.52,
  "text": "the strongest thing you copied wasn't a skill.",
  "end": 548.4
 },
 {
  "i": 192,
  "start": 548.4,
  "speechStart": 548.52,
  "speechEnd": 551.32,
  "text": "It was a promise to keep going.",
  "end": 551.2
 },
 {
  "i": 193,
  "start": 551.2,
  "speechStart": 551.32,
  "speechEnd": 554.38,
  "text": "The next night, at eleven forty-seven,",
  "end": 554.26
 },
 {
  "i": 194,
  "start": 554.26,
  "speechStart": 554.38,
  "speechEnd": 556.42,
  "text": "you look at the ring on your finger.",
  "end": 556.3
 },
 {
  "i": 195,
  "start": 556.3,
  "speechStart": 556.42,
  "speechEnd": 558.4,
  "text": "So if you woke",
  "end": 558.28
 },
 {
  "i": 196,
  "start": 558.28,
  "speechStart": 558.4,
  "speechEnd": 560.58,
  "text": "up tomorrow with Yuta's Copy,",
  "end": 560.46
 },
 {
  "i": 197,
  "start": 560.46,
  "speechStart": 560.58,
  "speechEnd": 562.92,
  "text": "what's the first thing you'd copy?",
  "end": 562.8
 },
 {
  "i": 198,
  "start": 562.8,
  "speechStart": 562.92,
  "speechEnd": 565.04,
  "text": "And would you take off the ring,",
  "end": 564.92
 },
 {
  "i": 199,
  "start": 564.92,
  "speechStart": 565.04,
  "speechEnd": 567.48,
  "text": "to see what's behind it? Tell me in the comments.",
  "end": 569.08
 }
]