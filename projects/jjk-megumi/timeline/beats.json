[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 2.54,
  "text": "You've woken up with Megumi's Ten Shadows,",
  "end": 2.42
 },
 {
  "i": 1,
  "start": 2.42,
  "speechStart": 2.54,
  "speechEnd": 5.3,
  "text": "from Jujutsu Kaisen. In real life.",
  "end": 5.84
 },
 {
  "i": 2,
  "start": 5.84,
  "speechStart": 5.96,
  "speechEnd": 9.34,
  "text": "Your shadow is alive. And it's hungry.",
  "end": 9.9
 },
 {
  "i": 3,
  "start": 9.9,
  "speechStart": 10.02,
  "speechEnd": 13.2,
  "text": "One of the things inside it will help you save a car park full of people.",
  "end": 13.84
 },
 {
  "i": 4,
  "start": 13.84,
  "speechStart": 13.96,
  "speechEnd": 17.26,
  "text": "Another has never been tamed by anyone but Sukuna,",
  "end": 17.74
 },
 {
  "i": 5,
  "start": 17.74,
  "speechStart": 17.86,
  "speechEnd": 20.26,
  "text": "and in forty days you'll be tempted to open it.",
  "end": 20.46
 },
 {
  "i": 6,
  "start": 20.46,
  "speechStart": 20.58,
  "speechEnd": 24.62,
  "text": "But right now it's three fifteen in the morning, the moon is on your floor,",
  "end": 25.0
 },
 {
  "i": 7,
  "start": 25.0,
  "speechStart": 25.12,
  "speechEnd": 28.4,
  "text": "and your shadow has just stopped copying you.",
  "end": 29.18
 },
 {
  "i": 8,
  "start": 29.18,
  "speechStart": 29.3,
  "speechEnd": 30.58,
  "text": "You lift your arm.",
  "end": 31.1
 },
 {
  "i": 9,
  "start": 31.1,
  "speechStart": 31.22,
  "speechEnd": 32.94,
  "text": "The shadow on the floor doesn't.",
  "end": 33.42
 },
 {
  "i": 10,
  "start": 33.42,
  "speechStart": 33.54,
  "speechEnd": 36.92,
  "text": "Then two dogs step out of it, one white and one black,",
  "end": 37.32
 },
 {
  "i": 11,
  "start": 37.32,
  "speechStart": 37.44,
  "speechEnd": 39.92,
  "text": "and sit in front of you like they've been waiting all night.",
  "end": 40.44
 },
 {
  "i": 12,
  "start": 40.44,
  "speechStart": 40.56,
  "speechEnd": 42.54,
  "text": "In the story these are the Divine Dogs,",
  "end": 42.88
 },
 {
  "i": 13,
  "start": 42.88,
  "speechStart": 43.0,
  "speechEnd": 46.38,
  "text": "the first shikigami every user of the Ten Shadows Technique receives.",
  "end": 46.98
 },
 {
  "i": 14,
  "start": 46.98,
  "speechStart": 47.1,
  "speechEnd": 47.92,
  "text": "They hunt curses.",
  "end": 48.64
 },
 {
  "i": 15,
  "start": 48.64,
  "speechStart": 48.76,
  "speechEnd": 51.98,
  "text": "Your cat, who respects nothing, leaves the room.",
  "end": 52.48
 },
 {
  "i": 16,
  "start": 52.48,
  "speechStart": 52.6,
  "speechEnd": 55.34,
  "text": "Then they catch a scent and drag you out of the flat,",
  "end": 55.36
 },
 {
  "i": 17,
  "start": 55.36,
  "speechStart": 55.48,
  "speechEnd": 57.56,
  "text": "down the stairs, across the empty city.",
  "end": 57.44
 },
 {
  "i": 18,
  "start": 57.44,
  "speechStart": 57.56,
  "speechEnd": 59.54,
  "text": "A dog can have up to about",
  "end": 59.42
 },
 {
  "i": 19,
  "start": 59.42,
  "speechStart": 59.54,
  "speechEnd": 61.7,
  "text": "three hundred million scent receptors,",
  "end": 61.58
 },
 {
  "i": 20,
  "start": 61.58,
  "speechStart": 61.7,
  "speechEnd": 64.06,
  "text": "against about six million in a human.",
  "end": 64.9
 },
 {
  "i": 21,
  "start": 64.9,
  "speechStart": 65.02,
  "speechEnd": 67.56,
  "text": "That's the best case, but it explains why they're not slowing down.",
  "end": 68.04
 },
 {
  "i": 22,
  "start": 68.04,
  "speechStart": 68.16,
  "speechEnd": 69.22,
  "text": "They stop under a rooftop.",
  "end": 70.02
 },
 {
  "i": 23,
  "start": 70.02,
  "speechStart": 70.14,
  "speechEnd": 73.12,
  "text": "On it, there's your neighbour's lost cat.",
  "end": 73.0
 },
 {
  "i": 24,
  "start": 73.0,
  "speechStart": 73.12,
  "speechEnd": 73.88,
  "text": "It looks at you.",
  "end": 74.3
 },
 {
  "i": 25,
  "start": 74.3,
  "speechStart": 74.42,
  "speechEnd": 77.04,
  "text": "It's not impressed either. Lesson one:",
  "end": 77.54
 },
 {
  "i": 26,
  "start": 77.54,
  "speechStart": 77.66,
  "speechEnd": 80.86,
  "text": "your shadow has a perfect nose, and no idea what's yours.",
  "end": 82.12
 },
 {
  "i": 27,
  "start": 82.12,
  "speechStart": 82.24,
  "speechEnd": 84.32,
  "text": "At breakfast you try to act normal.",
  "end": 84.2
 },
 {
  "i": 28,
  "start": 84.2,
  "speechStart": 84.32,
  "speechEnd": 87.6,
  "text": "Your mum asks why you're sitting so far from the table.",
  "end": 88.14
 },
 {
  "i": 29,
  "start": 88.14,
  "speechStart": 88.26,
  "speechEnd": 89.48,
  "text": "The dogs are under it.",
  "end": 89.74
 },
 {
  "i": 30,
  "start": 89.74,
  "speechStart": 89.86,
  "speechEnd": 91.18,
  "text": "You can feel them breathing.",
  "end": 92.1
 },
 {
  "i": 31,
  "start": 92.1,
  "speechStart": 92.22,
  "speechEnd": 94.92,
  "text": "Every time she moves, they move with her shadow,",
  "end": 95.66
 },
 {
  "i": 32,
  "start": 95.66,
  "speechStart": 95.78,
  "speechEnd": 96.8,
  "text": "and you realise something:",
  "end": 97.38
 },
 {
  "i": 33,
  "start": 97.38,
  "speechStart": 97.5,
  "speechEnd": 100.62,
  "text": "they're not following her. They're guarding you.",
  "end": 101.16
 },
 {
  "i": 34,
  "start": 101.16,
  "speechStart": 101.28,
  "speechEnd": 104.44,
  "text": "You eat a whole bowl of cereal with your feet pulled up on the chair.",
  "end": 105.34
 },
 {
  "i": 35,
  "start": 105.34,
  "speechStart": 105.46,
  "speechEnd": 107.68,
  "text": "Lesson two: they obey you.",
  "end": 107.76
 },
 {
  "i": 36,
  "start": 107.76,
  "speechStart": 107.88,
  "speechEnd": 109.56,
  "text": "But they don't understand \"normal\".",
  "end": 110.62
 },
 {
  "i": 37,
  "start": 110.62,
  "speechStart": 110.74,
  "speechEnd": 114.1,
  "text": "At lunch you try the next one, as quietly as you can.",
  "end": 114.58
 },
 {
  "i": 38,
  "start": 114.58,
  "speechStart": 114.7,
  "speechEnd": 117.04,
  "text": "Something wet slaps out of your shadow",
  "end": 116.92
 },
 {
  "i": 39,
  "start": 116.92,
  "speechStart": 117.04,
  "speechEnd": 118.32,
  "text": "and onto the office floor:",
  "end": 119.08
 },
 {
  "i": 40,
  "start": 119.08,
  "speechStart": 119.2,
  "speechEnd": 120.6,
  "text": "a toad the size of a person.",
  "end": 121.34
 },
 {
  "i": 41,
  "start": 121.34,
  "speechStart": 121.46,
  "speechEnd": 124.54,
  "text": "In the story this is Toad, another shikigami.",
  "end": 125.38
 },
 {
  "i": 42,
  "start": 125.38,
  "speechStart": 125.5,
  "speechEnd": 128.1,
  "text": "And in the story, two of them can even fuse into something new.",
  "end": 128.54
 },
 {
  "i": 43,
  "start": 128.54,
  "speechStart": 128.66,
  "speechEnd": 130.02,
  "text": "You hide it in the kitchen fridge.",
  "end": 130.72
 },
 {
  "i": 44,
  "start": 130.72,
  "speechStart": 130.84,
  "speechEnd": 133.0,
  "text": "It leaves a tongue's worth of mess on the printer.",
  "end": 133.8
 },
 {
  "i": 45,
  "start": 133.8,
  "speechStart": 133.92,
  "speechEnd": 138.02,
  "text": "Your boss asks who's been feeding the printer. Lesson three:",
  "end": 138.66
 },
 {
  "i": 46,
  "start": 138.66,
  "speechStart": 138.78,
  "speechEnd": 140.38,
  "text": "these things don't come with a manual,",
  "end": 140.8
 },
 {
  "i": 47,
  "start": 140.8,
  "speechStart": 140.92,
  "speechEnd": 143.08,
  "text": "and they don't ask permission to appear.",
  "end": 143.98
 },
 {
  "i": 48,
  "start": 143.98,
  "speechStart": 144.1,
  "speechEnd": 146.32,
  "text": "In the evening you take it all",
  "end": 146.2
 },
 {
  "i": 49,
  "start": 146.2,
  "speechStart": 146.32,
  "speechEnd": 148.5,
  "text": "to an empty underground car park,",
  "end": 148.9
 },
 {
  "i": 50,
  "start": 148.9,
  "speechStart": 149.02,
  "speechEnd": 152.16,
  "text": "because you want to know where your limit is. In the story,",
  "end": 152.82
 },
 {
  "i": 51,
  "start": 152.82,
  "speechStart": 152.94,
  "speechEnd": 156.2,
  "text": "Max Elephant takes a huge amount of cursed energy to summon.",
  "end": 156.72
 },
 {
  "i": 52,
  "start": 156.72,
  "speechStart": 156.84,
  "speechEnd": 158.8,
  "text": "An adult African elephant weighs",
  "end": 158.68
 },
 {
  "i": 53,
  "start": 158.68,
  "speechStart": 158.8,
  "speechEnd": 161.22,
  "text": "about six tonnes. Our own maths:",
  "end": 161.1
 },
 {
  "i": 54,
  "start": 161.1,
  "speechStart": 161.22,
  "speechEnd": 164.38,
  "text": "drop six thousand kilograms from three metres,",
  "end": 164.26
 },
 {
  "i": 55,
  "start": 164.26,
  "speechStart": 164.38,
  "speechEnd": 167.76,
  "text": "and you get roughly one hundred and seventy-six thousand joules.",
  "end": 168.2
 },
 {
  "i": 56,
  "start": 168.2,
  "speechStart": 168.32,
  "speechEnd": 170.46,
  "text": "You summon it. You make it stand up.",
  "end": 170.96
 },
 {
  "i": 57,
  "start": 170.96,
  "speechStart": 171.08,
  "speechEnd": 174.54,
  "text": "Then your legs go, and you sit on the concrete,",
  "end": 174.96
 },
 {
  "i": 58,
  "start": 174.96,
  "speechStart": 175.08,
  "speechEnd": 177.06,
  "text": "shaking, because it took everything",
  "end": 176.94
 },
 {
  "i": 59,
  "start": 176.94,
  "speechStart": 177.06,
  "speechEnd": 178.66,
  "text": "you had just to hold it there.",
  "end": 179.68
 },
 {
  "i": 60,
  "start": 179.68,
  "speechStart": 179.8,
  "speechEnd": 183.72,
  "text": "You spend an hour finding where you left your keys. Lesson four:",
  "end": 184.34
 },
 {
  "i": 61,
  "start": 184.34,
  "speechStart": 184.46,
  "speechEnd": 185.18,
  "text": "the bigger the shadow,",
  "end": 185.72
 },
 {
  "i": 62,
  "start": 185.72,
  "speechStart": 185.84,
  "speechEnd": 188.04,
  "text": "the bigger the bill, and you're the one who pays.",
  "end": 189.06
 },
 {
  "i": 63,
  "start": 189.06,
  "speechStart": 189.18,
  "speechEnd": 191.86,
  "text": "On day three, you try the Great Serpent,",
  "end": 192.38
 },
 {
  "i": 64,
  "start": 192.38,
  "speechStart": 192.5,
  "speechEnd": 195.68,
  "text": "a big white snake with black marks across its body.",
  "end": 196.28
 },
 {
  "i": 65,
  "start": 196.28,
  "speechStart": 196.4,
  "speechEnd": 198.76,
  "text": "The longest wild snake ever measured is a",
  "end": 198.64
 },
 {
  "i": 66,
  "start": 198.64,
  "speechStart": 198.76,
  "speechEnd": 201.6,
  "text": "reticulated python of seven point two two metres,",
  "end": 201.48
 },
 {
  "i": 67,
  "start": 201.48,
  "speechStart": 201.6,
  "speechEnd": 203.08,
  "text": "confirmed by Guinness in",
  "end": 202.96
 },
 {
  "i": 68,
  "start": 202.96,
  "speechStart": 203.08,
  "speechEnd": 205.22,
  "text": "twenty twenty-six.",
  "end": 205.1
 },
 {
  "i": 69,
  "start": 205.1,
  "speechStart": 205.22,
  "speechEnd": 208.3,
  "text": "Yours fills the hallway. You can't tell where it ends.",
  "end": 209.0
 },
 {
  "i": 70,
  "start": 209.0,
  "speechStart": 209.12,
  "speechEnd": 210.2,
  "text": "Your neighbour opens her door,",
  "end": 210.54
 },
 {
  "i": 71,
  "start": 210.54,
  "speechStart": 210.66,
  "speechEnd": 212.9,
  "text": "looks at the white coil blocking the stairs,",
  "end": 213.0
 },
 {
  "i": 72,
  "start": 213.0,
  "speechStart": 213.12,
  "speechEnd": 214.82,
  "text": "and goes back inside without a word.",
  "end": 215.38
 },
 {
  "i": 73,
  "start": 215.38,
  "speechStart": 215.5,
  "speechEnd": 218.64,
  "text": "She never mentions it again, even when you meet in the lift.",
  "end": 219.72
 },
 {
  "i": 74,
  "start": 219.72,
  "speechStart": 219.84,
  "speechEnd": 220.3,
  "text": "Lesson five:",
  "end": 220.84
 },
 {
  "i": 75,
  "start": 220.84,
  "speechStart": 220.96,
  "speechEnd": 224.46,
  "text": "when something is bigger than your building, you have to learn to put it back.",
  "end": 225.76
 },
 {
  "i": 76,
  "start": 225.76,
  "speechStart": 225.88,
  "speechEnd": 226.6,
  "text": "In the story,",
  "end": 226.88
 },
 {
  "i": 77,
  "start": 226.88,
  "speechStart": 227.0,
  "speechEnd": 229.76,
  "text": "two shikigami can fuse into something new.",
  "end": 230.4
 },
 {
  "i": 78,
  "start": 230.4,
  "speechStart": 230.52,
  "speechEnd": 231.92,
  "text": "So, of course, you try it.",
  "end": 232.22
 },
 {
  "i": 79,
  "start": 232.22,
  "speechStart": 232.34,
  "speechEnd": 235.42,
  "text": "You call two at once. They don't merge.",
  "end": 235.92
 },
 {
  "i": 80,
  "start": 235.92,
  "speechStart": 236.04,
  "speechEnd": 236.78,
  "text": "They tangle.",
  "end": 237.5
 },
 {
  "i": 81,
  "start": 237.5,
  "speechStart": 237.62,
  "speechEnd": 239.52,
  "text": "For ten seconds there's a creature in",
  "end": 239.4
 },
 {
  "i": 82,
  "start": 239.4,
  "speechStart": 239.52,
  "speechEnd": 241.32,
  "text": "your stairwell that has too many legs",
  "end": 241.2
 },
 {
  "i": 83,
  "start": 241.2,
  "speechStart": 241.32,
  "speechEnd": 243.68,
  "text": "and the wrong number of opinions about it.",
  "end": 244.2
 },
 {
  "i": 84,
  "start": 244.2,
  "speechStart": 244.32,
  "speechEnd": 247.2,
  "text": "You manage to send them back, but it takes everything you have.",
  "end": 247.72
 },
 {
  "i": 85,
  "start": 247.72,
  "speechStart": 247.84,
  "speechEnd": 248.86,
  "text": "You spend the next day in bed.",
  "end": 249.76
 },
 {
  "i": 86,
  "start": 249.76,
  "speechStart": 249.88,
  "speechEnd": 252.5,
  "text": "Lesson six: more is not stronger.",
  "end": 253.26
 },
 {
  "i": 87,
  "start": 253.26,
  "speechStart": 253.38,
  "speechEnd": 254.32,
  "text": "More is just more.",
  "end": 255.72
 },
 {
  "i": 88,
  "start": 255.72,
  "speechStart": 255.84,
  "speechEnd": 258.38,
  "text": "A boy in the park films your shadow at sunset.",
  "end": 258.76
 },
 {
  "i": 89,
  "start": 258.76,
  "speechStart": 258.88,
  "speechEnd": 260.32,
  "text": "It's the wrong shape.",
  "end": 260.74
 },
 {
  "i": 90,
  "start": 260.74,
  "speechStart": 260.86,
  "speechEnd": 264.72,
  "text": "It has ears, and it's wagging. The video spreads.",
  "end": 265.24
 },
 {
  "i": 91,
  "start": 265.24,
  "speechStart": 265.36,
  "speechEnd": 266.64,
  "text": "Half the comments say it's CGI.",
  "end": 267.14
 },
 {
  "i": 92,
  "start": 267.14,
  "speechStart": 267.26,
  "speechEnd": 269.82,
  "text": "The other half say it's a ghost dog.",
  "end": 269.7
 },
 {
  "i": 93,
  "start": 269.7,
  "speechStart": 269.82,
  "speechEnd": 271.24,
  "text": "Nobody says \"shikigami\",",
  "end": 271.12
 },
 {
  "i": 94,
  "start": 271.12,
  "speechStart": 271.24,
  "speechEnd": 273.58,
  "text": "because only a few people know what that means,",
  "end": 273.46
 },
 {
  "i": 95,
  "start": 273.46,
  "speechStart": 273.58,
  "speechEnd": 277.22,
  "text": "and they think it's a joke. Lesson seven:",
  "end": 277.1
 },
 {
  "i": 96,
  "start": 277.1,
  "speechStart": 277.22,
  "speechEnd": 278.96,
  "text": "the people who'd understand are",
  "end": 278.84
 },
 {
  "i": 97,
  "start": 278.84,
  "speechStart": 278.96,
  "speechEnd": 280.8,
  "text": "the ones who'd never believe it.",
  "end": 281.48
 },
 {
  "i": 98,
  "start": 281.48,
  "speechStart": 281.6,
  "speechEnd": 284.72,
  "text": "On day twelve you take it to an empty football pitch,",
  "end": 284.88
 },
 {
  "i": 99,
  "start": 284.88,
  "speechStart": 285.0,
  "speechEnd": 288.22,
  "text": "at night, to try something bigger. In the story,",
  "end": 288.1
 },
 {
  "i": 100,
  "start": 288.1,
  "speechStart": 288.22,
  "speechEnd": 290.26,
  "text": "Megumi's version of a Domain Expansion",
  "end": 290.14
 },
 {
  "i": 101,
  "start": 290.14,
  "speechStart": 290.26,
  "speechEnd": 292.16,
  "text": "is called Chimera Shadow Garden.",
  "end": 292.6
 },
 {
  "i": 102,
  "start": 292.6,
  "speechStart": 292.72,
  "speechEnd": 294.82,
  "text": "It has no walls, no closed barrier.",
  "end": 295.28
 },
 {
  "i": 103,
  "start": 295.28,
  "speechStart": 295.4,
  "speechEnd": 298.2,
  "text": "It spreads his shadow over whatever is already there.",
  "end": 298.76
 },
 {
  "i": 104,
  "start": 298.76,
  "speechStart": 298.88,
  "speechEnd": 299.62,
  "text": "And it's incomplete.",
  "end": 300.26
 },
 {
  "i": 105,
  "start": 300.26,
  "speechStart": 300.38,
  "speechEnd": 302.94,
  "text": "So you push your shadow outwards, across the grass,",
  "end": 303.12
 },
 {
  "i": 106,
  "start": 303.12,
  "speechStart": 303.24,
  "speechEnd": 305.2,
  "text": "until the whole pitch is dark under your feet.",
  "end": 305.08
 },
 {
  "i": 107,
  "start": 305.08,
  "speechStart": 305.2,
  "speechEnd": 308.66,
  "text": "The dogs run through it faster than anything you've ever seen,",
  "end": 308.88
 },
 {
  "i": 108,
  "start": 308.88,
  "speechStart": 309.0,
  "speechEnd": 310.98,
  "text": "as if the ground itself was helping them.",
  "end": 311.26
 },
 {
  "i": 109,
  "start": 311.26,
  "speechStart": 311.38,
  "speechEnd": 312.62,
  "text": "But nothing hits for you.",
  "end": 313.22
 },
 {
  "i": 110,
  "start": 313.22,
  "speechStart": 313.34,
  "speechEnd": 314.72,
  "text": "Nothing wins for you.",
  "end": 315.02
 },
 {
  "i": 111,
  "start": 315.02,
  "speechStart": 315.14,
  "speechEnd": 317.92,
  "text": "It's only a place where everything you call comes out easier.",
  "end": 318.5
 },
 {
  "i": 112,
  "start": 318.5,
  "speechStart": 318.62,
  "speechEnd": 319.5,
  "text": "You hold it for a minute,",
  "end": 319.38
 },
 {
  "i": 113,
  "start": 319.38,
  "speechStart": 319.5,
  "speechEnd": 322.3,
  "text": "and your head feels like it's full of wet sand.",
  "end": 322.88
 },
 {
  "i": 114,
  "start": 322.88,
  "speechStart": 323.0,
  "speechEnd": 325.4,
  "text": "Lesson eight: the garden doesn't fight.",
  "end": 325.82
 },
 {
  "i": 115,
  "start": 325.82,
  "speechStart": 325.94,
  "speechEnd": 327.34,
  "text": "It just makes the fight yours.",
  "end": 328.3
 },
 {
  "i": 116,
  "start": 328.3,
  "speechStart": 328.42,
  "speechEnd": 330.2,
  "text": "A man in a grey suit",
  "end": 330.48
 },
 {
  "i": 117,
  "start": 330.48,
  "speechStart": 330.6,
  "speechEnd": 332.14,
  "text": "sits down at your table in a café",
  "end": 332.02
 },
 {
  "i": 118,
  "start": 332.02,
  "speechStart": 332.14,
  "speechEnd": 334.6,
  "text": "and doesn't ask a single question.",
  "end": 335.24
 },
 {
  "i": 119,
  "start": 335.24,
  "speechStart": 335.36,
  "speechEnd": 336.52,
  "text": "He slides a card across.",
  "end": 337.18
 },
 {
  "i": 120,
  "start": 337.18,
  "speechStart": 337.3,
  "speechEnd": 339.24,
  "text": "He's not interested in what you can do.",
  "end": 339.74
 },
 {
  "i": 121,
  "start": 339.74,
  "speechStart": 339.86,
  "speechEnd": 342.34,
  "text": "He wants to know what you'd refuse to do.",
  "end": 342.68
 },
 {
  "i": 122,
  "start": 342.68,
  "speechStart": 342.8,
  "speechEnd": 343.84,
  "text": "You say you don't know yet.",
  "end": 344.52
 },
 {
  "i": 123,
  "start": 344.52,
  "speechStart": 344.64,
  "speechEnd": 347.2,
  "text": "He nods, as if that was the right answer,",
  "end": 347.46
 },
 {
  "i": 124,
  "start": 347.46,
  "speechStart": 347.58,
  "speechEnd": 350.44,
  "text": "and leaves without his coffee. Lesson nine:",
  "end": 351.1
 },
 {
  "i": 125,
  "start": 351.1,
  "speechStart": 351.22,
  "speechEnd": 353.58,
  "text": "the first question anyone asks about power",
  "end": 353.46
 },
 {
  "i": 126,
  "start": 353.46,
  "speechStart": 353.58,
  "speechEnd": 355.94,
  "text": "is how far you'd go.",
  "end": 356.84
 },
 {
  "i": 127,
  "start": 356.84,
  "speechStart": 356.96,
  "speechEnd": 360.04,
  "text": "On day twenty something stirs",
  "end": 359.92
 },
 {
  "i": 128,
  "start": 359.92,
  "speechStart": 360.04,
  "speechEnd": 362.38,
  "text": "in your shadow that isn't a dog,",
  "end": 362.26
 },
 {
  "i": 129,
  "start": 362.26,
  "speechStart": 362.38,
  "speechEnd": 364.54,
  "text": "or a toad, or an elephant.",
  "end": 365.48
 },
 {
  "i": 130,
  "start": 365.48,
  "speechStart": 365.6,
  "speechEnd": 368.28,
  "text": "In the story, it's called Mahoraga,",
  "end": 368.16
 },
 {
  "i": 131,
  "start": 368.16,
  "speechStart": 368.28,
  "speechEnd": 370.6,
  "text": "the strongest shikigami of the technique.",
  "end": 371.46
 },
 {
  "i": 132,
  "start": 371.46,
  "speechStart": 371.58,
  "speechEnd": 373.4,
  "text": "It adapts to whatever hits it,",
  "end": 373.42
 },
 {
  "i": 133,
  "start": 373.42,
  "speechStart": 373.54,
  "speechEnd": 376.28,
  "text": "and the wheel on its back turns as it learns.",
  "end": 377.0
 },
 {
  "i": 134,
  "start": 377.0,
  "speechStart": 377.12,
  "speechEnd": 379.38,
  "text": "And the ritual to summon it doesn't end",
  "end": 379.26
 },
 {
  "i": 135,
  "start": 379.26,
  "speechStart": 379.38,
  "speechEnd": 382.48,
  "text": "until either its target is dead, or it's tamed.",
  "end": 383.18
 },
 {
  "i": 136,
  "start": 383.18,
  "speechStart": 383.3,
  "speechEnd": 385.26,
  "text": "In the story, the only one",
  "end": 385.14
 },
 {
  "i": 137,
  "start": 385.14,
  "speechStart": 385.26,
  "speechEnd": 388.48,
  "text": "who ever tamed it was Sukuna. You close your eyes.",
  "end": 389.2
 },
 {
  "i": 138,
  "start": 389.2,
  "speechStart": 389.32,
  "speechEnd": 392.08,
  "text": "The wheel stops turning. You don't tell anyone.",
  "end": 392.86
 },
 {
  "i": 139,
  "start": 392.86,
  "speechStart": 392.98,
  "speechEnd": 394.12,
  "text": "Lesson ten:",
  "end": 394.0
 },
 {
  "i": 140,
  "start": 394.0,
  "speechStart": 394.12,
  "speechEnd": 397.16,
  "text": "there's one door in your shadow you can't walk back through.",
  "end": 398.22
 },
 {
  "i": 141,
  "start": 398.22,
  "speechStart": 398.34,
  "speechEnd": 400.08,
  "text": "On day twenty-five,",
  "end": 399.96
 },
 {
  "i": 142,
  "start": 399.96,
  "speechStart": 400.08,
  "speechEnd": 402.42,
  "text": "a child goes missing at the edge of the city,",
  "end": 402.52
 },
 {
  "i": 143,
  "start": 402.52,
  "speechStart": 402.64,
  "speechEnd": 405.16,
  "text": "and the search party is walking in lines with torches.",
  "end": 405.82
 },
 {
  "i": 144,
  "start": 405.82,
  "speechStart": 405.94,
  "speechEnd": 409.1,
  "text": "You stand at the treeline with your hand over your shadow.",
  "end": 408.98
 },
 {
  "i": 145,
  "start": 408.98,
  "speechStart": 409.1,
  "speechEnd": 411.86,
  "text": "The dogs take the scent from the child's coat,",
  "end": 411.74
 },
 {
  "i": 146,
  "start": 411.74,
  "speechStart": 411.86,
  "speechEnd": 412.74,
  "text": "and they go.",
  "end": 413.48
 },
 {
  "i": 147,
  "start": 413.48,
  "speechStart": 413.6,
  "speechEnd": 416.92,
  "text": "White and black, low through the trees, silent.",
  "end": 417.5
 },
 {
  "i": 148,
  "start": 417.5,
  "speechStart": 417.62,
  "speechEnd": 419.54,
  "text": "They find her in forty minutes,",
  "end": 419.42
 },
 {
  "i": 149,
  "start": 419.42,
  "speechStart": 419.54,
  "speechEnd": 421.56,
  "text": "asleep under a fallen trunk,",
  "end": 421.44
 },
 {
  "i": 150,
  "start": 421.44,
  "speechStart": 421.56,
  "speechEnd": 425.08,
  "text": "with a muddy shoe in her arms. Nobody asks how.",
  "end": 425.42
 },
 {
  "i": 151,
  "start": 425.42,
  "speechStart": 425.54,
  "speechEnd": 428.52,
  "text": "They're too busy hugging her. Lesson eleven:",
  "end": 428.4
 },
 {
  "i": 152,
  "start": 428.4,
  "speechStart": 428.52,
  "speechEnd": 431.04,
  "text": "sometimes the point isn't what you can do.",
  "end": 431.38
 },
 {
  "i": 153,
  "start": 431.38,
  "speechStart": 431.5,
  "speechEnd": 432.98,
  "text": "It's what you do with it.",
  "end": 434.0
 },
 {
  "i": 154,
  "start": 434.0,
  "speechStart": 434.12,
  "speechEnd": 436.16,
  "text": "By day thirty you can feel",
  "end": 436.04
 },
 {
  "i": 155,
  "start": 436.04,
  "speechStart": 436.16,
  "speechEnd": 438.38,
  "text": "exactly how much each of them costs.",
  "end": 438.26
 },
 {
  "i": 156,
  "start": 438.26,
  "speechStart": 438.38,
  "speechEnd": 441.62,
  "text": "The dogs are cheap. The toad is cheap.",
  "end": 442.04
 },
 {
  "i": 157,
  "start": 442.04,
  "speechStart": 442.16,
  "speechEnd": 444.84,
  "text": "The elephant leaves you in bed for a day.",
  "end": 445.18
 },
 {
  "i": 158,
  "start": 445.18,
  "speechStart": 445.3,
  "speechEnd": 447.56,
  "text": "You're treating your own shadow like a bank account,",
  "end": 447.44
 },
 {
  "i": 159,
  "start": 447.44,
  "speechStart": 447.56,
  "speechEnd": 450.18,
  "text": "and you're afraid to check the balance.",
  "end": 450.82
 },
 {
  "i": 160,
  "start": 450.82,
  "speechStart": 450.94,
  "speechEnd": 452.14,
  "text": "Lesson twelve:",
  "end": 452.02
 },
 {
  "i": 161,
  "start": 452.02,
  "speechStart": 452.14,
  "speechEnd": 453.42,
  "text": "you're never out of shadows.",
  "end": 454.14
 },
 {
  "i": 162,
  "start": 454.14,
  "speechStart": 454.26,
  "speechEnd": 455.78,
  "text": "You're only ever out of you.",
  "end": 457.02
 },
 {
  "i": 163,
  "start": 457.02,
  "speechStart": 457.14,
  "speechEnd": 458.88,
  "text": "On day forty, at night,",
  "end": 458.76
 },
 {
  "i": 164,
  "start": 458.76,
  "speechStart": 458.88,
  "speechEnd": 461.42,
  "text": "a floor of the car park near your flat",
  "end": 461.3
 },
 {
  "i": 165,
  "start": 461.3,
  "speechStart": 461.42,
  "speechEnd": 465.36,
  "text": "collapses with eleven people underneath it. You run.",
  "end": 465.96
 },
 {
  "i": 166,
  "start": 465.96,
  "speechStart": 466.08,
  "speechEnd": 467.58,
  "text": "You're the only one who can do anything.",
  "end": 468.1
 },
 {
  "i": 167,
  "start": 468.1,
  "speechStart": 468.22,
  "speechEnd": 470.2,
  "text": "There's one thing in your shadow that",
  "end": 470.08
 },
 {
  "i": 168,
  "start": 470.08,
  "speechStart": 470.2,
  "speechEnd": 472.06,
  "text": "could lift the slab with one hand.",
  "end": 472.8
 },
 {
  "i": 169,
  "start": 472.8,
  "speechStart": 472.92,
  "speechEnd": 474.18,
  "text": "You can feel it turning.",
  "end": 474.74
 },
 {
  "i": 170,
  "start": 474.74,
  "speechStart": 474.86,
  "speechEnd": 477.98,
  "text": "You stand at the edge of the rubble with your hand over your shadow,",
  "end": 477.86
 },
 {
  "i": 171,
  "start": 477.86,
  "speechStart": 477.98,
  "speechEnd": 480.14,
  "text": "and you take it away.",
  "end": 480.58
 },
 {
  "i": 172,
  "start": 480.58,
  "speechStart": 480.7,
  "speechEnd": 482.22,
  "text": "So you do the other thing.",
  "end": 482.86
 },
 {
  "i": 173,
  "start": 482.86,
  "speechStart": 482.98,
  "speechEnd": 485.12,
  "text": "You spread your shadow across the floor,",
  "end": 485.16
 },
 {
  "i": 174,
  "start": 485.16,
  "speechStart": 485.28,
  "speechEnd": 488.48,
  "text": "the way you practised on the pitch, over whatever's already there.",
  "end": 488.36
 },
 {
  "i": 175,
  "start": 488.36,
  "speechStart": 488.48,
  "speechEnd": 490.12,
  "text": "It doesn't need to be perfect.",
  "end": 490.64
 },
 {
  "i": 176,
  "start": 490.64,
  "speechStart": 490.76,
  "speechEnd": 492.16,
  "text": "It only needs to be big enough.",
  "end": 492.82
 },
 {
  "i": 177,
  "start": 492.82,
  "speechStart": 492.94,
  "speechEnd": 495.52,
  "text": "The dogs find them by smell, under the concrete.",
  "end": 495.98
 },
 {
  "i": 178,
  "start": 495.98,
  "speechStart": 496.1,
  "speechEnd": 499.36,
  "text": "The toad pulls them out, one by one, with its tongue.",
  "end": 499.88
 },
 {
  "i": 179,
  "start": 499.88,
  "speechStart": 500.0,
  "speechEnd": 501.64,
  "text": "The serpent slides under the beams.",
  "end": 502.3
 },
 {
  "i": 180,
  "start": 502.3,
  "speechStart": 502.42,
  "speechEnd": 504.34,
  "text": "The elephant stands up under the slab",
  "end": 504.22
 },
 {
  "i": 181,
  "start": 504.22,
  "speechStart": 504.34,
  "speechEnd": 507.36,
  "text": "and holds it, and your legs shake the whole time.",
  "end": 508.0
 },
 {
  "i": 182,
  "start": 508.0,
  "speechStart": 508.12,
  "speechEnd": 509.34,
  "text": "Eleven people come out.",
  "end": 509.82
 },
 {
  "i": 183,
  "start": 509.82,
  "speechStart": 509.94,
  "speechEnd": 511.38,
  "text": "Nobody asks what you are.",
  "end": 512.14
 },
 {
  "i": 184,
  "start": 512.14,
  "speechStart": 512.26,
  "speechEnd": 514.56,
  "text": "The next morning you can't get out of bed.",
  "end": 515.1
 },
 {
  "i": 185,
  "start": 515.1,
  "speechStart": 515.22,
  "speechEnd": 517.78,
  "text": "Now you know what it really is. Not a gift.",
  "end": 517.72
 },
 {
  "i": 186,
  "start": 517.72,
  "speechStart": 517.84,
  "speechEnd": 519.78,
  "text": "A door in the floor,",
  "end": 520.3
 },
 {
  "i": 187,
  "start": 520.3,
  "speechStart": 520.42,
  "speechEnd": 523.34,
  "text": "and you're the only one who decides what comes through.",
  "end": 523.96
 },
 {
  "i": 188,
  "start": 523.96,
  "speechStart": 524.08,
  "speechEnd": 525.64,
  "text": "Lesson thirteen:",
  "end": 525.52
 },
 {
  "i": 189,
  "start": 525.52,
  "speechStart": 525.64,
  "speechEnd": 528.74,
  "text": "the strongest thing in your shadow is the one you didn't open.",
  "end": 530.16
 },
 {
  "i": 190,
  "start": 530.16,
  "speechStart": 530.28,
  "speechEnd": 532.52,
  "text": "The next night at three fifteen,",
  "end": 532.4
 },
 {
  "i": 191,
  "start": 532.4,
  "speechStart": 532.52,
  "speechEnd": 536.56,
  "text": "you lift your arm, and your shadow doesn't move. You wait.",
  "end": 537.32
 },
 {
  "i": 192,
  "start": 537.32,
  "speechStart": 537.44,
  "speechEnd": 541.32,
  "text": "Something stirs under it, and it sits. It's the white dog.",
  "end": 541.96
 },
 {
  "i": 193,
  "start": 541.96,
  "speechStart": 542.08,
  "speechEnd": 545.28,
  "text": "So if you woke up tomorrow with Megumi's Ten Shadows,",
  "end": 545.74
 },
 {
  "i": 194,
  "start": 545.74,
  "speechStart": 545.86,
  "speechEnd": 547.06,
  "text": "which one would you call first?",
  "end": 547.94
 },
 {
  "i": 195,
  "start": 547.94,
  "speechStart": 548.06,
  "speechEnd": 549.98,
  "text": "And would you ever open the one that",
  "end": 549.86
 },
 {
  "i": 196,
  "start": 549.86,
  "speechStart": 549.98,
  "speechEnd": 552.98,
  "text": "can only be stopped by killing you? Tell me in the comments.",
  "end": 554.58
 }
]