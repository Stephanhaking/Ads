  {
   "id": "s007",
   "start": 21.12,
   "end": 26.2,
   "line": "So what if you were super strong? Not gym strong. Container strong.",
   "set": null,
   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s008",
   "start": 26.2,
   "end": 28.94,
   "line": "Let's start with the strongest humans alive.",
   "set": null,
   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s009",
   "start": 28.94,
   "end": 33.26,
   "line": "In 2020, an Icelandic strongman named Hafthor Bjornsson deadlifted five hundred",
   "set": null,
   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s010",
   "start": 33.26,
   "end": 36.72,
   "line": "and one kilograms. That's about seven adults.",
   "set": null,
   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s011",
   "start": 36.72,
   "end": 39.38,
   "line": "An empty shipping container weighs over two tonnes.",
   "set": null,
   "scene": "TODO",
   "footnote": "",
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s012",
   "start": 39.38,
   "end": 44.56,
   "line": "A full one can weigh more than twenty. Bo's one was full.",
