[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 1.68,
  "text": "You wake up at seven twelve",
  "end": 1.56
 },
 {
  "i": 1,
  "start": 1.56,
  "speechStart": 1.68,
  "speechEnd": 3.58,
  "text": "and the world is slow.",
  "end": 4.26
 },
 {
  "i": 2,
  "start": 4.26,
  "speechStart": 4.38,
  "speechEnd": 6.3,
  "text": "A glass slides off your nightstand",
  "end": 6.18
 },
 {
  "i": 3,
  "start": 6.18,
  "speechStart": 6.3,
  "speechEnd": 8.82,
  "text": "and falls like it's underwater.",
  "end": 9.62
 },
 {
  "i": 4,
  "start": 9.62,
  "speechStart": 9.74,
  "speechEnd": 12.2,
  "text": "You don't reach for it. Something else does.",
  "end": 12.68
 },
 {
  "i": 5,
  "start": 12.68,
  "speechStart": 12.8,
  "speechEnd": 14.6,
  "text": "A huge pale arm,",
  "end": 14.82
 },
 {
  "i": 6,
  "start": 14.82,
  "speechStart": 14.94,
  "speechEnd": 17.26,
  "text": "blue and purple, comes out of your shoulder",
  "end": 17.14
 },
 {
  "i": 7,
  "start": 17.14,
  "speechStart": 17.26,
  "speechEnd": 19.88,
  "text": "and puts the glass back on the table",
  "end": 19.76
 },
 {
  "i": 8,
  "start": 19.76,
  "speechStart": 19.88,
  "speechEnd": 22.68,
  "text": "before your own hand has even moved.",
  "end": 23.48
 },
 {
  "i": 9,
  "start": 23.48,
  "speechStart": 23.6,
  "speechEnd": 25.76,
  "text": "You've woken up with Star Platinum,",
  "end": 25.64
 },
 {
  "i": 10,
  "start": 25.64,
  "speechStart": 25.76,
  "speechEnd": 29.1,
  "text": "Jotaro's Stand from JoJo's Bizarre Adventure.",
  "end": 29.98
 },
 {
  "i": 11,
  "start": 29.98,
  "speechStart": 30.1,
  "speechEnd": 30.76,
  "text": "And before tonight,",
  "end": 31.32
 },
 {
  "i": 12,
  "start": 31.32,
  "speechStart": 31.44,
  "speechEnd": 33.88,
  "text": "it's going to cost you something you can't replace.",
  "end": 35.18
 },
 {
  "i": 13,
  "start": 35.18,
  "speechStart": 35.3,
  "speechEnd": 36.46,
  "text": "Nobody else can see it.",
  "end": 36.74
 },
 {
  "i": 14,
  "start": 36.74,
  "speechStart": 36.86,
  "speechEnd": 40.22,
  "text": "Your mum walks in and asks why you're staring at the wardrobe.",
  "end": 41.02
 },
 {
  "i": 15,
  "start": 41.02,
  "speechStart": 41.14,
  "speechEnd": 43.2,
  "text": "In the story this is called a Stand,",
  "end": 43.5
 },
 {
  "i": 16,
  "start": 43.5,
  "speechStart": 43.62,
  "speechEnd": 45.66,
  "text": "and Star Platinum's base powers are simple:",
  "end": 46.28
 },
 {
  "i": 17,
  "start": 46.28,
  "speechStart": 46.4,
  "speechEnd": 48.16,
  "text": "strength, speed and precision,",
  "end": 48.58
 },
 {
  "i": 18,
  "start": 48.58,
  "speechStart": 48.7,
  "speechEnd": 50.02,
  "text": "all far beyond a human.",
  "end": 50.5
 },
 {
  "i": 19,
  "start": 50.5,
  "speechStart": 50.62,
  "speechEnd": 54.12,
  "text": "You think \"left\" and it's already moved. Lesson one:",
  "end": 54.0
 },
 {
  "i": 20,
  "start": 54.0,
  "speechStart": 54.12,
  "speechEnd": 56.2,
  "text": "you're not the strong one.",
  "end": 56.56
 },
 {
  "i": 21,
  "start": 56.56,
  "speechStart": 56.68,
  "speechEnd": 58.04,
  "text": "Something next to you is.",
  "end": 59.08
 },
 {
  "i": 22,
  "start": 59.08,
  "speechStart": 59.2,
  "speechEnd": 60.94,
  "text": "At noon you go out for bread,",
  "end": 61.38
 },
 {
  "i": 23,
  "start": 61.38,
  "speechStart": 61.5,
  "speechEnd": 63.0,
  "text": "because you're trying to act normal.",
  "end": 63.78
 },
 {
  "i": 24,
  "start": 63.78,
  "speechStart": 63.9,
  "speechEnd": 66.7,
  "text": "A kid's trolley clips a tower of tinned tomatoes,",
  "end": 66.58
 },
 {
  "i": 25,
  "start": 66.58,
  "speechStart": 66.7,
  "speechEnd": 70.36,
  "text": "two metres tall, and it starts to fall. You flinch,",
  "end": 70.48
 },
 {
  "i": 26,
  "start": 70.48,
  "speechStart": 70.6,
  "speechEnd": 73.42,
  "text": "and Star Platinum catches all of it.",
  "end": 73.3
 },
 {
  "i": 27,
  "start": 73.3,
  "speechStart": 73.42,
  "speechEnd": 76.4,
  "text": "Forty tins, back on the shelf, labels out.",
  "end": 77.06
 },
 {
  "i": 28,
  "start": 77.06,
  "speechStart": 77.18,
  "speechEnd": 78.36,
  "text": "Then it keeps going.",
  "end": 78.68
 },
 {
  "i": 29,
  "start": 78.68,
  "speechStart": 78.8,
  "speechEnd": 81.98,
  "text": "It straightens the shelf next to it. Then the pasta display.",
  "end": 82.48
 },
 {
  "i": 30,
  "start": 82.48,
  "speechStart": 82.6,
  "speechEnd": 84.62,
  "text": "The manager watches forty tins",
  "end": 84.5
 },
 {
  "i": 31,
  "start": 84.5,
  "speechStart": 84.62,
  "speechEnd": 86.82,
  "text": "fly back into place all by themselves,",
  "end": 86.7
 },
 {
  "i": 32,
  "start": 86.7,
  "speechStart": 86.82,
  "speechEnd": 89.28,
  "text": "and you leave without any bread.",
  "end": 90.22
 },
 {
  "i": 33,
  "start": 90.22,
  "speechStart": 90.34,
  "speechEnd": 91.56,
  "text": "Lesson two:",
  "end": 91.44
 },
 {
  "i": 34,
  "start": 91.44,
  "speechStart": 91.56,
  "speechEnd": 92.86,
  "text": "it doesn't know when to stop.",
  "end": 93.22
 },
 {
  "i": 35,
  "start": 93.22,
  "speechStart": 93.34,
  "speechEnd": 94.76,
  "text": "You have to tell it.",
  "end": 95.34
 },
 {
  "i": 36,
  "start": 95.34,
  "speechStart": 95.46,
  "speechEnd": 97.78,
  "text": "That evening you take it to an empty gym.",
  "end": 98.34
 },
 {
  "i": 37,
  "start": 98.34,
  "speechStart": 98.46,
  "speechEnd": 101.5,
  "text": "One of the heaviest deadlifts ever recorded is about five hundred",
  "end": 101.38
 },
 {
  "i": 38,
  "start": 101.38,
  "speechStart": 101.5,
  "speechEnd": 102.38,
  "text": "and ten kilograms,",
  "end": 102.62
 },
 {
  "i": 39,
  "start": 102.62,
  "speechStart": 102.74,
  "speechEnd": 105.72,
  "text": "lifted by Hafthor Bjornsson in twenty twenty-five.",
  "end": 105.6
 },
 {
  "i": 40,
  "start": 105.6,
  "speechStart": 105.72,
  "speechEnd": 107.08,
  "text": "A human at the very edge.",
  "end": 106.96
 },
 {
  "i": 41,
  "start": 106.96,
  "speechStart": 107.08,
  "speechEnd": 110.3,
  "text": "You load every plate in the building onto one bar.",
  "end": 111.0
 },
 {
  "i": 42,
  "start": 111.0,
  "speechStart": 111.12,
  "speechEnd": 114.0,
  "text": "Star Platinum picks it up with one hand, like a shopping bag.",
  "end": 114.34
 },
 {
  "i": 43,
  "start": 114.34,
  "speechStart": 114.46,
  "speechEnd": 116.54,
  "text": "The bar bends in the middle like a banana.",
  "end": 117.16
 },
 {
  "i": 44,
  "start": 117.16,
  "speechStart": 117.28,
  "speechEnd": 119.48,
  "text": "The owner walks in, looks at the bar,",
  "end": 119.74
 },
 {
  "i": 45,
  "start": 119.74,
  "speechStart": 119.86,
  "speechEnd": 124.24,
  "text": "looks at you, and cancels your membership on the spot. Lesson three:",
  "end": 124.8
 },
 {
  "i": 46,
  "start": 124.8,
  "speechStart": 124.92,
  "speechEnd": 125.62,
  "text": "strength is easy.",
  "end": 126.08
 },
 {
  "i": 47,
  "start": 126.08,
  "speechStart": 126.2,
  "speechEnd": 128.14,
  "text": "Putting things down gently is the hard part.",
  "end": 129.14
 },
 {
  "i": 48,
  "start": 129.14,
  "speechStart": 129.26,
  "speechEnd": 132.56,
  "text": "You get home and your hands are shaking, and you notice something:",
  "end": 133.22
 },
 {
  "i": 49,
  "start": 133.22,
  "speechStart": 133.34,
  "speechEnd": 135.9,
  "text": "everything it does, you feel afterwards.",
  "end": 136.98
 },
 {
  "i": 50,
  "start": 136.98,
  "speechStart": 137.1,
  "speechEnd": 139.22,
  "text": "Every fan knows what comes next.",
  "end": 139.1
 },
 {
  "i": 51,
  "start": 139.1,
  "speechStart": 139.22,
  "speechEnd": 141.68,
  "text": "ORA ORA ORA.",
  "end": 141.56
 },
 {
  "i": 52,
  "start": 141.56,
  "speechStart": 141.68,
  "speechEnd": 143.16,
  "text": "So you try it on a heavy bag.",
  "end": 143.6
 },
 {
  "i": 53,
  "start": 143.6,
  "speechStart": 143.72,
  "speechEnd": 145.74,
  "text": "Real boxers' punches move at roughly",
  "end": 145.62
 },
 {
  "i": 54,
  "start": 145.62,
  "speechStart": 145.74,
  "speechEnd": 147.56,
  "text": "six to eleven metres per second.",
  "end": 148.08
 },
 {
  "i": 55,
  "start": 148.08,
  "speechStart": 148.2,
  "speechEnd": 149.6,
  "text": "Now say, just as an example,",
  "end": 149.7
 },
 {
  "i": 56,
  "start": 149.7,
  "speechStart": 149.82,
  "speechEnd": 153.0,
  "text": "that a Stand throws twenty punches a second at that speed.",
  "end": 153.62
 },
 {
  "i": 57,
  "start": 153.62,
  "speechStart": 153.74,
  "speechEnd": 156.78,
  "text": "The bag lasts four seconds. Then it splits,",
  "end": 157.3
 },
 {
  "i": 58,
  "start": 157.3,
  "speechStart": 157.42,
  "speechEnd": 159.94,
  "text": "and sand pours across the floor like an hourglass.",
  "end": 160.66
 },
 {
  "i": 59,
  "start": 160.66,
  "speechStart": 160.78,
  "speechEnd": 164.18,
  "text": "You sit down in it. You're not hungry. You're starving.",
  "end": 164.74
 },
 {
  "i": 60,
  "start": 164.74,
  "speechStart": 164.86,
  "speechEnd": 166.18,
  "text": "You eat three dinners that night.",
  "end": 166.6
 },
 {
  "i": 61,
  "start": 166.6,
  "speechStart": 166.72,
  "speechEnd": 170.1,
  "text": "You've started calling it Gary. It doesn't answer to Gary.",
  "end": 170.78
 },
 {
  "i": 62,
  "start": 170.78,
  "speechStart": 170.9,
  "speechEnd": 171.3,
  "text": "Lesson four:",
  "end": 171.88
 },
 {
  "i": 63,
  "start": 171.88,
  "speechStart": 172.0,
  "speechEnd": 174.88,
  "text": "every punch has to be paid for, and you're the one who pays.",
  "end": 176.22
 },
 {
  "i": 64,
  "start": 176.22,
  "speechStart": 176.34,
  "speechEnd": 179.04,
  "text": "At night your keys fall through a drain grate.",
  "end": 179.84
 },
 {
  "i": 65,
  "start": 179.84,
  "speechStart": 179.96,
  "speechEnd": 183.14,
  "text": "In the story, Star Platinum has a move called Star Finger:",
  "end": 183.6
 },
 {
  "i": 66,
  "start": 183.6,
  "speechStart": 183.72,
  "speechEnd": 187.16,
  "text": "it stretches two of its fingers to reach further than its arms can.",
  "end": 188.12
 },
 {
  "i": 67,
  "start": 188.12,
  "speechStart": 188.24,
  "speechEnd": 191.28,
  "text": "Two fingers slide down between the bars like chopsticks,",
  "end": 191.16
 },
 {
  "i": 68,
  "start": 191.16,
  "speechStart": 191.28,
  "speechEnd": 193.08,
  "text": "and come back up with your keys,",
  "end": 193.76
 },
 {
  "i": 69,
  "start": 193.76,
  "speechStart": 193.88,
  "speechEnd": 197.0,
  "text": "a two-euro coin, and somebody's wedding ring.",
  "end": 197.48
 },
 {
  "i": 70,
  "start": 197.48,
  "speechStart": 197.6,
  "speechEnd": 199.4,
  "text": "You hand the ring in at the police station.",
  "end": 199.96
 },
 {
  "i": 71,
  "start": 199.96,
  "speechStart": 200.08,
  "speechEnd": 202.02,
  "text": "You don't explain how you got it.",
  "end": 202.22
 },
 {
  "i": 72,
  "start": 202.22,
  "speechStart": 202.34,
  "speechEnd": 203.7,
  "text": "Lesson five:",
  "end": 203.58
 },
 {
  "i": 73,
  "start": 203.58,
  "speechStart": 203.7,
  "speechEnd": 205.88,
  "text": "the useful tricks are the small ones.",
  "end": 206.54
 },
 {
  "i": 74,
  "start": 206.54,
  "speechStart": 206.66,
  "speechEnd": 209.04,
  "text": "A boy in the park films you",
  "end": 208.92
 },
 {
  "i": 75,
  "start": 208.92,
  "speechStart": 209.04,
  "speechEnd": 211.06,
  "text": "catching his football before it hits a pram.",
  "end": 211.46
 },
 {
  "i": 76,
  "start": 211.46,
  "speechStart": 211.58,
  "speechEnd": 213.26,
  "text": "In the video you're standing still,",
  "end": 213.14
 },
 {
  "i": 77,
  "start": 213.14,
  "speechStart": 213.26,
  "speechEnd": 215.7,
  "text": "and the ball just stops in the air,",
  "end": 215.58
 },
 {
  "i": 78,
  "start": 215.58,
  "speechStart": 215.7,
  "speechEnd": 217.08,
  "text": "a metre from the baby.",
  "end": 217.76
 },
 {
  "i": 79,
  "start": 217.76,
  "speechStart": 217.88,
  "speechEnd": 219.22,
  "text": "Some people say it's edited.",
  "end": 219.52
 },
 {
  "i": 80,
  "start": 219.52,
  "speechStart": 219.64,
  "speechEnd": 220.94,
  "text": "Some people say it's a ghost.",
  "end": 221.66
 },
 {
  "i": 81,
  "start": 221.66,
  "speechStart": 221.78,
  "speechEnd": 224.36,
  "text": "Nobody says \"Stand\", because the only people",
  "end": 224.24
 },
 {
  "i": 82,
  "start": 224.24,
  "speechStart": 224.36,
  "speechEnd": 227.76,
  "text": "who know what that is think it's a joke. Lesson six:",
  "end": 228.34
 },
 {
  "i": 83,
  "start": 228.34,
  "speechStart": 228.46,
  "speechEnd": 231.3,
  "text": "the ones who'd understand are the ones who'd never believe it.",
  "end": 232.24
 },
 {
  "i": 84,
  "start": 232.24,
  "speechStart": 232.36,
  "speechEnd": 235.52,
  "text": "Fans love the scenes where Star Platinum catches bullets.",
  "end": 235.92
 },
 {
  "i": 85,
  "start": 235.92,
  "speechStart": 236.04,
  "speechEnd": 238.78,
  "text": "So you ask how fast is fast enough.",
  "end": 239.32
 },
 {
  "i": 86,
  "start": 239.32,
  "speechStart": 239.44,
  "speechEnd": 242.64,
  "text": "You don't test it. You never would. You do it on a whiteboard.",
  "end": 243.24
 },
 {
  "i": 87,
  "start": 243.24,
  "speechStart": 243.36,
  "speechEnd": 245.2,
  "text": "Human visual reaction time is",
  "end": 245.08
 },
 {
  "i": 88,
  "start": 245.08,
  "speechStart": 245.2,
  "speechEnd": 246.9,
  "text": "about a quarter of a second,",
  "end": 246.78
 },
 {
  "i": 89,
  "start": 246.78,
  "speechStart": 246.9,
  "speechEnd": 250.02,
  "text": "between one hundred and ninety and two hundred and eighty-five milliseconds.",
  "end": 250.98
 },
 {
  "i": 90,
  "start": 250.98,
  "speechStart": 251.1,
  "speechEnd": 254.11,
  "text": "A nine-millimetre pistol bullet leaves the barrel at around three hundred",
  "end": 253.99
 },
 {
  "i": 91,
  "start": 253.99,
  "speechStart": 254.11,
  "speechEnd": 257.26,
  "text": "and fifty to four hundred and ten metres per second.",
  "end": 257.84
 },
 {
  "i": 92,
  "start": 257.84,
  "speechStart": 257.96,
  "speechEnd": 259.06,
  "text": "Our own maths:",
  "end": 258.94
 },
 {
  "i": 93,
  "start": 258.94,
  "speechStart": 259.06,
  "speechEnd": 260.32,
  "text": "at three hundred and sixty,",
  "end": 260.2
 },
 {
  "i": 94,
  "start": 260.2,
  "speechStart": 260.32,
  "speechEnd": 263.28,
  "text": "it crosses ten metres in about twenty-eight milliseconds.",
  "end": 264.04
 },
 {
  "i": 95,
  "start": 264.04,
  "speechStart": 264.16,
  "speechEnd": 266.98,
  "text": "That's about nine times shorter than your reaction time.",
  "end": 267.94
 },
 {
  "i": 96,
  "start": 267.94,
  "speechStart": 268.06,
  "speechEnd": 270.48,
  "text": "Usain Bolt, the fastest human ever measured,",
  "end": 270.98
 },
 {
  "i": 97,
  "start": 270.98,
  "speechStart": 271.1,
  "speechEnd": 274.2,
  "text": "averaged about ten metres per second. You put the marker down.",
  "end": 274.88
 },
 {
  "i": 98,
  "start": 274.88,
  "speechStart": 275.0,
  "speechEnd": 278.1,
  "text": "There's one thing in the story that doesn't depend on speed at all.",
  "end": 278.6
 },
 {
  "i": 99,
  "start": 278.6,
  "speechStart": 278.72,
  "speechEnd": 280.08,
  "text": "Near the end of Part three,",
  "end": 279.96
 },
 {
  "i": 100,
  "start": 279.96,
  "speechStart": 280.08,
  "speechEnd": 283.5,
  "text": "Jotaro learns to stop time, about five seconds at first.",
  "end": 284.06
 },
 {
  "i": 101,
  "start": 284.06,
  "speechStart": 284.18,
  "speechEnd": 286.02,
  "text": "You don't have that. You think.",
  "end": 286.72
 },
 {
  "i": 102,
  "start": 286.72,
  "speechStart": 286.84,
  "speechEnd": 288.1,
  "text": "Lesson seven:",
  "end": 287.98
 },
 {
  "i": 103,
  "start": 287.98,
  "speechStart": 288.1,
  "speechEnd": 290.96,
  "text": "being fast doesn't make you fast enough for everything.",
  "end": 292.26
 },
 {
  "i": 104,
  "start": 292.26,
  "speechStart": 292.38,
  "speechEnd": 295.68,
  "text": "By day thirty you can't stop catching things. Cups.",
  "end": 296.06
 },
 {
  "i": 105,
  "start": 296.06,
  "speechStart": 296.18,
  "speechEnd": 297.88,
  "text": "Phones. A tray of glasses.",
  "end": 298.16
 },
 {
  "i": 106,
  "start": 298.16,
  "speechStart": 298.28,
  "speechEnd": 299.64,
  "text": "A toddler falling off a wall.",
  "end": 300.32
 },
 {
  "i": 107,
  "start": 300.32,
  "speechStart": 300.44,
  "speechEnd": 302.04,
  "text": "Your shoulders are always tight.",
  "end": 302.46
 },
 {
  "i": 108,
  "start": 302.46,
  "speechStart": 302.58,
  "speechEnd": 304.26,
  "text": "You watch the edges of every table.",
  "end": 304.14
 },
 {
  "i": 109,
  "start": 304.14,
  "speechStart": 304.26,
  "speechEnd": 306.78,
  "text": "Your friends notice you never relax.",
  "end": 307.48
 },
 {
  "i": 110,
  "start": 307.48,
  "speechStart": 307.6,
  "speechEnd": 310.92,
  "text": "Your hands shake every evening. Lesson eight:",
  "end": 310.8
 },
 {
  "i": 111,
  "start": 310.8,
  "speechStart": 310.92,
  "speechEnd": 312.02,
  "text": "when you can catch everything,",
  "end": 312.52
 },
 {
  "i": 112,
  "start": 312.52,
  "speechStart": 312.64,
  "speechEnd": 317.3,
  "text": "you start feeling responsible for everything. On day forty,",
  "end": 317.18
 },
 {
  "i": 113,
  "start": 317.18,
  "speechStart": 317.3,
  "speechEnd": 320.4,
  "text": "a delivery van rolls down a hill with nobody in it.",
  "end": 320.58
 },
 {
  "i": 114,
  "start": 320.58,
  "speechStart": 320.7,
  "speechEnd": 322.54,
  "text": "At the bottom there's a school crossing,",
  "end": 322.42
 },
 {
  "i": 115,
  "start": 322.42,
  "speechStart": 322.54,
  "speechEnd": 326.46,
  "text": "and the lollipop lady has just stepped out. You run.",
  "end": 326.94
 },
 {
  "i": 116,
  "start": 326.94,
  "speechStart": 327.06,
  "speechEnd": 328.12,
  "text": "You're not going to make it.",
  "end": 328.42
 },
 {
  "i": 117,
  "start": 328.42,
  "speechStart": 328.54,
  "speechEnd": 330.14,
  "text": "Star Platinum isn't going to make it either.",
  "end": 330.6
 },
 {
  "i": 118,
  "start": 330.6,
  "speechStart": 330.72,
  "speechEnd": 334.22,
  "text": "So you do the only thing you've never tried. You hold your breath.",
  "end": 334.78
 },
 {
  "i": 119,
  "start": 334.78,
  "speechStart": 334.9,
  "speechEnd": 335.72,
  "text": "The world goes silent.",
  "end": 336.18
 },
 {
  "i": 120,
  "start": 336.18,
  "speechStart": 336.3,
  "speechEnd": 338.32,
  "text": "The van hangs in the air like a photograph.",
  "end": 338.86
 },
 {
  "i": 121,
  "start": 338.86,
  "speechStart": 338.98,
  "speechEnd": 341.96,
  "text": "The birds stop mid-wing. You reach the van.",
  "end": 342.64
 },
 {
  "i": 122,
  "start": 342.64,
  "speechStart": 342.76,
  "speechEnd": 346.0,
  "text": "Star Platinum puts both hands on the bonnet and turns it toward a hedge.",
  "end": 346.62
 },
 {
  "i": 123,
  "start": 346.62,
  "speechStart": 346.74,
  "speechEnd": 350.44,
  "text": "You step back. Your lungs burn. That's all you get:",
  "end": 351.0
 },
 {
  "i": 124,
  "start": 351.0,
  "speechStart": 351.12,
  "speechEnd": 353.54,
  "text": "one breath. And the world starts again.",
  "end": 354.12
 },
 {
  "i": 125,
  "start": 354.12,
  "speechStart": 354.24,
  "speechEnd": 357.46,
  "text": "The van hits the hedge at walking speed. Nobody is hurt.",
  "end": 358.36
 },
 {
  "i": 126,
  "start": 358.36,
  "speechStart": 358.48,
  "speechEnd": 361.78,
  "text": "The lollipop lady blinks at you, and keeps holding her sign.",
  "end": 363.02
 },
 {
  "i": 127,
  "start": 363.02,
  "speechStart": 363.14,
  "speechEnd": 365.44,
  "text": "The next morning you can't lift your hands,",
  "end": 366.02
 },
 {
  "i": 128,
  "start": 366.02,
  "speechStart": 366.14,
  "speechEnd": 368.04,
  "text": "and they don't stop shaking until lunch.",
  "end": 369.02
 },
 {
  "i": 129,
  "start": 369.02,
  "speechStart": 369.14,
  "speechEnd": 372.66,
  "text": "Now you know what it really is. Not a superpower.",
  "end": 373.44
 },
 {
  "i": 130,
  "start": 373.44,
  "speechStart": 373.56,
  "speechEnd": 377.64,
  "text": "A second body that never gets tired, attached to one that does.",
  "end": 378.88
 },
 {
  "i": 131,
  "start": 378.88,
  "speechStart": 379.0,
  "speechEnd": 380.2,
  "text": "Lesson nine:",
  "end": 380.08
 },
 {
  "i": 132,
  "start": 380.08,
  "speechStart": 380.2,
  "speechEnd": 382.54,
  "text": "the strongest thing about you is still",
  "end": 382.42
 },
 {
  "i": 133,
  "start": 382.42,
  "speechStart": 382.54,
  "speechEnd": 384.62,
  "text": "the most tired thing about you.",
  "end": 385.28
 },
 {
  "i": 134,
  "start": 385.28,
  "speechStart": 385.4,
  "speechEnd": 388.02,
  "text": "The next morning, seven twelve.",
  "end": 387.9
 },
 {
  "i": 135,
  "start": 387.9,
  "speechStart": 388.02,
  "speechEnd": 390.0,
  "text": "A glass slides off your nightstand.",
  "end": 389.88
 },
 {
  "i": 136,
  "start": 389.88,
  "speechStart": 390.0,
  "speechEnd": 393.08,
  "text": "This time you reach first. You miss.",
  "end": 393.66
 },
 {
  "i": 137,
  "start": 393.66,
  "speechStart": 393.78,
  "speechEnd": 396.36,
  "text": "And something catches it anyway.",
  "end": 397.14
 },
 {
  "i": 138,
  "start": 397.14,
  "speechStart": 397.26,
  "speechEnd": 399.52,
  "text": "So if you woke up tomorrow with Star Platinum,",
  "end": 400.08
 },
 {
  "i": 139,
  "start": 400.08,
  "speechStart": 400.2,
  "speechEnd": 402.1,
  "text": "would you keep it, or give it back?",
  "end": 402.96
 },
 {
  "i": 140,
  "start": 402.96,
  "speechStart": 403.08,
  "speechEnd": 406.14,
  "text": "And what's the first thing you'd catch? Tell me in the comments.",
  "end": 407.74
 }
]