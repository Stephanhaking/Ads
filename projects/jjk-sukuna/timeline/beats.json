[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 3.66,
  "text": "You've woken up as Ryomen Sukuna, the King of Curses.",
  "end": 4.18
 },
 {
  "i": 1,
  "start": 4.18,
  "speechStart": 4.3,
  "speechEnd": 6.86,
  "text": "In real life. You have seven days.",
  "end": 7.34
 },
 {
  "i": 2,
  "start": 7.34,
  "speechStart": 7.46,
  "speechEnd": 9.96,
  "text": "At the end of the seventh, nobody in range survives.",
  "end": 10.8
 },
 {
  "i": 3,
  "start": 10.8,
  "speechStart": 10.92,
  "speechEnd": 13.46,
  "text": "In the story, Sukuna was a human sorcerer,",
  "end": 13.64
 },
 {
  "i": 4,
  "start": 13.64,
  "speechStart": 13.76,
  "speechEnd": 16.74,
  "text": "so feared in the Heian era that nobody could stop him.",
  "end": 17.14
 },
 {
  "i": 5,
  "start": 17.14,
  "speechStart": 17.26,
  "speechEnd": 19.14,
  "text": "In your version, you didn't eat a finger.",
  "end": 19.56
 },
 {
  "i": 6,
  "start": 19.56,
  "speechStart": 19.68,
  "speechEnd": 22.16,
  "text": "You woke up with all of it, and a clock.",
  "end": 22.92
 },
 {
  "i": 7,
  "start": 22.92,
  "speechStart": 23.04,
  "speechEnd": 24.56,
  "text": "At midnight on day seven,",
  "end": 24.72
 },
 {
  "i": 8,
  "start": 24.72,
  "speechStart": 24.84,
  "speechEnd": 27.3,
  "text": "the biggest thing he can do opens on its own.",
  "end": 27.18
 },
 {
  "i": 9,
  "start": 27.18,
  "speechStart": 27.3,
  "speechEnd": 29.94,
  "text": "It will not ask who is standing nearby.",
  "end": 30.82
 },
 {
  "i": 10,
  "start": 30.82,
  "speechStart": 30.94,
  "speechEnd": 32.18,
  "text": "But first, it's Monday.",
  "end": 32.72
 },
 {
  "i": 11,
  "start": 32.72,
  "speechStart": 32.84,
  "speechEnd": 35.14,
  "text": "You're hungry, and there's a loaf of bread on the counter.",
  "end": 36.62
 },
 {
  "i": 12,
  "start": 36.62,
  "speechStart": 36.74,
  "speechEnd": 38.54,
  "text": "His technique has two parts.",
  "end": 39.22
 },
 {
  "i": 13,
  "start": 39.22,
  "speechStart": 39.34,
  "speechEnd": 42.88,
  "text": "Dismantle cuts from a distance. Cleave cuts what it touches.",
  "end": 43.74
 },
 {
  "i": 14,
  "start": 43.74,
  "speechStart": 43.86,
  "speechEnd": 46.86,
  "text": "How hard Dismantle hits depends on how much power you put in.",
  "end": 47.5
 },
 {
  "i": 15,
  "start": 47.5,
  "speechStart": 47.62,
  "speechEnd": 50.82,
  "text": "You point two fingers at the bread and think: cut.",
  "end": 50.7
 },
 {
  "i": 16,
  "start": 50.7,
  "speechStart": 50.82,
  "speechEnd": 53.9,
  "text": "Eleven slices. Thin as paper.",
  "end": 54.7
 },
 {
  "i": 17,
  "start": 54.7,
  "speechStart": 54.82,
  "speechEnd": 56.5,
  "text": "And a clean line through the bag,",
  "end": 56.64
 },
 {
  "i": 18,
  "start": 56.64,
  "speechStart": 56.76,
  "speechEnd": 58.5,
  "text": "the counter and the wall behind it.",
  "end": 59.0
 },
 {
  "i": 19,
  "start": 59.0,
  "speechStart": 59.12,
  "speechEnd": 60.84,
  "text": "Mara, your roommate, walks in with her coffee.",
  "end": 61.46
 },
 {
  "i": 20,
  "start": 61.46,
  "speechStart": 61.58,
  "speechEnd": 64.68,
  "text": "\"Did you just cut the wall?\" \"It was already like that.\"",
  "end": 65.14
 },
 {
  "i": 21,
  "start": 65.14,
  "speechStart": 65.26,
  "speechEnd": 67.18,
  "text": "\"It was not already like that.\"",
  "end": 67.82
 },
 {
  "i": 22,
  "start": 67.82,
  "speechStart": 67.94,
  "speechEnd": 70.88,
  "text": "In your version, there's one dial, and it's stuck on loud.",
  "end": 71.48
 },
 {
  "i": 23,
  "start": 71.48,
  "speechStart": 71.6,
  "speechEnd": 72.6,
  "text": "You can't turn it down yet.",
  "end": 72.48
 },
 {
  "i": 24,
  "start": 72.48,
  "speechStart": 72.6,
  "speechEnd": 75.16,
  "text": "Then you see your face in the bathroom mirror.",
  "end": 75.74
 },
 {
  "i": 25,
  "start": 75.74,
  "speechStart": 75.86,
  "speechEnd": 78.1,
  "text": "There are dark marks on it that weren't there last night.",
  "end": 78.98
 },
 {
  "i": 26,
  "start": 78.98,
  "speechStart": 79.1,
  "speechEnd": 81.56,
  "text": "The marks are the first sign that your body is changing.",
  "end": 82.36
 },
 {
  "i": 27,
  "start": 82.36,
  "speechStart": 82.48,
  "speechEnd": 84.26,
  "text": "They'll come back every morning, a little deeper.",
  "end": 84.82
 },
 {
  "i": 28,
  "start": 84.82,
  "speechStart": 84.94,
  "speechEnd": 88.08,
  "text": "And a voice, not loud at all, says: \"Good.",
  "end": 88.68
 },
 {
  "i": 29,
  "start": 88.68,
  "speechStart": 88.8,
  "speechEnd": 89.62,
  "text": "Now the neighbour's dog.\"",
  "end": 90.32
 },
 {
  "i": 30,
  "start": 90.32,
  "speechStart": 90.44,
  "speechEnd": 91.72,
  "text": "You say no out loud.",
  "end": 92.26
 },
 {
  "i": 31,
  "start": 92.26,
  "speechStart": 92.38,
  "speechEnd": 93.84,
  "text": "Mara asks who you're talking to.",
  "end": 94.34
 },
 {
  "i": 32,
  "start": 94.34,
  "speechStart": 94.46,
  "speechEnd": 97.18,
  "text": "In the story, Sukuna is described as sadistic,",
  "end": 97.2
 },
 {
  "i": 33,
  "start": 97.2,
  "speechStart": 97.32,
  "speechEnd": 98.58,
  "text": "selfish and hedonistic.",
  "end": 99.28
 },
 {
  "i": 34,
  "start": 99.28,
  "speechStart": 99.4,
  "speechEnd": 103.2,
  "text": "In your version, that personality doesn't take over. It suggests.",
  "end": 103.08
 },
 {
  "i": 35,
  "start": 103.08,
  "speechStart": 103.2,
  "speechEnd": 107.12,
  "text": "Seven days of suggestions. Six days left.",
  "end": 108.3
 },
 {
  "i": 36,
  "start": 108.3,
  "speechStart": 108.42,
  "speechEnd": 109.78,
  "text": "Cleave needs contact,",
  "end": 110.3
 },
 {
  "i": 37,
  "start": 110.3,
  "speechStart": 110.42,
  "speechEnd": 113.06,
  "text": "and it adjusts itself to how tough the target is.",
  "end": 113.54
 },
 {
  "i": 38,
  "start": 113.54,
  "speechStart": 113.66,
  "speechEnd": 116.86,
  "text": "It doesn't ask how strong the thing is. It just opens it.",
  "end": 117.7
 },
 {
  "i": 39,
  "start": 117.7,
  "speechStart": 117.82,
  "speechEnd": 120.42,
  "text": "Mara's bike lock is steel. She's proud of it.",
  "end": 120.94
 },
 {
  "i": 40,
  "start": 120.94,
  "speechStart": 121.06,
  "speechEnd": 122.58,
  "text": "You close your hand around the chain.",
  "end": 123.16
 },
 {
  "i": 41,
  "start": 123.16,
  "speechStart": 123.28,
  "speechEnd": 124.56,
  "text": "It parts like licorice.",
  "end": 125.54
 },
 {
  "i": 42,
  "start": 125.54,
  "speechStart": 125.66,
  "speechEnd": 129.02,
  "text": "\"That was a ninety-dollar lock.\" \"It was a bad lock.\"",
  "end": 129.54
 },
 {
  "i": 43,
  "start": 129.54,
  "speechStart": 129.66,
  "speechEnd": 132.28,
  "text": "\"It was a good lock. You're a bad roommate.\"",
  "end": 133.16
 },
 {
  "i": 44,
  "start": 133.16,
  "speechStart": 133.28,
  "speechEnd": 135.3,
  "text": "In your version, touch is a choice.",
  "end": 135.18
 },
 {
  "i": 45,
  "start": 135.18,
  "speechStart": 135.3,
  "speechEnd": 138.86,
  "text": "That's the rule you've been counting on. At the crosswalk,",
  "end": 139.12
 },
 {
  "i": 46,
  "start": 139.12,
  "speechStart": 139.24,
  "speechEnd": 142.32,
  "text": "a stranger grabs your sleeve to stop you stepping in front of a bus.",
  "end": 142.84
 },
 {
  "i": 47,
  "start": 142.84,
  "speechStart": 142.96,
  "speechEnd": 143.58,
  "text": "A kind man.",
  "end": 144.22
 },
 {
  "i": 48,
  "start": 144.22,
  "speechStart": 144.34,
  "speechEnd": 147.7,
  "text": "Your hand moves before you do. You pull away, fast.",
  "end": 148.52
 },
 {
  "i": 49,
  "start": 148.52,
  "speechStart": 148.64,
  "speechEnd": 152.14,
  "text": "There's a clean line down his jacket from the elbow to the wrist.",
  "end": 152.54
 },
 {
  "i": 50,
  "start": 152.54,
  "speechStart": 152.66,
  "speechEnd": 154.9,
  "text": "He thinks it tore. He thanks you anyway.",
  "end": 155.96
 },
 {
  "i": 51,
  "start": 155.96,
  "speechStart": 156.08,
  "speechEnd": 157.42,
  "text": "Lesson two:",
  "end": 157.3
 },
 {
  "i": 52,
  "start": 157.3,
  "speechStart": 157.42,
  "speechEnd": 160.3,
  "text": "kindness is the most dangerous thing that can happen to you now.",
  "end": 161.04
 },
 {
  "i": 53,
  "start": 161.04,
  "speechStart": 161.16,
  "speechEnd": 161.96,
  "text": "Five days left.",
  "end": 162.74
 },
 {
  "i": 54,
  "start": 162.74,
  "speechStart": 162.86,
  "speechEnd": 164.6,
  "text": "You cut your own palm",
  "end": 164.48
 },
 {
  "i": 55,
  "start": 164.48,
  "speechStart": 164.6,
  "speechEnd": 166.58,
  "text": "with Dismantle by accident,",
  "end": 166.46
 },
 {
  "i": 56,
  "start": 166.46,
  "speechStart": 166.58,
  "speechEnd": 169.28,
  "text": "and watch it close in under three seconds.",
  "end": 169.82
 },
 {
  "i": 57,
  "start": 169.82,
  "speechStart": 169.94,
  "speechEnd": 172.32,
  "text": "Sukuna can use Reverse Cursed Technique to heal.",
  "end": 173.08
 },
 {
  "i": 58,
  "start": 173.08,
  "speechStart": 173.2,
  "speechEnd": 176.38,
  "text": "Almost nobody in the story can. Mara stares.",
  "end": 176.98
 },
 {
  "i": 59,
  "start": 176.98,
  "speechStart": 177.1,
  "speechEnd": 177.62,
  "text": "\"Does it hurt?\"",
  "end": 178.4
 },
 {
  "i": 60,
  "start": 178.4,
  "speechStart": 178.52,
  "speechEnd": 180.92,
  "text": "\"Not anymore.\" In your version,",
  "end": 181.1
 },
 {
  "i": 61,
  "start": 181.1,
  "speechStart": 181.22,
  "speechEnd": 184.92,
  "text": "every heal takes the sleep you would have had. It isn't free.",
  "end": 185.0
 },
 {
  "i": 62,
  "start": 185.0,
  "speechStart": 185.12,
  "speechEnd": 185.76,
  "text": "It's borrowed.",
  "end": 186.5
 },
 {
  "i": 63,
  "start": 186.5,
  "speechStart": 186.62,
  "speechEnd": 189.98,
  "text": "By Wednesday night you haven't slept in two days, and you aren't tired.",
  "end": 190.34
 },
 {
  "i": 64,
  "start": 190.34,
  "speechStart": 190.46,
  "speechEnd": 193.82,
  "text": "Our guess is that a human brain can't run this long without rest.",
  "end": 194.38
 },
 {
  "i": 65,
  "start": 194.38,
  "speechStart": 194.5,
  "speechEnd": 196.5,
  "text": "The voice gets louder when you're tired.",
  "end": 196.8
 },
 {
  "i": 66,
  "start": 196.8,
  "speechStart": 196.92,
  "speechEnd": 198.18,
  "text": "That's a guess, not a fact.",
  "end": 198.68
 },
 {
  "i": 67,
  "start": 198.68,
  "speechStart": 198.8,
  "speechEnd": 200.86,
  "text": "\"Your friend is afraid,\" the voice says.",
  "end": 201.3
 },
 {
  "i": 68,
  "start": 201.3,
  "speechStart": 201.42,
  "speechEnd": 202.96,
  "text": "\"Fear is a form of respect.\"",
  "end": 203.72
 },
 {
  "i": 69,
  "start": 203.72,
  "speechStart": 203.84,
  "speechEnd": 206.48,
  "text": "You turn the light off and leave it off. You don't need it.",
  "end": 206.72
 },
 {
  "i": 70,
  "start": 206.72,
  "speechStart": 206.84,
  "speechEnd": 209.66,
  "text": "Across the hall, the neighbour's dog barks at your door all night.",
  "end": 210.1
 },
 {
  "i": 71,
  "start": 210.1,
  "speechStart": 210.22,
  "speechEnd": 211.58,
  "text": "The voice hums along with it.",
  "end": 212.0
 },
 {
  "i": 72,
  "start": 212.0,
  "speechStart": 212.12,
  "speechEnd": 215.44,
  "text": "At three a.m., you find yourself standing in front of that door,",
  "end": 215.52
 },
 {
  "i": 73,
  "start": 215.52,
  "speechStart": 215.64,
  "speechEnd": 218.6,
  "text": "with two fingers raised and no memory of crossing the floor.",
  "end": 219.18
 },
 {
  "i": 74,
  "start": 219.18,
  "speechStart": 219.3,
  "speechEnd": 221.3,
  "text": "You go back to bed. You do not sleep.",
  "end": 221.88
 },
 {
  "i": 75,
  "start": 221.88,
  "speechStart": 222.0,
  "speechEnd": 223.52,
  "text": "You lie there and promise yourself:",
  "end": 223.4
 },
 {
  "i": 76,
  "start": 223.4,
  "speechStart": 223.52,
  "speechEnd": 226.38,
  "text": "tomorrow, we write down every rule.",
  "end": 227.48
 },
 {
  "i": 77,
  "start": 227.48,
  "speechStart": 227.6,
  "speechEnd": 231.1,
  "text": "Mara writes them on the fridge. Rule one: no touching people.",
  "end": 231.54
 },
 {
  "i": 78,
  "start": 231.54,
  "speechStart": 231.66,
  "speechEnd": 234.52,
  "text": "Rule two: no touching animals. Rule three:",
  "end": 234.84
 },
 {
  "i": 79,
  "start": 234.84,
  "speechStart": 234.96,
  "speechEnd": 238.54,
  "text": "if you start smiling, you say so out loud. It's a good list.",
  "end": 239.08
 },
 {
  "i": 80,
  "start": 239.08,
  "speechStart": 239.2,
  "speechEnd": 241.16,
  "text": "It won't be enough. Four days left.",
  "end": 242.0
 },
 {
  "i": 81,
  "start": 242.0,
  "speechStart": 242.12,
  "speechEnd": 243.66,
  "text": "Mara makes you promise:",
  "end": 244.24
 },
 {
  "i": 82,
  "start": 244.24,
  "speechStart": 244.36,
  "speechEnd": 246.32,
  "text": "if you test the next one, she's there.",
  "end": 246.92
 },
 {
  "i": 83,
  "start": 246.92,
  "speechStart": 247.04,
  "speechEnd": 248.7,
  "text": "The fire technique, Fuga,",
  "end": 249.06
 },
 {
  "i": 84,
  "start": 249.06,
  "speechStart": 249.18,
  "speechEnd": 252.76,
  "text": "only works after Dismantle and Cleave. You have to say \"Open.\"",
  "end": 253.3
 },
 {
  "i": 85,
  "start": 253.3,
  "speechStart": 253.42,
  "speechEnd": 256.24,
  "text": "So you cut a concrete post. Then you touch it.",
  "end": 256.58
 },
 {
  "i": 86,
  "start": 256.58,
  "speechStart": 256.7,
  "speechEnd": 257.46,
  "text": "Then you say the word.",
  "end": 258.14
 },
 {
  "i": 87,
  "start": 258.14,
  "speechStart": 258.26,
  "speechEnd": 260.66,
  "text": "An arrow of fire crosses the empty lot,",
  "end": 260.54
 },
 {
  "i": 88,
  "start": 260.54,
  "speechStart": 260.66,
  "speechEnd": 265.06,
  "text": "a hundred meters, and takes a dumpster with it. Mara's eyebrows are fine.",
  "end": 265.54
 },
 {
  "i": 89,
  "start": 265.54,
  "speechStart": 265.66,
  "speechEnd": 268.8,
  "text": "Mostly. She says, very quietly: \"You laughed.\"",
  "end": 268.68
 },
 {
  "i": 90,
  "start": 268.68,
  "speechStart": 268.8,
  "speechEnd": 270.22,
  "text": "You hadn't noticed.",
  "end": 270.9
 },
 {
  "i": 91,
  "start": 270.9,
  "speechStart": 271.02,
  "speechEnd": 273.86,
  "text": "In your version, that's the line the marks cross on Thursday.",
  "end": 274.4
 },
 {
  "i": 92,
  "start": 274.4,
  "speechStart": 274.52,
  "speechEnd": 276.76,
  "text": "They reach your jaw. The voice says:",
  "end": 277.32
 },
 {
  "i": 93,
  "start": 277.32,
  "speechStart": 277.44,
  "speechEnd": 279.68,
  "text": "\"Now you understand why I never needed anyone.\"",
  "end": 280.36
 },
 {
  "i": 94,
  "start": 280.36,
  "speechStart": 280.48,
  "speechEnd": 282.98,
  "text": "In the story, Sukuna fights for the sake of the fight.",
  "end": 283.44
 },
 {
  "i": 95,
  "start": 283.44,
  "speechStart": 283.56,
  "speechEnd": 285.68,
  "text": "Power isn't a tool to him. It's the point.",
  "end": 286.36
 },
 {
  "i": 96,
  "start": 286.36,
  "speechStart": 286.48,
  "speechEnd": 289.5,
  "text": "In your version, that's the temptation. Not the strength.",
  "end": 290.04
 },
 {
  "i": 97,
  "start": 290.04,
  "speechStart": 290.16,
  "speechEnd": 293.88,
  "text": "The relief of not needing anybody. You walk home in silence.",
  "end": 294.58
 },
 {
  "i": 98,
  "start": 294.58,
  "speechStart": 294.7,
  "speechEnd": 296.12,
  "text": "Mara walks half a step behind you,",
  "end": 296.0
 },
 {
  "i": 99,
  "start": 296.0,
  "speechStart": 296.12,
  "speechEnd": 299.94,
  "text": "the way people walk near a dog they aren't sure about. Three days left.",
  "end": 301.48
 },
 {
  "i": 100,
  "start": 301.48,
  "speechStart": 301.6,
  "speechEnd": 303.82,
  "text": "A man shoves Mara at the bus stop,",
  "end": 303.98
 },
 {
  "i": 101,
  "start": 303.98,
  "speechStart": 304.1,
  "speechEnd": 305.52,
  "text": "grabs her phone and laughs.",
  "end": 306.78
 },
 {
  "i": 102,
  "start": 306.78,
  "speechStart": 306.9,
  "speechEnd": 310.48,
  "text": "\"Finish him,\" the voice says. Calm. Almost kind.",
  "end": 311.78
 },
 {
  "i": 103,
  "start": 311.78,
  "speechStart": 311.9,
  "speechEnd": 315.2,
  "text": "Your hand is up before you decide. Two fingers.",
  "end": 315.66
 },
 {
  "i": 104,
  "start": 315.66,
  "speechStart": 315.78,
  "speechEnd": 319.4,
  "text": "A clean line already in the air. You don't throw it.",
  "end": 319.8
 },
 {
  "i": 105,
  "start": 319.8,
  "speechStart": 319.92,
  "speechEnd": 323.7,
  "text": "You throw yourself in front of the street lamp instead. The lamp falls.",
  "end": 324.28
 },
 {
  "i": 106,
  "start": 324.28,
  "speechStart": 324.4,
  "speechEnd": 324.94,
  "text": "Everybody runs.",
  "end": 325.48
 },
 {
  "i": 107,
  "start": 325.48,
  "speechStart": 325.6,
  "speechEnd": 329.16,
  "text": "The man drops her phone and keeps running. Nobody is hurt.",
  "end": 330.28
 },
 {
  "i": 108,
  "start": 330.28,
  "speechStart": 330.4,
  "speechEnd": 332.88,
  "text": "Mara is shaking. \"I saw your face.",
  "end": 333.32
 },
 {
  "i": 109,
  "start": 333.32,
  "speechStart": 333.44,
  "speechEnd": 334.8,
  "text": "For a second you looked happy.\"",
  "end": 335.38
 },
 {
  "i": 110,
  "start": 335.38,
  "speechStart": 335.5,
  "speechEnd": 338.62,
  "text": "In your version, that's the real cost. Not the power.",
  "end": 338.96
 },
 {
  "i": 111,
  "start": 338.96,
  "speechStart": 339.08,
  "speechEnd": 339.9,
  "text": "What it makes easy.",
  "end": 340.5
 },
 {
  "i": 112,
  "start": 340.5,
  "speechStart": 340.62,
  "speechEnd": 342.38,
  "text": "That night she doesn't go to her sister's.",
  "end": 342.8
 },
 {
  "i": 113,
  "start": 342.8,
  "speechStart": 342.92,
  "speechEnd": 346.12,
  "text": "She sits on the kitchen floor and says: \"Tell me what happens on Sunday.\"",
  "end": 346.68
 },
 {
  "i": 114,
  "start": 346.68,
  "speechStart": 346.8,
  "speechEnd": 347.88,
  "text": "You almost don't tell her.",
  "end": 348.22
 },
 {
  "i": 115,
  "start": 348.22,
  "speechStart": 348.34,
  "speechEnd": 349.74,
  "text": "The voice says there's no reason to.",
  "end": 350.58
 },
 {
  "i": 116,
  "start": 350.58,
  "speechStart": 350.7,
  "speechEnd": 354.56,
  "text": "Then you look at the list on the fridge. Rule three is still there. You say:",
  "end": 355.16
 },
 {
  "i": 117,
  "start": 355.16,
  "speechStart": 355.28,
  "speechEnd": 358.7,
  "text": "\"I'm smiling right now, aren't I?\" \"Yes,\" she says.",
  "end": 359.96
 },
 {
  "i": 118,
  "start": 359.96,
  "speechStart": 360.08,
  "speechEnd": 361.86,
  "text": "\"Tell me anyway.\" Two days left.",
  "end": 362.88
 },
 {
  "i": 119,
  "start": 362.88,
  "speechStart": 363.0,
  "speechEnd": 364.36,
  "text": "You tell her the truth.",
  "end": 364.86
 },
 {
  "i": 120,
  "start": 364.86,
  "speechStart": 364.98,
  "speechEnd": 367.16,
  "text": "The Malevolent Shrine has no barrier.",
  "end": 367.48
 },
 {
  "i": 121,
  "start": 367.48,
  "speechStart": 367.6,
  "speechEnd": 369.44,
  "text": "It doesn't close a wall around anyone.",
  "end": 370.04
 },
 {
  "i": 122,
  "start": 370.04,
  "speechStart": 370.16,
  "speechEnd": 371.96,
  "text": "It cuts everything in range,",
  "end": 372.7
 },
 {
  "i": 123,
  "start": 372.7,
  "speechStart": 372.82,
  "speechEnd": 375.98,
  "text": "Cleave on anything with energy, Dismantle on everything else.",
  "end": 376.76
 },
 {
  "i": 124,
  "start": 376.76,
  "speechStart": 376.88,
  "speechEnd": 380.34,
  "text": "The wiki says its reach can stretch to about two hundred meters,",
  "end": 380.22
 },
 {
  "i": 125,
  "start": 380.22,
  "speechStart": 380.34,
  "speechEnd": 381.75,
  "text": "using a Binding Vow.",
  "end": 381.58
 },
 {
  "i": 126,
  "start": 381.58,
  "speechStart": 381.7,
  "speechEnd": 383.38,
  "text": "In your version,",
  "end": 383.68
 },
 {
  "i": 127,
  "start": 383.68,
  "speechStart": 383.8,
  "speechEnd": 387.76,
  "text": "it opens by itself at midnight on Sunday. You can't stop it.",
  "end": 388.04
 },
 {
  "i": 128,
  "start": 388.04,
  "speechStart": 388.16,
  "speechEnd": 389.28,
  "text": "You can only choose where.",
  "end": 390.02
 },
 {
  "i": 129,
  "start": 390.02,
  "speechStart": 390.14,
  "speechEnd": 392.24,
  "text": "You need three hundred meters of nothing.",
  "end": 393.02
 },
 {
  "i": 130,
  "start": 393.02,
  "speechStart": 393.14,
  "speechEnd": 395.56,
  "text": "You find a quarry, four kilometers out of town,",
  "end": 395.84
 },
 {
  "i": 131,
  "start": 395.84,
  "speechStart": 395.96,
  "speechEnd": 400.26,
  "text": "no houses, no road, one gate. Mara reads the map.",
  "end": 400.76
 },
 {
  "i": 132,
  "start": 400.76,
  "speechStart": 400.88,
  "speechEnd": 403.32,
  "text": "\"You're going alone.\" \"That's the plan.\"",
  "end": 403.92
 },
 {
  "i": 133,
  "start": 403.92,
  "speechStart": 404.04,
  "speechEnd": 405.14,
  "text": "\"That's a terrible plan.\"",
  "end": 405.18
 },
 {
  "i": 134,
  "start": 405.18,
  "speechStart": 405.3,
  "speechEnd": 409.06,
  "text": "You think about calling someone. The police. A doctor.",
  "end": 409.42
 },
 {
  "i": 135,
  "start": 409.42,
  "speechStart": 409.54,
  "speechEnd": 411.5,
  "text": "A priest. And saying what?",
  "end": 412.04
 },
 {
  "i": 136,
  "start": 412.04,
  "speechStart": 412.16,
  "speechEnd": 414.02,
  "text": "\"A fictional king lives in my body,",
  "end": 413.9
 },
 {
  "i": 137,
  "start": 413.9,
  "speechStart": 414.02,
  "speechEnd": 415.94,
  "text": "and I need an empty field by midnight\"?",
  "end": 416.34
 },
 {
  "i": 138,
  "start": 416.34,
  "speechStart": 416.46,
  "speechEnd": 419.3,
  "text": "So you spend Saturday doing the only thing left.",
  "end": 419.88
 },
 {
  "i": 139,
  "start": 419.88,
  "speechStart": 420.0,
  "speechEnd": 421.98,
  "text": "You drive out to the quarry and practice.",
  "end": 422.64
 },
 {
  "i": 140,
  "start": 422.64,
  "speechStart": 422.76,
  "speechEnd": 424.62,
  "text": "You draw a circle in chalk on the gravel.",
  "end": 425.0
 },
 {
  "i": 141,
  "start": 425.0,
  "speechStart": 425.12,
  "speechEnd": 426.74,
  "text": "Then a smaller one inside it.",
  "end": 427.16
 },
 {
  "i": 142,
  "start": 427.16,
  "speechStart": 427.28,
  "speechEnd": 430.0,
  "text": "You stand at the center and try to feel the edge,",
  "end": 430.24
 },
 {
  "i": 143,
  "start": 430.24,
  "speechStart": 430.36,
  "speechEnd": 432.62,
  "text": "the way you feel the edge of a step in the dark.",
  "end": 433.08
 },
 {
  "i": 144,
  "start": 433.08,
  "speechStart": 433.2,
  "speechEnd": 435.44,
  "text": "Our guess is that learning where a power stops",
  "end": 435.32
 },
 {
  "i": 145,
  "start": 435.32,
  "speechStart": 435.44,
  "speechEnd": 439.24,
  "text": "is harder than learning how hard it hits. Nobody teaches that part.",
  "end": 439.66
 },
 {
  "i": 146,
  "start": 439.66,
  "speechStart": 439.78,
  "speechEnd": 442.6,
  "text": "By sunset you can hit the edge of the small circle,",
  "end": 443.44
 },
 {
  "i": 147,
  "start": 443.44,
  "speechStart": 443.56,
  "speechEnd": 447.2,
  "text": "twice out of five. Not three. Not four.",
  "end": 447.92
 },
 {
  "i": 148,
  "start": 447.92,
  "speechStart": 448.04,
  "speechEnd": 451.68,
  "text": "Twice out of five isn't enough. It's what you have. One day left.",
  "end": 451.56
 },
 {
  "i": 149,
  "start": 451.56,
  "speechStart": 451.68,
  "speechEnd": 453.92,
  "text": "Eleven forty p.m.",
  "end": 454.64
 },
 {
  "i": 150,
  "start": 454.64,
  "speechStart": 454.76,
  "speechEnd": 456.4,
  "text": "Your arms are covered in marks.",
  "end": 457.12
 },
 {
  "i": 151,
  "start": 457.12,
  "speechStart": 457.24,
  "speechEnd": 459.08,
  "text": "The voice has stopped suggesting.",
  "end": 459.36
 },
 {
  "i": 152,
  "start": 459.36,
  "speechStart": 459.48,
  "speechEnd": 461.5,
  "text": "It just talks now, like it's always lived there.",
  "end": 461.9
 },
 {
  "i": 153,
  "start": 461.9,
  "speechStart": 462.02,
  "speechEnd": 463.68,
  "text": "\"Let her stay,\" it says.",
  "end": 463.56
 },
 {
  "i": 154,
  "start": 463.56,
  "speechStart": 463.68,
  "speechEnd": 467.0,
  "text": "\"Loss teaches better than anything.\" You turn around.",
  "end": 467.84
 },
 {
  "i": 155,
  "start": 467.84,
  "speechStart": 467.96,
  "speechEnd": 468.8,
  "text": "Mara followed you.",
  "end": 469.32
 },
 {
  "i": 156,
  "start": 469.32,
  "speechStart": 469.44,
  "speechEnd": 471.74,
  "text": "She's standing a hundred and fifty meters behind,",
  "end": 471.62
 },
 {
  "i": 157,
  "start": 471.62,
  "speechStart": 471.74,
  "speechEnd": 474.9,
  "text": "at the gate, with a flashlight. Not far enough.",
  "end": 475.6
 },
 {
  "i": 158,
  "start": 475.6,
  "speechStart": 475.72,
  "speechEnd": 478.72,
  "text": "In Shibuya, Sukuna narrowed his Shrine to about one hundred",
  "end": 478.6
 },
 {
  "i": 159,
  "start": 478.6,
  "speechStart": 478.72,
  "speechEnd": 480.54,
  "text": "and forty meters to spare Megumi.",
  "end": 481.32
 },
 {
  "i": 160,
  "start": 481.32,
  "speechStart": 481.44,
  "speechEnd": 483.1,
  "text": "In your version, you can do the same.",
  "end": 483.66
 },
 {
  "i": 161,
  "start": 483.66,
  "speechStart": 483.78,
  "speechEnd": 485.14,
  "text": "But a vow isn't free.",
  "end": 485.68
 },
 {
  "i": 162,
  "start": 485.68,
  "speechStart": 485.8,
  "speechEnd": 489.22,
  "text": "You give up the thing you're narrowing for. You say it out loud:",
  "end": 489.44
 },
 {
  "i": 163,
  "start": 489.44,
  "speechStart": 489.56,
  "speechEnd": 492.98,
  "text": "the radius, the number and the price. You aren't paying with power.",
  "end": 493.42
 },
 {
  "i": 164,
  "start": 493.42,
  "speechStart": 493.54,
  "speechEnd": 495.78,
  "text": "You're paying with the King. All of him.",
  "end": 496.16
 },
 {
  "i": 165,
  "start": 496.16,
  "speechStart": 496.28,
  "speechEnd": 499.76,
  "text": "All the marks, all the voice, all the ease. Midnight.",
  "end": 500.52
 },
 {
  "i": 166,
  "start": 500.52,
  "speechStart": 500.64,
  "speechEnd": 503.92,
  "text": "It opens without a sound. Not a wall. Not a dome.",
  "end": 504.3
 },
 {
  "i": 167,
  "start": 504.3,
  "speechStart": 504.42,
  "speechEnd": 506.12,
  "text": "Just everything in range, cut.",
  "end": 506.54
 },
 {
  "i": 168,
  "start": 506.54,
  "speechStart": 506.66,
  "speechEnd": 509.8,
  "text": "The quarry wall, the crane, the old sign, the gravel.",
  "end": 510.5
 },
 {
  "i": 169,
  "start": 510.5,
  "speechStart": 510.62,
  "speechEnd": 513.26,
  "text": "Thousands of clean lines, then nothing.",
  "end": 513.14
 },
 {
  "i": 170,
  "start": 513.14,
  "speechStart": 513.26,
  "speechEnd": 514.8,
  "text": "Hundred and forty meters.",
  "end": 515.6
 },
 {
  "i": 171,
  "start": 515.6,
  "speechStart": 515.72,
  "speechEnd": 517.44,
  "text": "Not a hundred and fifty.",
  "end": 517.32
 },
 {
  "i": 172,
  "start": 517.32,
  "speechStart": 517.44,
  "speechEnd": 520.66,
  "text": "Mara is ten meters outside it. Her flashlight is still on.",
  "end": 521.34
 },
 {
  "i": 173,
  "start": 521.34,
  "speechStart": 521.46,
  "speechEnd": 525.36,
  "text": "The voice says one last thing, very small: \"Interesting.\"",
  "end": 525.98
 },
 {
  "i": 174,
  "start": 525.98,
  "speechStart": 526.1,
  "speechEnd": 528.6,
  "text": "Then it's gone. Seven days.",
  "end": 529.42
 },
 {
  "i": 175,
  "start": 529.42,
  "speechStart": 529.54,
  "speechEnd": 531.12,
  "text": "Nobody in range survived,",
  "end": 531.52
 },
 {
  "i": 176,
  "start": 531.52,
  "speechStart": 531.64,
  "speechEnd": 535.18,
  "text": "because there was no one in range. That was the whole plan.",
  "end": 535.88
 },
 {
  "i": 177,
  "start": 535.88,
  "speechStart": 536.0,
  "speechEnd": 537.06,
  "text": "You wake up as yourself.",
  "end": 537.72
 },
 {
  "i": 178,
  "start": 537.72,
  "speechStart": 537.84,
  "speechEnd": 539.84,
  "text": "You're lying on the quarry floor at dawn,",
  "end": 540.32
 },
 {
  "i": 179,
  "start": 540.32,
  "speechStart": 540.44,
  "speechEnd": 542.22,
  "text": "and Mara is sitting next to you,",
  "end": 542.34
 },
 {
  "i": 180,
  "start": 542.34,
  "speechStart": 542.46,
  "speechEnd": 545.46,
  "text": "holding her flashlight, which is finally out of battery.",
  "end": 545.88
 },
 {
  "i": 181,
  "start": 545.88,
  "speechStart": 546.0,
  "speechEnd": 549.82,
  "text": "\"You smiled for a second, at the end,\" she says. \"I know.\"",
  "end": 550.56
 },
 {
  "i": 182,
  "start": 550.56,
  "speechStart": 550.68,
  "speechEnd": 551.62,
  "text": "\"You can stop now.\"",
  "end": 552.18
 },
 {
  "i": 183,
  "start": 552.18,
  "speechStart": 552.3,
  "speechEnd": 554.76,
  "text": "You laugh, and it's your laugh again.",
  "end": 555.54
 },
 {
  "i": 184,
  "start": 555.54,
  "speechStart": 555.66,
  "speechEnd": 557.56,
  "text": "At home, the marks are gone.",
  "end": 558.1
 },
 {
  "i": 185,
  "start": 558.1,
  "speechStart": 558.22,
  "speechEnd": 559.44,
  "text": "The marks are gone.",
  "end": 560.16
 },
 {
  "i": 186,
  "start": 560.16,
  "speechStart": 560.28,
  "speechEnd": 562.2,
  "text": "The bread on the counter is a normal loaf,",
  "end": 562.64
 },
 {
  "i": 187,
  "start": 562.64,
  "speechStart": 562.76,
  "speechEnd": 564.62,
  "text": "and Mara has already burned a piece of it.",
  "end": 565.04
 },
 {
  "i": 188,
  "start": 565.04,
  "speechStart": 565.16,
  "speechEnd": 567.18,
  "text": "The wall still has its clean line.",
  "end": 567.8
 },
 {
  "i": 189,
  "start": 567.8,
  "speechStart": 567.92,
  "speechEnd": 569.38,
  "text": "The landlord still hasn't noticed.",
  "end": 570.06
 },
 {
  "i": 190,
  "start": 570.06,
  "speechStart": 570.18,
  "speechEnd": 572.82,
  "text": "In your version, that's what the title meant.",
  "end": 573.46
 },
 {
  "i": 191,
  "start": 573.46,
  "speechStart": 573.58,
  "speechEnd": 577.38,
  "text": "Nobody survives seven days as the King. Not even the King.",
  "end": 578.22
 },
 {
  "i": 192,
  "start": 578.22,
  "speechStart": 578.34,
  "speechEnd": 580.8,
  "text": "Would you have narrowed it? Tell me in the comments.",
  "end": 581.3
 },
 {
  "i": 193,
  "start": 581.3,
  "speechStart": 581.42,
  "speechEnd": 584.06,
  "text": "And if you want the next one, tell me who you want to become.",
  "end": 585.66
 }
]