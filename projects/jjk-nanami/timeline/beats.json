[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 3.14,
  "text": "You've woken up as Kento Nanami, from Jujutsu Kaisen.",
  "end": 3.86
 },
 {
  "i": 1,
  "start": 3.86,
  "speechStart": 3.98,
  "speechEnd": 6.44,
  "text": "In real life. You have one rule.",
  "end": 7.36
 },
 {
  "i": 2,
  "start": 7.36,
  "speechStart": 7.48,
  "speechEnd": 9.02,
  "text": "Clock out at five, or die.",
  "end": 10.16
 },
 {
  "i": 3,
  "start": 10.16,
  "speechStart": 10.28,
  "speechEnd": 13.22,
  "text": "In the story, he can find the weak point in almost anything,",
  "end": 13.62
 },
 {
  "i": 4,
  "start": 13.62,
  "speechStart": 13.74,
  "speechEnd": 14.9,
  "text": "at the seven-to-three line.",
  "end": 15.46
 },
 {
  "i": 5,
  "start": 15.46,
  "speechStart": 15.58,
  "speechEnd": 18.78,
  "text": "In your version, a curse has moved into your office building.",
  "end": 19.26
 },
 {
  "i": 6,
  "start": 19.26,
  "speechStart": 19.38,
  "speechEnd": 21.92,
  "text": "At exactly five p.m., the doors seal.",
  "end": 22.42
 },
 {
  "i": 7,
  "start": 22.42,
  "speechStart": 22.54,
  "speechEnd": 24.76,
  "text": "Anyone still inside doesn't leave.",
  "end": 25.32
 },
 {
  "i": 8,
  "start": 25.32,
  "speechStart": 25.44,
  "speechEnd": 28.34,
  "text": "It's eight fifty-two in the morning. Your tie is on.",
  "end": 28.72
 },
 {
  "i": 9,
  "start": 28.72,
  "speechStart": 28.84,
  "speechEnd": 30.08,
  "text": "You have eight hours.",
  "end": 31.7
 },
 {
  "i": 10,
  "start": 31.7,
  "speechStart": 31.82,
  "speechEnd": 33.92,
  "text": "The Ratio Technique splits",
  "end": 33.8
 },
 {
  "i": 11,
  "start": 33.8,
  "speechStart": 33.92,
  "speechEnd": 35.68,
  "text": "a target into ten parts.",
  "end": 36.12
 },
 {
  "i": 12,
  "start": 36.12,
  "speechStart": 36.24,
  "speechEnd": 39.26,
  "text": "A strike at the seven-three point creates a weak spot,",
  "end": 39.44
 },
 {
  "i": 13,
  "start": 39.44,
  "speechStart": 39.56,
  "speechEnd": 41.34,
  "text": "and the hit lands as a critical one.",
  "end": 41.86
 },
 {
  "i": 14,
  "start": 41.86,
  "speechStart": 41.98,
  "speechEnd": 43.6,
  "text": "The elevator doors are in front of you.",
  "end": 43.92
 },
 {
  "i": 15,
  "start": 43.92,
  "speechStart": 44.04,
  "speechEnd": 46.9,
  "text": "You look at them, and a thin gold line appears,",
  "end": 47.22
 },
 {
  "i": 16,
  "start": 47.22,
  "speechStart": 47.34,
  "speechEnd": 50.24,
  "text": "three tenths from the top. You tap it with a knuckle.",
  "end": 50.86
 },
 {
  "i": 17,
  "start": 50.86,
  "speechStart": 50.98,
  "speechEnd": 52.78,
  "text": "The whole door sighs,",
  "end": 52.8
 },
 {
  "i": 18,
  "start": 52.8,
  "speechStart": 52.92,
  "speechEnd": 55.58,
  "text": "and the lock pops open as if it had been waiting.",
  "end": 56.16
 },
 {
  "i": 19,
  "start": 56.16,
  "speechStart": 56.28,
  "speechEnd": 58.04,
  "text": "In the coat closet by the entrance,",
  "end": 58.06
 },
 {
  "i": 20,
  "start": 58.06,
  "speechStart": 58.18,
  "speechEnd": 61.94,
  "text": "wrapped in newspaper, there's a long, heavy, dull blade.",
  "end": 62.46
 },
 {
  "i": 21,
  "start": 62.46,
  "speechStart": 62.58,
  "speechEnd": 64.7,
  "text": "In the story, his weapon is a blunt sword.",
  "end": 65.06
 },
 {
  "i": 22,
  "start": 65.06,
  "speechStart": 65.18,
  "speechEnd": 67.66,
  "text": "It can still cut weaker things, because of the technique.",
  "end": 68.3
 },
 {
  "i": 23,
  "start": 68.3,
  "speechStart": 68.42,
  "speechEnd": 69.52,
  "text": "You weigh it in one hand.",
  "end": 70.0
 },
 {
  "i": 24,
  "start": 70.0,
  "speechStart": 70.12,
  "speechEnd": 71.94,
  "text": "It feels like a very serious ruler.",
  "end": 72.74
 },
 {
  "i": 25,
  "start": 72.74,
  "speechStart": 72.86,
  "speechEnd": 75.92,
  "text": "In your version, you keep your own face and your own name tag.",
  "end": 76.24
 },
 {
  "i": 26,
  "start": 76.24,
  "speechStart": 76.36,
  "speechEnd": 79.48,
  "text": "Only the habits are his. The calm. The coat.",
  "end": 79.92
 },
 {
  "i": 27,
  "start": 79.92,
  "speechStart": 80.04,
  "speechEnd": 82.56,
  "text": "The way you check the time before you check anything else.",
  "end": 82.98
 },
 {
  "i": 28,
  "start": 82.98,
  "speechStart": 83.1,
  "speechEnd": 84.34,
  "text": "On the way to your floor,",
  "end": 84.54
 },
 {
  "i": 29,
  "start": 84.54,
  "speechStart": 84.66,
  "speechEnd": 87.26,
  "text": "you test it once more on the coffee machine in the lobby.",
  "end": 87.74
 },
 {
  "i": 30,
  "start": 87.74,
  "speechStart": 87.86,
  "speechEnd": 88.84,
  "text": "You tap the line.",
  "end": 89.2
 },
 {
  "i": 31,
  "start": 89.2,
  "speechStart": 89.32,
  "speechEnd": 91.44,
  "text": "The machine gives you a perfect espresso",
  "end": 91.8
 },
 {
  "i": 32,
  "start": 91.8,
  "speechStart": 91.92,
  "speechEnd": 95.82,
  "text": "and then, quietly, a second one, for free. Nobody sees.",
  "end": 96.28
 },
 {
  "i": 33,
  "start": 96.28,
  "speechStart": 96.4,
  "speechEnd": 97.1,
  "text": "Nobody ever sees.",
  "end": 97.52
 },
 {
  "i": 34,
  "start": 97.52,
  "speechStart": 97.64,
  "speechEnd": 99.04,
  "text": "That's the other thing about being him:",
  "end": 99.28
 },
 {
  "i": 35,
  "start": 99.28,
  "speechStart": 99.4,
  "speechEnd": 101.64,
  "text": "you become very good at being a man",
  "end": 101.52
 },
 {
  "i": 36,
  "start": 101.52,
  "speechStart": 101.64,
  "speechEnd": 103.74,
  "text": "in a suit that no one looks at twice.",
  "end": 104.34
 },
 {
  "i": 37,
  "start": 104.34,
  "speechStart": 104.46,
  "speechEnd": 107.68,
  "text": "At eight fifty-nine, you sit at your desk with a blade under it,",
  "end": 107.56
 },
 {
  "i": 38,
  "start": 107.56,
  "speechStart": 107.68,
  "speechEnd": 109.86,
  "text": "and a spreadsheet open on the screen.",
  "end": 111.42
 },
 {
  "i": 39,
  "start": 111.42,
  "speechStart": 111.54,
  "speechEnd": 114.18,
  "text": "Nanami's power is bound by a vow.",
  "end": 114.84
 },
 {
  "i": 40,
  "start": 114.84,
  "speechStart": 114.96,
  "speechEnd": 116.7,
  "text": "During working hours, it's limited.",
  "end": 117.34
 },
 {
  "i": 41,
  "start": 117.34,
  "speechStart": 117.46,
  "speechEnd": 118.96,
  "text": "After hours, it climbs.",
  "end": 120.34
 },
 {
  "i": 42,
  "start": 120.34,
  "speechStart": 120.46,
  "speechEnd": 123.18,
  "text": "In your version, until five p.m.,",
  "end": 123.06
 },
 {
  "i": 43,
  "start": 123.06,
  "speechStart": 123.18,
  "speechEnd": 127.34,
  "text": "you only get a working-hours version of the technique. Enough to see lines.",
  "end": 127.48
 },
 {
  "i": 44,
  "start": 127.48,
  "speechStart": 127.6,
  "speechEnd": 131.64,
  "text": "Not enough to win a fight. Your manager, Mr.",
  "end": 131.78
 },
 {
  "i": 45,
  "start": 131.78,
  "speechStart": 131.9,
  "speechEnd": 135.02,
  "text": "Hale, leans over your cubicle with a folder and a smile.",
  "end": 135.66
 },
 {
  "i": 46,
  "start": 135.66,
  "speechStart": 135.78,
  "speechEnd": 139.2,
  "text": "\"We'll need this report by six.\" \"I leave at five.\"",
  "end": 140.48
 },
 {
  "i": 47,
  "start": 140.48,
  "speechStart": 140.6,
  "speechEnd": 142.84,
  "text": "Everyone in the open office goes quiet.",
  "end": 143.38
 },
 {
  "i": 48,
  "start": 143.38,
  "speechStart": 143.5,
  "speechEnd": 144.76,
  "text": "Somebody drops a stapler.",
  "end": 145.52
 },
 {
  "i": 49,
  "start": 145.52,
  "speechStart": 145.64,
  "speechEnd": 147.96,
  "text": "\"Nobody leaves at five here,\" Mr.",
  "end": 148.02
 },
 {
  "i": 50,
  "start": 148.02,
  "speechStart": 148.14,
  "speechEnd": 150.3,
  "text": "Hale says, as if reading it off a plaque.",
  "end": 150.96
 },
 {
  "i": 51,
  "start": 150.96,
  "speechStart": 151.08,
  "speechEnd": 152.52,
  "text": "\"That's how we got the Henderson account.\"",
  "end": 153.8
 },
 {
  "i": 52,
  "start": 153.8,
  "speechStart": 153.92,
  "speechEnd": 155.44,
  "text": "\"That's how you lost four interns.\"",
  "end": 156.32
 },
 {
  "i": 53,
  "start": 156.32,
  "speechStart": 156.44,
  "speechEnd": 159.48,
  "text": "You don't mean to say it out loud. You say it out loud.",
  "end": 160.44
 },
 {
  "i": 54,
  "start": 160.44,
  "speechStart": 160.56,
  "speechEnd": 164.56,
  "text": "\"Everyone leaves at five,\" you add. \"I just mean it.\"",
  "end": 165.14
 },
 {
  "i": 55,
  "start": 165.14,
  "speechStart": 165.26,
  "speechEnd": 165.92,
  "text": "In the story,",
  "end": 166.16
 },
 {
  "i": 56,
  "start": 166.16,
  "speechStart": 166.28,
  "speechEnd": 169.22,
  "text": "Nanami left sorcery for an ordinary office job,",
  "end": 169.1
 },
 {
  "i": 57,
  "start": 169.1,
  "speechStart": 169.22,
  "speechEnd": 170.2,
  "text": "and came back later.",
  "end": 170.92
 },
 {
  "i": 58,
  "start": 170.92,
  "speechStart": 171.04,
  "speechEnd": 175.02,
  "text": "You never thought you'd understand why he did that. Now you do, a little.",
  "end": 175.96
 },
 {
  "i": 59,
  "start": 175.96,
  "speechStart": 176.08,
  "speechEnd": 178.24,
  "text": "Offices are a kind of curse too.",
  "end": 179.12
 },
 {
  "i": 60,
  "start": 179.12,
  "speechStart": 179.24,
  "speechEnd": 182.06,
  "text": "But the one in the stairwell isn't metaphorical.",
  "end": 182.76
 },
 {
  "i": 61,
  "start": 182.76,
  "speechStart": 182.88,
  "speechEnd": 185.72,
  "text": "You feel it at lunch. A slow,",
  "end": 185.6
 },
 {
  "i": 62,
  "start": 185.6,
  "speechStart": 185.72,
  "speechEnd": 189.16,
  "text": "wet pulse behind the fire door on the ninth floor.",
  "end": 189.52
 },
 {
  "i": 63,
  "start": 189.52,
  "speechStart": 189.64,
  "speechEnd": 192.66,
  "text": "Your technique shows you the building the way a doctor would.",
  "end": 193.2
 },
 {
  "i": 64,
  "start": 193.2,
  "speechStart": 193.32,
  "speechEnd": 196.2,
  "text": "Lines everywhere. Some are clean. Some are cracked.",
  "end": 196.72
 },
 {
  "i": 65,
  "start": 196.72,
  "speechStart": 196.84,
  "speechEnd": 199.86,
  "text": "This one is knotted. Like a throat.",
  "end": 200.58
 },
 {
  "i": 66,
  "start": 200.58,
  "speechStart": 200.7,
  "speechEnd": 203.98,
  "text": "In your version, it's a curse that feeds on exhaustion.",
  "end": 204.44
 },
 {
  "i": 67,
  "start": 204.44,
  "speechStart": 204.56,
  "speechEnd": 206.94,
  "text": "The longer people stay, the heavier it gets.",
  "end": 207.44
 },
 {
  "i": 68,
  "start": 207.44,
  "speechStart": 207.56,
  "speechEnd": 209.48,
  "text": "It sealed itself in the building last night,",
  "end": 209.76
 },
 {
  "i": 69,
  "start": 209.76,
  "speechStart": 209.88,
  "speechEnd": 213.52,
  "text": "and it wakes up every evening at five. You look at the office.",
  "end": 213.98
 },
 {
  "i": 70,
  "start": 213.98,
  "speechStart": 214.1,
  "speechEnd": 214.74,
  "text": "Forty people.",
  "end": 215.2
 },
 {
  "i": 71,
  "start": 215.2,
  "speechStart": 215.32,
  "speechEnd": 217.88,
  "text": "Half of them are asleep at their desks with their eyes open.",
  "end": 218.76
 },
 {
  "i": 72,
  "start": 218.76,
  "speechStart": 218.88,
  "speechEnd": 220.72,
  "text": "Priya, from accounting, catches you staring.",
  "end": 221.04
 },
 {
  "i": 73,
  "start": 221.04,
  "speechStart": 221.16,
  "speechEnd": 223.04,
  "text": "She has three monitors and a dead plant.",
  "end": 223.56
 },
 {
  "i": 74,
  "start": 223.56,
  "speechStart": 223.68,
  "speechEnd": 226.64,
  "text": "\"You look like you've seen a ghost.\" \"I've seen a deadline.\"",
  "end": 227.14
 },
 {
  "i": 75,
  "start": 227.14,
  "speechStart": 227.26,
  "speechEnd": 231.28,
  "text": "\"Well, it's mine. I'm staying until it's done.\" You tell her to leave at five.",
  "end": 231.58
 },
 {
  "i": 76,
  "start": 231.58,
  "speechStart": 231.7,
  "speechEnd": 235.62,
  "text": "She tells you to mind your own business. You both mean it. \"Are you okay?\"",
  "end": 235.9
 },
 {
  "i": 77,
  "start": 235.9,
  "speechStart": 236.02,
  "speechEnd": 236.38,
  "text": "she asks.",
  "end": 236.66
 },
 {
  "i": 78,
  "start": 236.66,
  "speechStart": 236.78,
  "speechEnd": 239.4,
  "text": "\"You've been looking at the walls all morning like you're measuring them.\"",
  "end": 239.92
 },
 {
  "i": 79,
  "start": 239.92,
  "speechStart": 240.04,
  "speechEnd": 243.68,
  "text": "\"Seven to three,\" you say. \"What?\" \"Nothing. It's a ratio.",
  "end": 243.56
 },
 {
  "i": 80,
  "start": 243.56,
  "speechStart": 243.68,
  "speechEnd": 244.6,
  "text": "It's a work thing.\"",
  "end": 245.24
 },
 {
  "i": 81,
  "start": 245.24,
  "speechStart": 245.36,
  "speechEnd": 246.98,
  "text": "She looks at you for a long second.",
  "end": 247.6
 },
 {
  "i": 82,
  "start": 247.6,
  "speechStart": 247.72,
  "speechEnd": 249.1,
  "text": "Then she goes back to her three monitors,",
  "end": 248.98
 },
 {
  "i": 83,
  "start": 248.98,
  "speechStart": 249.1,
  "speechEnd": 251.9,
  "text": "and you go back to counting the minutes.",
  "end": 252.98
 },
 {
  "i": 84,
  "start": 252.98,
  "speechStart": 253.1,
  "speechEnd": 256.28,
  "text": "You need a way out. For everyone. Fast.",
  "end": 257.22
 },
 {
  "i": 85,
  "start": 257.22,
  "speechStart": 257.34,
  "speechEnd": 260.14,
  "text": "There's a second part of his technique, called Collapse.",
  "end": 260.9
 },
 {
  "i": 86,
  "start": 260.9,
  "speechStart": 261.02,
  "speechEnd": 263.64,
  "text": "It applies the seven-three line to the environment itself:",
  "end": 263.98
 },
 {
  "i": 87,
  "start": 263.98,
  "speechStart": 264.1,
  "speechEnd": 265.0,
  "text": "a wall, a floor.",
  "end": 265.3
 },
 {
  "i": 88,
  "start": 265.3,
  "speechStart": 265.42,
  "speechEnd": 267.56,
  "text": "And the whole place crumbles from one strike.",
  "end": 268.42
 },
 {
  "i": 89,
  "start": 268.42,
  "speechStart": 268.54,
  "speechEnd": 272.68,
  "text": "You test it in the old file room, on a wall nobody will miss. A single tap.",
  "end": 272.56
 },
 {
  "i": 90,
  "start": 272.56,
  "speechStart": 272.68,
  "speechEnd": 275.22,
  "text": "The wall folds like wet paper.",
  "end": 275.92
 },
 {
  "i": 91,
  "start": 275.92,
  "speechStart": 276.04,
  "speechEnd": 280.46,
  "text": "The ceiling above it drops three inches and stops. Then a little more.",
  "end": 281.18
 },
 {
  "i": 92,
  "start": 281.18,
  "speechStart": 281.3,
  "speechEnd": 285.02,
  "text": "In your version, a wrong line doesn't open a door. It opens the floor.",
  "end": 284.9
 },
 {
  "i": 93,
  "start": 284.9,
  "speechStart": 285.02,
  "speechEnd": 287.22,
  "text": "And if you don't know where the line is,",
  "end": 287.66
 },
 {
  "i": 94,
  "start": 287.66,
  "speechStart": 287.78,
  "speechEnd": 291.72,
  "text": "the technique won't guess for you. Lesson one:",
  "end": 291.6
 },
 {
  "i": 95,
  "start": 291.6,
  "speechStart": 291.72,
  "speechEnd": 294.5,
  "text": "a weak point isn't a trick. It's a responsibility.",
  "end": 295.22
 },
 {
  "i": 96,
  "start": 295.22,
  "speechStart": 295.34,
  "speechEnd": 297.34,
  "text": "You mark the stairwell's glass wall with chalk,",
  "end": 297.22
 },
 {
  "i": 97,
  "start": 297.22,
  "speechStart": 297.34,
  "speechEnd": 299.62,
  "text": "seven-three, and go back to your desk.",
  "end": 300.14
 },
 {
  "i": 98,
  "start": 300.14,
  "speechStart": 300.26,
  "speechEnd": 301.9,
  "text": "It's three forty-one. Mr.",
  "end": 301.94
 },
 {
  "i": 99,
  "start": 301.94,
  "speechStart": 302.06,
  "speechEnd": 303.8,
  "text": "Hale wants to know why you're covered in dust.",
  "end": 304.82
 },
 {
  "i": 100,
  "start": 304.82,
  "speechStart": 304.94,
  "speechEnd": 307.8,
  "text": "At four forty, you pull the fire alarm.",
  "end": 308.32
 },
 {
  "i": 101,
  "start": 308.32,
  "speechStart": 308.44,
  "speechEnd": 311.38,
  "text": "It's the least cursed-energy thing you've ever done,",
  "end": 311.46
 },
 {
  "i": 102,
  "start": 311.46,
  "speechStart": 311.58,
  "speechEnd": 313.66,
  "text": "and it works better than anything else could have.",
  "end": 313.54
 },
 {
  "i": 103,
  "start": 313.54,
  "speechStart": 313.66,
  "speechEnd": 316.06,
  "text": "Thirty-eight people file out,",
  "end": 315.94
 },
 {
  "i": 104,
  "start": 315.94,
  "speechStart": 316.06,
  "speechEnd": 318.8,
  "text": "complaining, holding their coats, pointing at their phones.",
  "end": 319.62
 },
 {
  "i": 105,
  "start": 319.62,
  "speechStart": 319.74,
  "speechEnd": 321.08,
  "text": "Somebody asks if it's a drill.",
  "end": 321.38
 },
 {
  "i": 106,
  "start": 321.38,
  "speechStart": 321.5,
  "speechEnd": 324.3,
  "text": "Somebody asks if the cake is still happening. Mr.",
  "end": 324.32
 },
 {
  "i": 107,
  "start": 324.32,
  "speechStart": 324.44,
  "speechEnd": 326.12,
  "text": "Hale is still talking about the report.",
  "end": 326.9
 },
 {
  "i": 108,
  "start": 326.9,
  "speechStart": 327.02,
  "speechEnd": 328.28,
  "text": "You walk to the glass wall.",
  "end": 328.82
 },
 {
  "i": 109,
  "start": 328.82,
  "speechStart": 328.94,
  "speechEnd": 330.64,
  "text": "One tap, at the chalk line.",
  "end": 331.1
 },
 {
  "i": 110,
  "start": 331.1,
  "speechStart": 331.22,
  "speechEnd": 334.38,
  "text": "The glass breaks open into a clean arch,",
  "end": 334.8
 },
 {
  "i": 111,
  "start": 334.8,
  "speechStart": 334.92,
  "speechEnd": 336.84,
  "text": "wide enough for four people at a time.",
  "end": 337.6
 },
 {
  "i": 112,
  "start": 337.6,
  "speechStart": 337.72,
  "speechEnd": 341.42,
  "text": "At four fifty-eight, you're at the time clock. You tap your card.",
  "end": 341.96
 },
 {
  "i": 113,
  "start": 341.96,
  "speechStart": 342.08,
  "speechEnd": 343.92,
  "text": "The machine says, in a small green font:",
  "end": 343.8
 },
 {
  "i": 114,
  "start": 343.8,
  "speechStart": 343.92,
  "speechEnd": 347.92,
  "text": "four fifty-eight p.m. Clocked out. You turn around.",
  "end": 347.8
 },
 {
  "i": 115,
  "start": 347.8,
  "speechStart": 347.92,
  "speechEnd": 349.74,
  "text": "Priya's still at her desk.",
  "end": 350.48
 },
 {
  "i": 116,
  "start": 350.48,
  "speechStart": 350.6,
  "speechEnd": 352.04,
  "text": "You walk back through the empty floor.",
  "end": 352.68
 },
 {
  "i": 117,
  "start": 352.68,
  "speechStart": 352.8,
  "speechEnd": 354.5,
  "text": "Every desk lamp is still on.",
  "end": 354.78
 },
 {
  "i": 118,
  "start": 354.78,
  "speechStart": 354.9,
  "speechEnd": 356.54,
  "text": "Every chair is still warm.",
  "end": 357.3
 },
 {
  "i": 119,
  "start": 357.3,
  "speechStart": 357.42,
  "speechEnd": 360.3,
  "text": "\"I'm almost done,\" she says, without looking up.",
  "end": 360.78
 },
 {
  "i": 120,
  "start": 360.78,
  "speechStart": 360.9,
  "speechEnd": 364.52,
  "text": "\"The building's going to close.\" \"It's a building. It doesn't close.",
  "end": 364.96
 },
 {
  "i": 121,
  "start": 364.96,
  "speechStart": 365.08,
  "speechEnd": 365.4,
  "text": "It just...",
  "end": 365.28
 },
 {
  "i": 122,
  "start": 365.28,
  "speechStart": 365.4,
  "speechEnd": 368.24,
  "text": "asks for more.\" You almost laugh.",
  "end": 368.7
 },
 {
  "i": 123,
  "start": 368.7,
  "speechStart": 368.82,
  "speechEnd": 371.06,
  "text": "It's the truest thing anyone's said all day.",
  "end": 371.66
 },
 {
  "i": 124,
  "start": 371.66,
  "speechStart": 371.78,
  "speechEnd": 374.26,
  "text": "It's four fifty-nine and fifty seconds.",
  "end": 374.8
 },
 {
  "i": 125,
  "start": 374.8,
  "speechStart": 374.92,
  "speechEnd": 377.02,
  "text": "The doors seal with a sound like",
  "end": 376.9
 },
 {
  "i": 126,
  "start": 376.9,
  "speechStart": 377.02,
  "speechEnd": 380.94,
  "text": "a very large mouth closing. You clock back in.",
  "end": 381.44
 },
 {
  "i": 127,
  "start": 381.44,
  "speechStart": 381.56,
  "speechEnd": 382.66,
  "text": "You don't have a choice anymore.",
  "end": 382.54
 },
 {
  "i": 128,
  "start": 382.54,
  "speechStart": 382.66,
  "speechEnd": 384.06,
  "text": "In the story,",
  "end": 384.26
 },
 {
  "i": 129,
  "start": 384.26,
  "speechStart": 384.38,
  "speechEnd": 387.82,
  "text": "once overtime starts, his power jumps. A lot.",
  "end": 388.32
 },
 {
  "i": 130,
  "start": 388.32,
  "speechStart": 388.44,
  "speechEnd": 391.66,
  "text": "In your version, it's a loan. You get the power now.",
  "end": 392.16
 },
 {
  "i": 131,
  "start": 392.16,
  "speechStart": 392.28,
  "speechEnd": 394.18,
  "text": "And a clock starts on your heart.",
  "end": 394.06
 },
 {
  "i": 132,
  "start": 394.06,
  "speechStart": 394.18,
  "speechEnd": 395.76,
  "text": "Eleven minutes.",
  "end": 396.32
 },
 {
  "i": 133,
  "start": 396.32,
  "speechStart": 396.44,
  "speechEnd": 399.06,
  "text": "If you're not clocked out by then, it stops.",
  "end": 399.82
 },
 {
  "i": 134,
  "start": 399.82,
  "speechStart": 399.94,
  "speechEnd": 402.74,
  "text": "Everything gets quieter. Everything gets sharper.",
  "end": 403.48
 },
 {
  "i": 135,
  "start": 403.48,
  "speechStart": 403.6,
  "speechEnd": 406.32,
  "text": "You see the lines on the curse before it even shows up.",
  "end": 406.88
 },
 {
  "i": 136,
  "start": 406.88,
  "speechStart": 407.0,
  "speechEnd": 408.94,
  "text": "It's made of desks and cables",
  "end": 408.82
 },
 {
  "i": 137,
  "start": 408.82,
  "speechStart": 408.94,
  "speechEnd": 411.34,
  "text": "and a thousand tiny clocks that",
  "end": 411.22
 },
 {
  "i": 138,
  "start": 411.22,
  "speechStart": 411.34,
  "speechEnd": 413.72,
  "text": "all say five o'clock.",
  "end": 413.6
 },
 {
  "i": 139,
  "start": 413.6,
  "speechStart": 413.72,
  "speechEnd": 416.6,
  "text": "It rises out of the stairwell, as tall as the ceiling.",
  "end": 416.48
 },
 {
  "i": 140,
  "start": 416.48,
  "speechStart": 416.6,
  "speechEnd": 419.68,
  "text": "Priya says one word, quietly.",
  "end": 420.36
 },
 {
  "i": 141,
  "start": 420.36,
  "speechStart": 420.48,
  "speechEnd": 421.8,
  "text": "It's not a word you can repeat.",
  "end": 422.5
 },
 {
  "i": 142,
  "start": 422.5,
  "speechStart": 422.62,
  "speechEnd": 425.12,
  "text": "You push her behind the cabinets and step forward.",
  "end": 426.06
 },
 {
  "i": 143,
  "start": 426.06,
  "speechStart": 426.18,
  "speechEnd": 427.72,
  "text": "Five minutes left.",
  "end": 428.3
 },
 {
  "i": 144,
  "start": 428.3,
  "speechStart": 428.42,
  "speechEnd": 431.58,
  "text": "The curse hits first. You go through a wall.",
  "end": 432.04
 },
 {
  "i": 145,
  "start": 432.04,
  "speechStart": 432.16,
  "speechEnd": 432.94,
  "text": "You feel a rib,",
  "end": 432.82
 },
 {
  "i": 146,
  "start": 432.82,
  "speechStart": 432.94,
  "speechEnd": 435.74,
  "text": "or something near a rib, say no.",
  "end": 436.64
 },
 {
  "i": 147,
  "start": 436.64,
  "speechStart": 436.76,
  "speechEnd": 440.6,
  "text": "Your technique keeps the lines steady, though. Three tenths from the top.",
  "end": 440.86
 },
 {
  "i": 148,
  "start": 440.86,
  "speechStart": 440.98,
  "speechEnd": 442.28,
  "text": "Three tenths from the top.",
  "end": 442.7
 },
 {
  "i": 149,
  "start": 442.7,
  "speechStart": 442.82,
  "speechEnd": 444.24,
  "text": "Always three tenths.",
  "end": 444.78
 },
 {
  "i": 150,
  "start": 444.78,
  "speechStart": 444.9,
  "speechEnd": 447.82,
  "text": "Our guess is that a fight like this isn't about strength.",
  "end": 448.22
 },
 {
  "i": 151,
  "start": 448.22,
  "speechStart": 448.34,
  "speechEnd": 451.38,
  "text": "It's about not panicking when the clock is louder than the monster.",
  "end": 452.1
 },
 {
  "i": 152,
  "start": 452.1,
  "speechStart": 452.22,
  "speechEnd": 455.0,
  "text": "You swing the dull blade at the line on its chest.",
  "end": 455.54
 },
 {
  "i": 153,
  "start": 455.54,
  "speechStart": 455.66,
  "speechEnd": 457.9,
  "text": "It rings like a bell, a bad bell,",
  "end": 458.12
 },
 {
  "i": 154,
  "start": 458.12,
  "speechStart": 458.24,
  "speechEnd": 461.72,
  "text": "and your wrist goes white to the elbow. Nothing.",
  "end": 461.6
 },
 {
  "i": 155,
  "start": 461.6,
  "speechStart": 461.72,
  "speechEnd": 465.18,
  "text": "The curse laughs, with a hundred clock voices.",
  "end": 465.98
 },
 {
  "i": 156,
  "start": 465.98,
  "speechStart": 466.1,
  "speechEnd": 467.7,
  "text": "You aren't aiming at its chest.",
  "end": 468.16
 },
 {
  "i": 157,
  "start": 468.16,
  "speechStart": 468.28,
  "speechEnd": 470.46,
  "text": "You're aiming at the place it hides its weakness:",
  "end": 471.22
 },
 {
  "i": 158,
  "start": 471.22,
  "speechStart": 471.34,
  "speechEnd": 474.38,
  "text": "the old stairwell, where it came from. Collapse.",
  "end": 475.54
 },
 {
  "i": 159,
  "start": 475.54,
  "speechStart": 475.66,
  "speechEnd": 476.36,
  "text": "One tap.",
  "end": 476.54
 },
 {
  "i": 160,
  "start": 476.54,
  "speechStart": 476.66,
  "speechEnd": 479.22,
  "text": "At the line, on the floor beneath it.",
  "end": 479.56
 },
 {
  "i": 161,
  "start": 479.56,
  "speechStart": 479.68,
  "speechEnd": 483.12,
  "text": "The ninth floor folds, and the curse folds with it.",
  "end": 483.48
 },
 {
  "i": 162,
  "start": 483.48,
  "speechStart": 483.6,
  "speechEnd": 484.64,
  "text": "The desks slide.",
  "end": 484.98
 },
 {
  "i": 163,
  "start": 484.98,
  "speechStart": 485.1,
  "speechEnd": 487.0,
  "text": "The clocks go off one after another,",
  "end": 487.18
 },
 {
  "i": 164,
  "start": 487.18,
  "speechStart": 487.3,
  "speechEnd": 489.92,
  "text": "a hundred little alarms, each one ringing five.",
  "end": 490.46
 },
 {
  "i": 165,
  "start": 490.46,
  "speechStart": 490.58,
  "speechEnd": 491.58,
  "text": "You don't hear them.",
  "end": 492.22
 },
 {
  "i": 166,
  "start": 492.22,
  "speechStart": 492.34,
  "speechEnd": 495.34,
  "text": "You hear only your own pulse, counting down.",
  "end": 496.1
 },
 {
  "i": 167,
  "start": 496.1,
  "speechStart": 496.22,
  "speechEnd": 498.86,
  "text": "The doors unseal with a soft click.",
  "end": 499.52
 },
 {
  "i": 168,
  "start": 499.52,
  "speechStart": 499.64,
  "speechEnd": 501.66,
  "text": "Your heart is a metronome with",
  "end": 501.54
 },
 {
  "i": 169,
  "start": 501.54,
  "speechStart": 501.66,
  "speechEnd": 504.92,
  "text": "something wrong in it. Thump. Thump.",
  "end": 505.46
 },
 {
  "i": 170,
  "start": 505.46,
  "speechStart": 505.58,
  "speechEnd": 507.48,
  "text": "Then a long, long gap.",
  "end": 508.48
 },
 {
  "i": 171,
  "start": 508.48,
  "speechStart": 508.6,
  "speechEnd": 509.84,
  "text": "You crawl to the time clock.",
  "end": 509.72
 },
 {
  "i": 172,
  "start": 509.72,
  "speechStart": 509.84,
  "speechEnd": 511.54,
  "text": "Priya's behind you,",
  "end": 511.62
 },
 {
  "i": 173,
  "start": 511.62,
  "speechStart": 511.74,
  "speechEnd": 515.0,
  "text": "holding your tie like a leash. You tap the card.",
  "end": 514.88
 },
 {
  "i": 174,
  "start": 514.88,
  "speechStart": 515.0,
  "speechEnd": 517.88,
  "text": "Five eleven p.m. Clocked out.",
  "end": 518.54
 },
 {
  "i": 175,
  "start": 518.54,
  "speechStart": 518.66,
  "speechEnd": 521.34,
  "text": "Your heart starts again, rude and loud.",
  "end": 522.16
 },
 {
  "i": 176,
  "start": 522.16,
  "speechStart": 522.28,
  "speechEnd": 525.06,
  "text": "The next morning, the building has a new notice by the door.",
  "end": 525.62
 },
 {
  "i": 177,
  "start": 525.62,
  "speechStart": 525.74,
  "speechEnd": 530.06,
  "text": "A line for who left on time. Priya brings you a coffee.",
  "end": 530.6
 },
 {
  "i": 178,
  "start": 530.6,
  "speechStart": 530.72,
  "speechEnd": 532.76,
  "text": "It's bad. It's perfect.",
  "end": 533.62
 },
 {
  "i": 179,
  "start": 533.62,
  "speechStart": 533.74,
  "speechEnd": 537.6,
  "text": "\"You knew,\" she says. \"From the start. Didn't you?\"",
  "end": 537.48
 },
 {
  "i": 180,
  "start": 537.48,
  "speechStart": 537.6,
  "speechEnd": 539.14,
  "text": "\"I only knew one thing.",
  "end": 539.3
 },
 {
  "i": 181,
  "start": 539.3,
  "speechStart": 539.42,
  "speechEnd": 542.02,
  "text": "That nothing in that building was worth being late for.\"",
  "end": 542.68
 },
 {
  "i": 182,
  "start": 542.68,
  "speechStart": 542.8,
  "speechEnd": 546.18,
  "text": "She thinks about that, and then she writes something on a sticky note",
  "end": 546.06
 },
 {
  "i": 183,
  "start": 546.06,
  "speechStart": 546.18,
  "speechEnd": 549.02,
  "text": "and presses it onto your monitor. It says:",
  "end": 549.48
 },
 {
  "i": 184,
  "start": 549.48,
  "speechStart": 549.6,
  "speechEnd": 552.06,
  "text": "GO HOME. You leave at five.",
  "end": 552.68
 },
 {
  "i": 185,
  "start": 552.68,
  "speechStart": 552.8,
  "speechEnd": 554.62,
  "text": "Not five oh one. Five.",
  "end": 555.68
 },
 {
  "i": 186,
  "start": 555.68,
  "speechStart": 555.8,
  "speechEnd": 557.14,
  "text": "Would you clock out on time,",
  "end": 557.7
 },
 {
  "i": 187,
  "start": 557.7,
  "speechStart": 557.82,
  "speechEnd": 560.58,
  "text": "if the other option was a hundred more hours?",
  "end": 561.36
 },
 {
  "i": 188,
  "start": 561.36,
  "speechStart": 561.48,
  "speechEnd": 562.26,
  "text": "Tell me in the comments.",
  "end": 562.7
 },
 {
  "i": 189,
  "start": 562.7,
  "speechStart": 562.82,
  "speechEnd": 565.9,
  "text": "And if you want the next one, tell me who you want to become.",
  "end": 567.5
 }
]