[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 4.02,
  "text": "You've woken up as Toji Fushiguro. In real life.",
  "end": 4.52
 },
 {
  "i": 1,
  "start": 4.52,
  "speechStart": 4.64,
  "speechEnd": 6.7,
  "text": "You have zero cursed energy.",
  "end": 7.26
 },
 {
  "i": 2,
  "start": 7.26,
  "speechStart": 7.38,
  "speechEnd": 8.78,
  "text": "Nothing in this world can sense you.",
  "end": 9.36
 },
 {
  "i": 3,
  "start": 9.36,
  "speechStart": 9.48,
  "speechEnd": 11.16,
  "text": "In the story, that isn't a weakness.",
  "end": 11.5
 },
 {
  "i": 4,
  "start": 11.5,
  "speechStart": 11.62,
  "speechEnd": 13.2,
  "text": "It's the trade he was born with.",
  "end": 13.68
 },
 {
  "i": 5,
  "start": 13.68,
  "speechStart": 13.8,
  "speechEnd": 17.3,
  "text": "In your version, there's a curse hunting your best friend tonight.",
  "end": 17.72
 },
 {
  "i": 6,
  "start": 17.72,
  "speechStart": 17.84,
  "speechEnd": 19.82,
  "text": "You're the only thing it can't feel coming.",
  "end": 20.42
 },
 {
  "i": 7,
  "start": 20.42,
  "speechStart": 20.54,
  "speechEnd": 22.38,
  "text": "But first, it's three oh seven in the morning,",
  "end": 22.68
 },
 {
  "i": 8,
  "start": 22.68,
  "speechStart": 22.8,
  "speechEnd": 24.14,
  "text": "and your hands are shaking,",
  "end": 24.02
 },
 {
  "i": 9,
  "start": 24.02,
  "speechStart": 24.14,
  "speechEnd": 26.92,
  "text": "because they are much stronger than they should be.",
  "end": 27.92
 },
 {
  "i": 10,
  "start": 27.92,
  "speechStart": 28.04,
  "speechEnd": 30.48,
  "text": "Toji was born with a Heavenly Restriction.",
  "end": 31.02
 },
 {
  "i": 11,
  "start": 31.02,
  "speechStart": 31.14,
  "speechEnd": 33.02,
  "text": "It took away all of his cursed energy",
  "end": 32.9
 },
 {
  "i": 12,
  "start": 32.9,
  "speechStart": 33.02,
  "speechEnd": 35.86,
  "text": "and gave him a body and senses at the limit.",
  "end": 36.74
 },
 {
  "i": 13,
  "start": 36.74,
  "speechStart": 36.86,
  "speechEnd": 38.92,
  "text": "You sit up and the bed frame cracks.",
  "end": 39.86
 },
 {
  "i": 14,
  "start": 39.86,
  "speechStart": 39.98,
  "speechEnd": 43.06,
  "text": "You reach for the light switch and the plate comes off in your hand.",
  "end": 43.52
 },
 {
  "i": 15,
  "start": 43.52,
  "speechStart": 43.64,
  "speechEnd": 45.14,
  "text": "Just a plastic plate.",
  "end": 45.66
 },
 {
  "i": 16,
  "start": 45.66,
  "speechStart": 45.78,
  "speechEnd": 49.82,
  "text": "You hold it very, very carefully. Then the sounds arrive.",
  "end": 50.44
 },
 {
  "i": 17,
  "start": 50.44,
  "speechStart": 50.56,
  "speechEnd": 52.82,
  "text": "The fridge, the pipes behind the wall,",
  "end": 53.24
 },
 {
  "i": 18,
  "start": 53.24,
  "speechStart": 53.36,
  "speechEnd": 57.38,
  "text": "a neighbour's heartbeat three floors down. In the story,",
  "end": 57.46
 },
 {
  "i": 19,
  "start": 57.46,
  "speechStart": 57.58,
  "speechEnd": 59.74,
  "text": "his senses are sharp enough to catch curses",
  "end": 59.62
 },
 {
  "i": 20,
  "start": 59.62,
  "speechStart": 59.74,
  "speechEnd": 62.56,
  "text": "by tiny changes in the air and the temperature.",
  "end": 63.42
 },
 {
  "i": 21,
  "start": 63.42,
  "speechStart": 63.54,
  "speechEnd": 64.84,
  "text": "You step into the corridor",
  "end": 64.72
 },
 {
  "i": 22,
  "start": 64.72,
  "speechStart": 64.84,
  "speechEnd": 67.16,
  "text": "and the air is colder by the stairs.",
  "end": 67.72
 },
 {
  "i": 23,
  "start": 67.72,
  "speechStart": 67.84,
  "speechEnd": 71.16,
  "text": "A small, quiet, wrong kind of cold.",
  "end": 71.88
 },
 {
  "i": 24,
  "start": 71.88,
  "speechStart": 72.0,
  "speechEnd": 75.4,
  "text": "In your version, that's the curse's trail. Faint.",
  "end": 75.86
 },
 {
  "i": 25,
  "start": 75.86,
  "speechStart": 75.98,
  "speechEnd": 76.36,
  "text": "Old.",
  "end": 76.84
 },
 {
  "i": 26,
  "start": 76.84,
  "speechStart": 76.96,
  "speechEnd": 78.18,
  "text": "Moving toward Dani's building.",
  "end": 78.06
 },
 {
  "i": 27,
  "start": 78.06,
  "speechStart": 78.18,
  "speechEnd": 80.32,
  "text": "Dani is your best friend.",
  "end": 80.2
 },
 {
  "i": 28,
  "start": 80.2,
  "speechStart": 80.32,
  "speechEnd": 82.96,
  "text": "Dani is also the only person you know",
  "end": 82.84
 },
 {
  "i": 29,
  "start": 82.84,
  "speechStart": 82.96,
  "speechEnd": 84.14,
  "text": "who can see curses.",
  "end": 84.68
 },
 {
  "i": 30,
  "start": 84.68,
  "speechStart": 84.8,
  "speechEnd": 87.84,
  "text": "You take the stairs. All eleven floors,",
  "end": 87.72
 },
 {
  "i": 31,
  "start": 87.72,
  "speechStart": 87.84,
  "speechEnd": 90.64,
  "text": "in under a minute, without being out of breath.",
  "end": 91.32
 },
 {
  "i": 32,
  "start": 91.32,
  "speechStart": 91.44,
  "speechEnd": 93.96,
  "text": "You didn't mean to run. Your legs just decided.",
  "end": 94.64
 },
 {
  "i": 33,
  "start": 94.64,
  "speechStart": 94.76,
  "speechEnd": 98.98,
  "text": "On the way down you pass a mirror. You stop. It's your face.",
  "end": 99.56
 },
 {
  "i": 34,
  "start": 99.56,
  "speechStart": 99.68,
  "speechEnd": 102.22,
  "text": "Same tired eyes, same crooked nose.",
  "end": 102.78
 },
 {
  "i": 35,
  "start": 102.78,
  "speechStart": 102.9,
  "speechEnd": 106.88,
  "text": "But the way you stand has changed. Quieter. Lighter.",
  "end": 107.62
 },
 {
  "i": 36,
  "start": 107.62,
  "speechStart": 107.74,
  "speechEnd": 110.32,
  "text": "Like someone who has already decided where the exits are.",
  "end": 110.2
 },
 {
  "i": 37,
  "start": 110.2,
  "speechStart": 110.32,
  "speechEnd": 112.92,
  "text": "In your version, you keep your own face.",
  "end": 113.44
 },
 {
  "i": 38,
  "start": 113.44,
  "speechStart": 113.56,
  "speechEnd": 114.52,
  "text": "The body is his,",
  "end": 115.12
 },
 {
  "i": 39,
  "start": 115.12,
  "speechStart": 115.24,
  "speechEnd": 118.14,
  "text": "and you're just the one living in it. You grab your jacket.",
  "end": 118.6
 },
 {
  "i": 40,
  "start": 118.6,
  "speechStart": 118.72,
  "speechEnd": 121.12,
  "text": "It's a size too small. You keep it anyway.",
  "end": 121.0
 },
 {
  "i": 41,
  "start": 121.0,
  "speechStart": 121.12,
  "speechEnd": 123.12,
  "text": "Dani opens",
  "end": 123.0
 },
 {
  "i": 42,
  "start": 123.0,
  "speechStart": 123.12,
  "speechEnd": 126.12,
  "text": "the door at three forty with a mug, half asleep.",
  "end": 126.88
 },
 {
  "i": 43,
  "start": 126.88,
  "speechStart": 127.0,
  "speechEnd": 130.24,
  "text": "\"I can't feel you,\" she says, frowning. \"Say something.\"",
  "end": 131.1
 },
 {
  "i": 44,
  "start": 131.1,
  "speechStart": 131.22,
  "speechEnd": 134.9,
  "text": "\"I'm right here.\" \"I know you're there. I can hear you.",
  "end": 134.92
 },
 {
  "i": 45,
  "start": 134.92,
  "speechStart": 135.04,
  "speechEnd": 138.04,
  "text": "But I can't feel you. It's like you're a...",
  "end": 137.92
 },
 {
  "i": 46,
  "start": 137.92,
  "speechStart": 138.04,
  "speechEnd": 138.66,
  "text": "hole.\"",
  "end": 139.02
 },
 {
  "i": 47,
  "start": 139.02,
  "speechStart": 139.14,
  "speechEnd": 141.06,
  "text": "She has a scanner her mother built.",
  "end": 141.34
 },
 {
  "i": 48,
  "start": 141.34,
  "speechStart": 141.46,
  "speechEnd": 144.56,
  "text": "A little box that reads cursed energy and shows a number.",
  "end": 145.02
 },
 {
  "i": 49,
  "start": 145.02,
  "speechStart": 145.14,
  "speechEnd": 146.32,
  "text": "It reads the neighbour's cat.",
  "end": 146.68
 },
 {
  "i": 50,
  "start": 146.68,
  "speechStart": 146.8,
  "speechEnd": 148.04,
  "text": "It reads Dani.",
  "end": 147.92
 },
 {
  "i": 51,
  "start": 147.92,
  "speechStart": 148.04,
  "speechEnd": 150.54,
  "text": "It reads the fridge, a little, because the fridge is old.",
  "end": 151.02
 },
 {
  "i": 52,
  "start": 151.02,
  "speechStart": 151.14,
  "speechEnd": 153.96,
  "text": "You stand next to it and the screen says: CE LEVEL,",
  "end": 153.84
 },
 {
  "i": 53,
  "start": 153.84,
  "speechStart": 153.96,
  "speechEnd": 157.36,
  "text": "zero point zero zero percent. STATUS,",
  "end": 157.98
 },
 {
  "i": 54,
  "start": 157.98,
  "speechStart": 158.1,
  "speechEnd": 158.2,
  "text": "none.",
  "end": 158.76
 },
 {
  "i": 55,
  "start": 158.76,
  "speechStart": 158.88,
  "speechEnd": 161.58,
  "text": "In the story, Toji was called the invisible man.",
  "end": 162.12
 },
 {
  "i": 56,
  "start": 162.12,
  "speechStart": 162.24,
  "speechEnd": 163.08,
  "text": "Nothing could sense him,",
  "end": 162.96
 },
 {
  "i": 57,
  "start": 162.96,
  "speechStart": 163.08,
  "speechEnd": 166.48,
  "text": "unless it came from the energy in his tools or a curse he carried.",
  "end": 166.96
 },
 {
  "i": 58,
  "start": 166.96,
  "speechStart": 167.08,
  "speechEnd": 169.52,
  "text": "In your version, that's the whole trick.",
  "end": 169.4
 },
 {
  "i": 59,
  "start": 169.4,
  "speechStart": 169.52,
  "speechEnd": 171.46,
  "text": "And the whole cost.",
  "end": 171.34
 },
 {
  "i": 60,
  "start": 171.34,
  "speechStart": 171.46,
  "speechEnd": 173.96,
  "text": "Dani looks at the number for a long time.",
  "end": 174.66
 },
 {
  "i": 61,
  "start": 174.66,
  "speechStart": 174.78,
  "speechEnd": 178.46,
  "text": "\"Nobody's ever going to be able to find you,\" she says. \"Even if they want to.\"",
  "end": 178.72
 },
 {
  "i": 62,
  "start": 178.72,
  "speechStart": 178.84,
  "speechEnd": 181.68,
  "text": "You say you don't need to be found. She doesn't answer.",
  "end": 182.22
 },
 {
  "i": 63,
  "start": 182.22,
  "speechStart": 182.34,
  "speechEnd": 184.58,
  "text": "In the story, his clan, the Zenin,",
  "end": 184.46
 },
 {
  "i": 64,
  "start": 184.46,
  "speechStart": 184.58,
  "speechEnd": 188.42,
  "text": "pushed him out for relying on tools instead of energy. You think:",
  "end": 188.96
 },
 {
  "i": 65,
  "start": 188.96,
  "speechStart": 189.08,
  "speechEnd": 190.38,
  "text": "yes, that sounds right.",
  "end": 191.38
 },
 {
  "i": 66,
  "start": 191.38,
  "speechStart": 191.5,
  "speechEnd": 193.94,
  "text": "You walk Dani home through the empty street.",
  "end": 193.82
 },
 {
  "i": 67,
  "start": 193.82,
  "speechStart": 193.94,
  "speechEnd": 197.54,
  "text": "She walks half a step behind, scanning every doorway.",
  "end": 198.04
 },
 {
  "i": 68,
  "start": 198.04,
  "speechStart": 198.16,
  "speechEnd": 199.9,
  "text": "The street is full of tiny curses.",
  "end": 200.48
 },
 {
  "i": 69,
  "start": 200.48,
  "speechStart": 200.6,
  "speechEnd": 203.36,
  "text": "Little grey knots that drift between the lamp posts,",
  "end": 203.24
 },
 {
  "i": 70,
  "start": 203.24,
  "speechStart": 203.36,
  "speechEnd": 205.72,
  "text": "feeding on the loud, tired people who walk by.",
  "end": 206.3
 },
 {
  "i": 71,
  "start": 206.3,
  "speechStart": 206.42,
  "speechEnd": 208.08,
  "text": "They follow Dani like moths.",
  "end": 208.82
 },
 {
  "i": 72,
  "start": 208.82,
  "speechStart": 208.94,
  "speechEnd": 212.48,
  "text": "Not one of them turns toward you. One brushes your shoulder.",
  "end": 212.92
 },
 {
  "i": 73,
  "start": 212.92,
  "speechStart": 213.04,
  "speechEnd": 215.36,
  "text": "It doesn't stop. It doesn't hesitate.",
  "end": 215.92
 },
 {
  "i": 74,
  "start": 215.92,
  "speechStart": 216.04,
  "speechEnd": 219.12,
  "text": "It simply drifts on, as if you were a piece of the wall.",
  "end": 219.66
 },
 {
  "i": 75,
  "start": 219.66,
  "speechStart": 219.78,
  "speechEnd": 222.46,
  "text": "In your version, that's how the world sees you now.",
  "end": 222.9
 },
 {
  "i": 76,
  "start": 222.9,
  "speechStart": 223.02,
  "speechEnd": 225.74,
  "text": "Not as an enemy. As nothing at all.",
  "end": 226.24
 },
 {
  "i": 77,
  "start": 226.24,
  "speechStart": 226.36,
  "speechEnd": 227.7,
  "text": "You'd expected to feel powerful.",
  "end": 228.38
 },
 {
  "i": 78,
  "start": 228.38,
  "speechStart": 228.5,
  "speechEnd": 230.98,
  "text": "You feel, mostly, a little lonely.",
  "end": 230.86
 },
 {
  "i": 79,
  "start": 230.86,
  "speechStart": 230.98,
  "speechEnd": 233.32,
  "text": "Dani sees your face and says, gently:",
  "end": 233.8
 },
 {
  "i": 80,
  "start": 233.8,
  "speechStart": 233.92,
  "speechEnd": 235.1,
  "text": "\"It's not a bad thing.",
  "end": 235.5
 },
 {
  "i": 81,
  "start": 235.5,
  "speechStart": 235.62,
  "speechEnd": 237.36,
  "text": "It's just a very quiet thing.\"",
  "end": 237.9
 },
 {
  "i": 82,
  "start": 237.9,
  "speechStart": 238.02,
  "speechEnd": 239.42,
  "text": "At the end of the street, she stops",
  "end": 239.3
 },
 {
  "i": 83,
  "start": 239.3,
  "speechStart": 239.42,
  "speechEnd": 242.86,
  "text": "and looks at the shrine on the hill, black against a red sky.",
  "end": 243.34
 },
 {
  "i": 84,
  "start": 243.34,
  "speechStart": 243.46,
  "speechEnd": 245.08,
  "text": "\"It's been there for a month,\" she says.",
  "end": 245.7
 },
 {
  "i": 85,
  "start": 245.7,
  "speechStart": 245.82,
  "speechEnd": 249.22,
  "text": "\"It eats the loudest person in range. That's me.",
  "end": 249.96
 },
 {
  "i": 86,
  "start": 249.96,
  "speechStart": 250.08,
  "speechEnd": 251.28,
  "text": "Tonight, that's me.\"",
  "end": 251.16
 },
 {
  "i": 87,
  "start": 251.16,
  "speechStart": 251.28,
  "speechEnd": 253.44,
  "text": "Dani's mother left",
  "end": 253.32
 },
 {
  "i": 88,
  "start": 253.32,
  "speechStart": 253.44,
  "speechEnd": 255.84,
  "text": "something in the storage unit under the shrine.",
  "end": 256.5
 },
 {
  "i": 89,
  "start": 256.5,
  "speechStart": 256.62,
  "speechEnd": 259.24,
  "text": "A long black case. Four tools.",
  "end": 259.96
 },
 {
  "i": 90,
  "start": 259.96,
  "speechStart": 260.08,
  "speechEnd": 261.94,
  "text": "You know what they are before you open it.",
  "end": 262.68
 },
 {
  "i": 91,
  "start": 262.68,
  "speechStart": 262.8,
  "speechEnd": 265.14,
  "text": "The Inverted Spear of Heaven nullifies",
  "end": 265.02
 },
 {
  "i": 92,
  "start": 265.02,
  "speechStart": 265.14,
  "speechEnd": 267.38,
  "text": "a technique the moment it touches it.",
  "end": 267.86
 },
 {
  "i": 93,
  "start": 267.86,
  "speechStart": 267.98,
  "speechEnd": 272.24,
  "text": "In the story, it ended Gojo's Infinity. In your version,",
  "end": 272.22
 },
 {
  "i": 94,
  "start": 272.22,
  "speechStart": 272.34,
  "speechEnd": 275.28,
  "text": "it only cancels what is active when it touches.",
  "end": 275.68
 },
 {
  "i": 95,
  "start": 275.68,
  "speechStart": 275.8,
  "speechEnd": 278.54,
  "text": "It does nothing to a fist. It does nothing to a wall.",
  "end": 279.74
 },
 {
  "i": 96,
  "start": 279.74,
  "speechStart": 279.86,
  "speechEnd": 282.54,
  "text": "The Chain of a Thousand Miles gives it reach,",
  "end": 282.68
 },
 {
  "i": 97,
  "start": 282.68,
  "speechStart": 282.8,
  "speechEnd": 284.82,
  "text": "like a kusarigama.",
  "end": 284.7
 },
 {
  "i": 98,
  "start": 284.7,
  "speechStart": 284.82,
  "speechEnd": 286.48,
  "text": "You swing it once, in an empty room.",
  "end": 286.84
 },
 {
  "i": 99,
  "start": 286.84,
  "speechStart": 286.96,
  "speechEnd": 288.6,
  "text": "It takes the ceiling light with it.",
  "end": 289.26
 },
 {
  "i": 100,
  "start": 289.26,
  "speechStart": 289.38,
  "speechEnd": 291.64,
  "text": "The Split Soul Katana cuts the soul",
  "end": 291.52
 },
 {
  "i": 101,
  "start": 291.52,
  "speechStart": 291.64,
  "speechEnd": 294.56,
  "text": "and ignores the body's armor. In your version,",
  "end": 294.82
 },
 {
  "i": 102,
  "start": 294.82,
  "speechStart": 294.94,
  "speechEnd": 297.34,
  "text": "it can hurt a curse without cutting a single brick.",
  "end": 297.22
 },
 {
  "i": 103,
  "start": 297.22,
  "speechStart": 297.34,
  "speechEnd": 300.96,
  "text": "You test it on a mattress. The mattress is fine.",
  "end": 301.64
 },
 {
  "i": 104,
  "start": 301.64,
  "speechStart": 301.76,
  "speechEnd": 302.56,
  "text": "You are not.",
  "end": 303.46
 },
 {
  "i": 105,
  "start": 303.46,
  "speechStart": 303.58,
  "speechEnd": 307.04,
  "text": "And the Playful Cloud is a special grade tool. A heavy weapon.",
  "end": 307.58
 },
 {
  "i": 106,
  "start": 307.58,
  "speechStart": 307.7,
  "speechEnd": 309.5,
  "text": "You pick it up one-handed.",
  "end": 309.38
 },
 {
  "i": 107,
  "start": 309.38,
  "speechStart": 309.5,
  "speechEnd": 310.72,
  "text": "You're careful with this one too.",
  "end": 310.6
 },
 {
  "i": 108,
  "start": 310.6,
  "speechStart": 310.72,
  "speechEnd": 312.42,
  "text": "Dani watches you.",
  "end": 312.72
 },
 {
  "i": 109,
  "start": 312.72,
  "speechStart": 312.84,
  "speechEnd": 315.68,
  "text": "\"Please tell me you're not going to do the thing.\" \"What thing?\"",
  "end": 316.22
 },
 {
  "i": 110,
  "start": 316.22,
  "speechStart": 316.34,
  "speechEnd": 319.18,
  "text": "\"The thing where you go and hunt it.\" You tell her the truth.",
  "end": 319.64
 },
 {
  "i": 111,
  "start": 319.64,
  "speechStart": 319.76,
  "speechEnd": 322.02,
  "text": "It can't feel you. It can feel her.",
  "end": 322.46
 },
 {
  "i": 112,
  "start": 322.46,
  "speechStart": 322.58,
  "speechEnd": 324.16,
  "text": "If she stays home, it comes to her.",
  "end": 324.68
 },
 {
  "i": 113,
  "start": 324.68,
  "speechStart": 324.8,
  "speechEnd": 326.36,
  "text": "If she goes with you, she's bait.",
  "end": 327.08
 },
 {
  "i": 114,
  "start": 327.08,
  "speechStart": 327.2,
  "speechEnd": 330.64,
  "text": "\"So I'm bait either way,\" she says. \"Not if I get there first.\"",
  "end": 331.16
 },
 {
  "i": 115,
  "start": 331.16,
  "speechStart": 331.28,
  "speechEnd": 333.44,
  "text": "It's the least reassuring thing you've ever said.",
  "end": 334.14
 },
 {
  "i": 116,
  "start": 334.14,
  "speechStart": 334.26,
  "speechEnd": 335.62,
  "text": "She picks up the scanner anyway.",
  "end": 336.58
 },
 {
  "i": 117,
  "start": 336.58,
  "speechStart": 336.7,
  "speechEnd": 340.16,
  "text": "The curse is in the old shrine at the end of the line,",
  "end": 340.04
 },
 {
  "i": 118,
  "start": 340.04,
  "speechStart": 340.16,
  "speechEnd": 341.82,
  "text": "where the metro turns around.",
  "end": 342.22
 },
 {
  "i": 119,
  "start": 342.22,
  "speechStart": 342.34,
  "speechEnd": 345.16,
  "text": "You can feel it, because your body feels everything.",
  "end": 345.6
 },
 {
  "i": 120,
  "start": 345.6,
  "speechStart": 345.72,
  "speechEnd": 347.28,
  "text": "A pulse in the cold,",
  "end": 347.52
 },
 {
  "i": 121,
  "start": 347.52,
  "speechStart": 347.64,
  "speechEnd": 349.46,
  "text": "like a slow knock on glass.",
  "end": 349.34
 },
 {
  "i": 122,
  "start": 349.34,
  "speechStart": 349.46,
  "speechEnd": 352.26,
  "text": "Dani stays at the gate with the scanner.",
  "end": 352.74
 },
 {
  "i": 123,
  "start": 352.74,
  "speechStart": 352.86,
  "speechEnd": 356.62,
  "text": "Her screen shows a big red number for the curse. And for you,",
  "end": 356.88
 },
 {
  "i": 124,
  "start": 356.88,
  "speechStart": 357.0,
  "speechEnd": 360.3,
  "text": "just a quiet grey frame that says NO DETECTION.",
  "end": 361.1
 },
 {
  "i": 125,
  "start": 361.1,
  "speechStart": 361.22,
  "speechEnd": 365.18,
  "text": "In your version, that's the rule that makes you dangerous. Not strength.",
  "end": 365.58
 },
 {
  "i": 126,
  "start": 365.58,
  "speechStart": 365.7,
  "speechEnd": 367.62,
  "text": "The fact that it never knows you're coming.",
  "end": 368.26
 },
 {
  "i": 127,
  "start": 368.26,
  "speechStart": 368.38,
  "speechEnd": 371.62,
  "text": "You walk up the stairs in silence. Not a single sound.",
  "end": 372.06
 },
 {
  "i": 128,
  "start": 372.06,
  "speechStart": 372.18,
  "speechEnd": 373.96,
  "text": "The curse is waiting at the top.",
  "end": 374.36
 },
 {
  "i": 129,
  "start": 374.36,
  "speechStart": 374.48,
  "speechEnd": 377.1,
  "text": "It's turned toward the gate, toward Dani,",
  "end": 376.98
 },
 {
  "i": 130,
  "start": 376.98,
  "speechStart": 377.1,
  "speechEnd": 380.98,
  "text": "toward all that warm, loud energy. It isn't looking at you.",
  "end": 381.42
 },
 {
  "i": 131,
  "start": 381.42,
  "speechStart": 381.54,
  "speechEnd": 382.3,
  "text": "You're not there.",
  "end": 382.18
 },
 {
  "i": 132,
  "start": 382.18,
  "speechStart": 382.3,
  "speechEnd": 384.14,
  "text": "Our guess is that",
  "end": 384.02
 },
 {
  "i": 133,
  "start": 384.02,
  "speechStart": 384.14,
  "speechEnd": 385.96,
  "text": "a creature that hunts by sensing",
  "end": 385.84
 },
 {
  "i": 134,
  "start": 385.84,
  "speechStart": 385.96,
  "speechEnd": 388.08,
  "text": "energy would never be built",
  "end": 387.96
 },
 {
  "i": 135,
  "start": 387.96,
  "speechStart": 388.08,
  "speechEnd": 390.04,
  "text": "to expect something without any.",
  "end": 390.5
 },
 {
  "i": 136,
  "start": 390.5,
  "speechStart": 390.62,
  "speechEnd": 392.1,
  "text": "You step into its blind spot,",
  "end": 391.98
 },
 {
  "i": 137,
  "start": 391.98,
  "speechStart": 392.1,
  "speechEnd": 394.14,
  "text": "and for one second you",
  "end": 394.02
 },
 {
  "i": 138,
  "start": 394.02,
  "speechStart": 394.14,
  "speechEnd": 396.18,
  "text": "are the quietest thing in the world.",
  "end": 397.04
 },
 {
  "i": 139,
  "start": 397.04,
  "speechStart": 397.16,
  "speechEnd": 398.44,
  "text": "It has a technique.",
  "end": 398.84
 },
 {
  "i": 140,
  "start": 398.84,
  "speechStart": 398.96,
  "speechEnd": 400.82,
  "text": "It seals the space around the gate,",
  "end": 400.7
 },
 {
  "i": 141,
  "start": 400.7,
  "speechStart": 400.82,
  "speechEnd": 404.24,
  "text": "and Dani can't leave. You didn't plan for that.",
  "end": 404.86
 },
 {
  "i": 142,
  "start": 404.86,
  "speechStart": 404.98,
  "speechEnd": 405.96,
  "text": "You swing the chain.",
  "end": 406.3
 },
 {
  "i": 143,
  "start": 406.3,
  "speechStart": 406.42,
  "speechEnd": 407.78,
  "text": "It wraps the ward's anchor.",
  "end": 408.2
 },
 {
  "i": 144,
  "start": 408.2,
  "speechStart": 408.32,
  "speechEnd": 410.64,
  "text": "You pull the spear down onto the symbol,",
  "end": 410.52
 },
 {
  "i": 145,
  "start": 410.52,
  "speechStart": 410.64,
  "speechEnd": 414.02,
  "text": "and the ward goes out like a lightbulb. The curse turns.",
  "end": 414.78
 },
 {
  "i": 146,
  "start": 414.78,
  "speechStart": 414.9,
  "speechEnd": 418.64,
  "text": "It finally feels something. A shape. Not an energy.",
  "end": 419.18
 },
 {
  "i": 147,
  "start": 419.18,
  "speechStart": 419.3,
  "speechEnd": 420.94,
  "text": "Just a man who weighs too much.",
  "end": 421.46
 },
 {
  "i": 148,
  "start": 421.46,
  "speechStart": 421.58,
  "speechEnd": 423.28,
  "text": "Its first strike misses by an inch,",
  "end": 423.6
 },
 {
  "i": 149,
  "start": 423.6,
  "speechStart": 423.72,
  "speechEnd": 427.38,
  "text": "because it's aiming at where a person's energy would be, and there isn't any.",
  "end": 427.96
 },
 {
  "i": 150,
  "start": 427.96,
  "speechStart": 428.08,
  "speechEnd": 430.96,
  "text": "Its second misses by less. It's learning.",
  "end": 431.76
 },
 {
  "i": 151,
  "start": 431.76,
  "speechStart": 431.88,
  "speechEnd": 434.3,
  "text": "Its third doesn't miss. It hits you.",
  "end": 434.78
 },
 {
  "i": 152,
  "start": 434.78,
  "speechStart": 434.9,
  "speechEnd": 437.96,
  "text": "In your version, your body is a wall, not a god.",
  "end": 438.54
 },
 {
  "i": 153,
  "start": 438.54,
  "speechStart": 438.66,
  "speechEnd": 439.22,
  "text": "It hurts.",
  "end": 439.88
 },
 {
  "i": 154,
  "start": 439.88,
  "speechStart": 440.0,
  "speechEnd": 441.8,
  "text": "Something in your ribs says so out loud.",
  "end": 442.48
 },
 {
  "i": 155,
  "start": 442.48,
  "speechStart": 442.6,
  "speechEnd": 446.78,
  "text": "You hit back with the katana, the one that ignores armor. Once.",
  "end": 447.42
 },
 {
  "i": 156,
  "start": 447.42,
  "speechStart": 447.54,
  "speechEnd": 447.76,
  "text": "Twice.",
  "end": 448.38
 },
 {
  "i": 157,
  "start": 448.38,
  "speechStart": 448.5,
  "speechEnd": 452.62,
  "text": "The curse falls apart without a sound. No dust. Nothing broken.",
  "end": 453.2
 },
 {
  "i": 158,
  "start": 453.2,
  "speechStart": 453.32,
  "speechEnd": 453.84,
  "text": "Just gone.",
  "end": 454.44
 },
 {
  "i": 159,
  "start": 454.44,
  "speechStart": 454.56,
  "speechEnd": 456.14,
  "text": "The red moon is very quiet.",
  "end": 456.82
 },
 {
  "i": 160,
  "start": 456.82,
  "speechStart": 456.94,
  "speechEnd": 458.2,
  "text": "You stand there, breathing,",
  "end": 458.8
 },
 {
  "i": 161,
  "start": 458.8,
  "speechStart": 458.92,
  "speechEnd": 462.76,
  "text": "waiting for the feeling you expected. Victory. Pride.",
  "end": 463.6
 },
 {
  "i": 162,
  "start": 463.6,
  "speechStart": 463.72,
  "speechEnd": 463.92,
  "text": "Something.",
  "end": 464.76
 },
 {
  "i": 163,
  "start": 464.76,
  "speechStart": 464.88,
  "speechEnd": 466.96,
  "text": "There's only the cold, and the tiredness,",
  "end": 467.54
 },
 {
  "i": 164,
  "start": 467.54,
  "speechStart": 467.66,
  "speechEnd": 470.16,
  "text": "and the sound of Dani's footsteps stopping at the gate.",
  "end": 470.72
 },
 {
  "i": 165,
  "start": 470.72,
  "speechStart": 470.84,
  "speechEnd": 472.16,
  "text": "Then your legs stop listening.",
  "end": 473.12
 },
 {
  "i": 166,
  "start": 473.12,
  "speechStart": 473.24,
  "speechEnd": 475.58,
  "text": "You fall at the foot of the torii,",
  "end": 475.46
 },
 {
  "i": 167,
  "start": 475.46,
  "speechStart": 475.58,
  "speechEnd": 477.48,
  "text": "behind a pillar, and nobody knows.",
  "end": 477.36
 },
 {
  "i": 168,
  "start": 477.36,
  "speechStart": 477.48,
  "speechEnd": 479.78,
  "text": "Dani is calling your name.",
  "end": 480.26
 },
 {
  "i": 169,
  "start": 480.26,
  "speechStart": 480.38,
  "speechEnd": 483.74,
  "text": "Her scanner shows the curse is gone, and it shows nothing else.",
  "end": 484.24
 },
 {
  "i": 170,
  "start": 484.24,
  "speechStart": 484.36,
  "speechEnd": 485.14,
  "text": "It shows no one.",
  "end": 485.86
 },
 {
  "i": 171,
  "start": 485.86,
  "speechStart": 485.98,
  "speechEnd": 488.64,
  "text": "In the story, that's what made Toji so frightening.",
  "end": 489.12
 },
 {
  "i": 172,
  "start": 489.12,
  "speechStart": 489.24,
  "speechEnd": 490.18,
  "text": "Nothing could find him.",
  "end": 490.74
 },
 {
  "i": 173,
  "start": 490.74,
  "speechStart": 490.86,
  "speechEnd": 493.8,
  "text": "In your version, that's exactly what's about to kill you.",
  "end": 493.68
 },
 {
  "i": 174,
  "start": 493.68,
  "speechStart": 493.8,
  "speechEnd": 496.34,
  "text": "Dani throws the scanner down.",
  "end": 496.78
 },
 {
  "i": 175,
  "start": 496.78,
  "speechStart": 496.9,
  "speechEnd": 498.06,
  "text": "She stops trying to feel you.",
  "end": 498.38
 },
 {
  "i": 176,
  "start": 498.38,
  "speechStart": 498.5,
  "speechEnd": 501.86,
  "text": "She starts listening instead. She hears the chain,",
  "end": 502.12
 },
 {
  "i": 177,
  "start": 502.12,
  "speechStart": 502.24,
  "speechEnd": 504.68,
  "text": "dragging softly against the stone, as you breathe.",
  "end": 505.36
 },
 {
  "i": 178,
  "start": 505.36,
  "speechStart": 505.48,
  "speechEnd": 508.02,
  "text": "She hears your breath, which is thin and fast.",
  "end": 508.74
 },
 {
  "i": 179,
  "start": 508.74,
  "speechStart": 508.86,
  "speechEnd": 512.0,
  "text": "She follows it, the way you followed a heartbeat through a wall.",
  "end": 512.88
 },
 {
  "i": 180,
  "start": 512.88,
  "speechStart": 513.0,
  "speechEnd": 515.78,
  "text": "She climbs the steps two at a time. She trips.",
  "end": 516.04
 },
 {
  "i": 181,
  "start": 516.04,
  "speechStart": 516.16,
  "speechEnd": 517.22,
  "text": "She gets up and keeps going.",
  "end": 518.04
 },
 {
  "i": 182,
  "start": 518.04,
  "speechStart": 518.16,
  "speechEnd": 521.62,
  "text": "Our guess is that being found has never really needed energy.",
  "end": 521.96
 },
 {
  "i": 183,
  "start": 521.96,
  "speechStart": 522.08,
  "speechEnd": 526.02,
  "text": "It only needs someone who won't stop looking. She reaches the pillar.",
  "end": 526.7
 },
 {
  "i": 184,
  "start": 526.7,
  "speechStart": 526.82,
  "speechEnd": 529.36,
  "text": "Her hand finds your jacket before her eyes find you.",
  "end": 529.94
 },
 {
  "i": 185,
  "start": 529.94,
  "speechStart": 530.06,
  "speechEnd": 531.7,
  "text": "You wake up on the stairs,",
  "end": 531.92
 },
 {
  "i": 186,
  "start": 531.92,
  "speechStart": 532.04,
  "speechEnd": 534.22,
  "text": "with a jacket over you that isn't yours.",
  "end": 534.58
 },
 {
  "i": 187,
  "start": 534.58,
  "speechStart": 534.7,
  "speechEnd": 536.56,
  "text": "\"You can't be found,\" Dani says,",
  "end": 536.96
 },
 {
  "i": 188,
  "start": 536.96,
  "speechStart": 537.08,
  "speechEnd": 538.76,
  "text": "\"unless someone really wants to.\"",
  "end": 539.08
 },
 {
  "i": 189,
  "start": 539.08,
  "speechStart": 539.2,
  "speechEnd": 541.24,
  "text": "You laugh, and it hurts, and you don't care.",
  "end": 541.84
 },
 {
  "i": 190,
  "start": 541.84,
  "speechStart": 541.96,
  "speechEnd": 543.76,
  "text": "The scanner on the step still says",
  "end": 543.64
 },
 {
  "i": 191,
  "start": 543.64,
  "speechStart": 543.76,
  "speechEnd": 547.38,
  "text": "zero point zero zero. It always will. Born to hunt.",
  "end": 547.66
 },
 {
  "i": 192,
  "start": 547.66,
  "speechStart": 547.78,
  "speechEnd": 549.86,
  "text": "Never meant to be found. So I'll ask you:",
  "end": 550.28
 },
 {
  "i": 193,
  "start": 550.28,
  "speechStart": 550.4,
  "speechEnd": 553.6,
  "text": "would you keep a body like that, if nobody could ever sense you again?",
  "end": 554.08
 },
 {
  "i": 194,
  "start": 554.08,
  "speechStart": 554.2,
  "speechEnd": 554.92,
  "text": "Tell me in the comments.",
  "end": 555.32
 },
 {
  "i": 195,
  "start": 555.32,
  "speechStart": 555.44,
  "speechEnd": 558.12,
  "text": "And if you want the next one, tell me who you want to become.",
  "end": 559.72
 }
]