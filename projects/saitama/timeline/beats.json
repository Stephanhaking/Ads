[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 2.9,
  "text": "6:15 in the morning. Your alarm goes off,",
  "end": 3.06
 },
 {
  "i": 1,
  "start": 3.06,
  "speechStart": 3.18,
  "speechEnd": 5.44,
  "text": "and you tap the snooze button the way you always do.",
  "end": 5.82
 },
 {
  "i": 2,
  "start": 5.82,
  "speechStart": 5.94,
  "speechEnd": 9.54,
  "text": "The phone goes through the nightstand. Then through the floor.",
  "end": 10.14
 },
 {
  "i": 3,
  "start": 10.14,
  "speechStart": 10.26,
  "speechEnd": 12.96,
  "text": "You hear it land in your downstairs neighbour's kitchen, still ringing.",
  "end": 13.5
 },
 {
  "i": 4,
  "start": 13.5,
  "speechStart": 13.62,
  "speechEnd": 17.72,
  "text": "You sit up. Something feels cold. You touch your head.",
  "end": 18.24
 },
 {
  "i": 5,
  "start": 18.24,
  "speechStart": 18.36,
  "speechEnd": 21.0,
  "text": "There's nothing there. Not a single hair.",
  "end": 22.14
 },
 {
  "i": 6,
  "start": 22.14,
  "speechStart": 22.26,
  "speechEnd": 25.72,
  "text": "Sometime during the night, you got the power of Saitama.",
  "end": 25.6
 },
 {
  "i": 7,
  "start": 25.6,
  "speechStart": 25.72,
  "speechEnd": 27.26,
  "text": "One-Punch Man.",
  "end": 27.14
 },
 {
  "i": 8,
  "start": 27.14,
  "speechStart": 27.26,
  "speechEnd": 28.74,
  "text": "No transformation,",
  "end": 29.08
 },
 {
  "i": 9,
  "start": 29.08,
  "speechStart": 29.2,
  "speechEnd": 33.44,
  "text": "no special moves, no gears, no glowing aura. Just this:",
  "end": 34.1
 },
 {
  "i": 10,
  "start": 34.1,
  "speechStart": 34.22,
  "speechEnd": 35.86,
  "text": "anything you hit with real",
  "end": 35.74
 },
 {
  "i": 11,
  "start": 35.74,
  "speechStart": 35.86,
  "speechEnd": 39.28,
  "text": "intent goes down in one punch. Anything.",
  "end": 40.62
 },
 {
  "i": 12,
  "start": 40.62,
  "speechStart": 40.74,
  "speechEnd": 43.24,
  "text": "Within a few months you'll be the strongest person",
  "end": 43.12
 },
 {
  "i": 13,
  "start": 43.12,
  "speechStart": 43.24,
  "speechEnd": 44.3,
  "text": "who has ever lived.",
  "end": 44.66
 },
 {
  "i": 14,
  "start": 44.66,
  "speechStart": 44.78,
  "speechEnd": 46.72,
  "text": "And you'll find out that the hardest thing about",
  "end": 46.6
 },
 {
  "i": 15,
  "start": 46.6,
  "speechStart": 46.72,
  "speechEnd": 48.46,
  "text": "being unbeatable isn't the fighting.",
  "end": 48.98
 },
 {
  "i": 16,
  "start": 48.98,
  "speechStart": 49.1,
  "speechEnd": 52.48,
  "text": "It's everything after. First problem:",
  "end": 53.02
 },
 {
  "i": 17,
  "start": 53.02,
  "speechStart": 53.14,
  "speechEnd": 55.54,
  "text": "everything in your apartment is made of paper now.",
  "end": 55.42
 },
 {
  "i": 18,
  "start": 55.42,
  "speechStart": 55.54,
  "speechEnd": 58.84,
  "text": "You squeeze the toothpaste and it empties in one shot.",
  "end": 59.26
 },
 {
  "i": 19,
  "start": 59.26,
  "speechStart": 59.38,
  "speechEnd": 61.48,
  "text": "You turn the tap and it comes off in your hand.",
  "end": 62.22
 },
 {
  "i": 20,
  "start": 62.22,
  "speechStart": 62.34,
  "speechEnd": 64.64,
  "text": "You pick up a mug and you're holding a handle.",
  "end": 65.58
 },
 {
  "i": 21,
  "start": 65.58,
  "speechStart": 65.7,
  "speechEnd": 67.32,
  "text": "So you learn rule one,",
  "end": 67.56
 },
 {
  "i": 22,
  "start": 67.56,
  "speechStart": 67.68,
  "speechEnd": 69.26,
  "text": "the way Saitama lives it:",
  "end": 69.6
 },
 {
  "i": 23,
  "start": 69.6,
  "speechStart": 69.72,
  "speechEnd": 72.44,
  "text": "your strength doesn't turn off. You do.",
  "end": 72.92
 },
 {
  "i": 24,
  "start": 72.92,
  "speechStart": 73.04,
  "speechEnd": 73.94,
  "text": "You move slowly.",
  "end": 74.5
 },
 {
  "i": 25,
  "start": 74.5,
  "speechStart": 74.62,
  "speechEnd": 76.12,
  "text": "You hold things like they're eggs.",
  "end": 76.78
 },
 {
  "i": 26,
  "start": 76.78,
  "speechStart": 76.9,
  "speechEnd": 78.5,
  "text": "Door handles get one finger.",
  "end": 79.22
 },
 {
  "i": 27,
  "start": 79.22,
  "speechStart": 79.34,
  "speechEnd": 82.76,
  "text": "By lunchtime you can make a cup of tea without destroying the kettle,",
  "end": 82.64
 },
 {
  "i": 28,
  "start": 82.64,
  "speechStart": 82.76,
  "speechEnd": 86.8,
  "text": "and you have never been prouder of anything. And the hair.",
  "end": 87.36
 },
 {
  "i": 29,
  "start": 87.36,
  "speechStart": 87.48,
  "speechEnd": 90.3,
  "text": "Real stress hair loss takes two to four months to show up,",
  "end": 90.44
 },
 {
  "i": 30,
  "start": 90.44,
  "speechStart": 90.56,
  "speechEnd": 91.88,
  "text": "and it usually grows back.",
  "end": 92.6
 },
 {
  "i": 31,
  "start": 92.6,
  "speechStart": 92.72,
  "speechEnd": 94.48,
  "text": "Yours took one night.",
  "end": 94.96
 },
 {
  "i": 32,
  "start": 94.96,
  "speechStart": 95.08,
  "speechEnd": 96.42,
  "text": "And it's not coming back.",
  "end": 97.6
 },
 {
  "i": 33,
  "start": 97.6,
  "speechStart": 97.72,
  "speechEnd": 99.48,
  "text": "You need to know how strong you are,",
  "end": 99.56
 },
 {
  "i": 34,
  "start": 99.56,
  "speechStart": 99.68,
  "speechEnd": 101.84,
  "text": "so you go to the quietest gym in town",
  "end": 101.72
 },
 {
  "i": 35,
  "start": 101.72,
  "speechStart": 101.84,
  "speechEnd": 106.02,
  "text": "and ask to use the heavy bag. The trainer laughs. You tap it.",
  "end": 105.9
 },
 {
  "i": 36,
  "start": 105.9,
  "speechStart": 106.02,
  "speechEnd": 106.68,
  "text": "Barely.",
  "end": 107.4
 },
 {
  "i": 37,
  "start": 107.4,
  "speechStart": 107.52,
  "speechEnd": 108.98,
  "text": "The bag doesn't swing.",
  "end": 108.86
 },
 {
  "i": 38,
  "start": 108.86,
  "speechStart": 108.98,
  "speechEnd": 111.3,
  "text": "It tears off the chain,",
  "end": 111.6
 },
 {
  "i": 39,
  "start": 111.6,
  "speechStart": 111.72,
  "speechEnd": 114.96,
  "text": "goes through the wall, and lands in the car park outside.",
  "end": 116.38
 },
 {
  "i": 40,
  "start": 116.38,
  "speechStart": 116.5,
  "speechEnd": 117.8,
  "text": "So you learn rule two.",
  "end": 118.36
 },
 {
  "i": 41,
  "start": 118.36,
  "speechStart": 118.48,
  "speechEnd": 120.78,
  "text": "With Saitama there are two kinds of punches:",
  "end": 121.16
 },
 {
  "i": 42,
  "start": 121.16,
  "speechStart": 121.28,
  "speechEnd": 123.62,
  "text": "the normal one, which is already too much,",
  "end": 123.8
 },
 {
  "i": 43,
  "start": 123.8,
  "speechStart": 123.92,
  "speechEnd": 125.08,
  "text": "and the serious one,",
  "end": 125.34
 },
 {
  "i": 44,
  "start": 125.34,
  "speechStart": 125.46,
  "speechEnd": 128.26,
  "text": "which you never want to find out about indoors.",
  "end": 128.8
 },
 {
  "i": 45,
  "start": 128.8,
  "speechStart": 128.92,
  "speechEnd": 131.1,
  "text": "You go home and practise holding back on a pillow.",
  "end": 131.68
 },
 {
  "i": 46,
  "start": 131.68,
  "speechStart": 131.8,
  "speechEnd": 133.08,
  "text": "Then on a mattress.",
  "end": 134.06
 },
 {
  "i": 47,
  "start": 134.06,
  "speechStart": 134.18,
  "speechEnd": 135.56,
  "text": "Then you buy a new mattress.",
  "end": 136.3
 },
 {
  "i": 48,
  "start": 136.3,
  "speechStart": 136.42,
  "speechEnd": 139.64,
  "text": "On day five you test your speed somewhere safe:",
  "end": 140.02
 },
 {
  "i": 49,
  "start": 140.02,
  "speechStart": 140.14,
  "speechEnd": 143.4,
  "text": "an empty field, nobody around. You punch the air.",
  "end": 143.6
 },
 {
  "i": 50,
  "start": 143.6,
  "speechStart": 143.72,
  "speechEnd": 145.3,
  "text": "Not at anything. Just the air.",
  "end": 145.76
 },
 {
  "i": 51,
  "start": 145.76,
  "speechStart": 145.88,
  "speechEnd": 147.7,
  "text": "There's a crack like a gunshot,",
  "end": 147.58
 },
 {
  "i": 52,
  "start": 147.58,
  "speechStart": 147.7,
  "speechEnd": 150.68,
  "text": "and every car alarm in the street behind you goes off.",
  "end": 151.7
 },
 {
  "i": 53,
  "start": 151.7,
  "speechStart": 151.82,
  "speechEnd": 153.94,
  "text": "The fastest punches ever measured in a lab",
  "end": 153.82
 },
 {
  "i": 54,
  "start": 153.82,
  "speechStart": 153.94,
  "speechEnd": 155.92,
  "text": "hit about 12 metres per second.",
  "end": 156.38
 },
 {
  "i": 55,
  "start": 156.38,
  "speechStart": 156.5,
  "speechEnd": 159.44,
  "text": "To make that crack, your fist broke the sound barrier,",
  "end": 159.32
 },
 {
  "i": 56,
  "start": 159.32,
  "speechStart": 159.44,
  "speechEnd": 161.92,
  "text": "around 343 metres per second.",
  "end": 162.06
 },
 {
  "i": 57,
  "start": 162.06,
  "speechStart": 162.18,
  "speechEnd": 164.06,
  "text": "That's nearly thirty times faster,",
  "end": 163.94
 },
 {
  "i": 58,
  "start": 163.94,
  "speechStart": 164.06,
  "speechEnd": 166.3,
  "text": "and about eight hundred times the energy.",
  "end": 166.68
 },
 {
  "i": 59,
  "start": 166.68,
  "speechStart": 166.8,
  "speechEnd": 169.36,
  "text": "You punched the sky, and the sky complained.",
  "end": 170.0
 },
 {
  "i": 60,
  "start": 170.0,
  "speechStart": 170.12,
  "speechEnd": 171.34,
  "text": "Somebody filmed it from a balcony.",
  "end": 172.44
 },
 {
  "i": 61,
  "start": 172.44,
  "speechStart": 172.56,
  "speechEnd": 175.58,
  "text": "By day nine the video has twelve million views.",
  "end": 176.22
 },
 {
  "i": 62,
  "start": 176.22,
  "speechStart": 176.34,
  "speechEnd": 179.66,
  "text": "The comments are split right down the middle. Half of them say it's CGI.",
  "end": 180.22
 },
 {
  "i": 63,
  "start": 180.22,
  "speechStart": 180.34,
  "speechEnd": 184.34,
  "text": "The other half say it's CGI, but good CGI. Nobody believes you.",
  "end": 184.66
 },
 {
  "i": 64,
  "start": 184.66,
  "speechStart": 184.78,
  "speechEnd": 185.84,
  "text": "That's the strange part.",
  "end": 186.18
 },
 {
  "i": 65,
  "start": 186.18,
  "speechStart": 186.3,
  "speechEnd": 189.3,
  "text": "You can stop a truck, but you can't stop people saying you're fake.",
  "end": 190.24
 },
 {
  "i": 66,
  "start": 190.24,
  "speechStart": 190.36,
  "speechEnd": 193.5,
  "text": "You find out that being strong in real life doesn't come with an audience.",
  "end": 194.28
 },
 {
  "i": 67,
  "start": 194.28,
  "speechStart": 194.4,
  "speechEnd": 197.0,
  "text": "It comes with a landlord asking who is paying for the wall.",
  "end": 198.1
 },
 {
  "i": 68,
  "start": 198.1,
  "speechStart": 198.22,
  "speechEnd": 200.78,
  "text": "On day twelve you try to live a normal life.",
  "end": 201.28
 },
 {
  "i": 69,
  "start": 201.28,
  "speechStart": 201.4,
  "speechEnd": 202.52,
  "text": "You have a job interview at nine.",
  "end": 203.04
 },
 {
  "i": 70,
  "start": 203.04,
  "speechStart": 203.16,
  "speechEnd": 204.94,
  "text": "The interviewer reaches out to shake your hand,",
  "end": 205.56
 },
 {
  "i": 71,
  "start": 205.56,
  "speechStart": 205.68,
  "speechEnd": 207.98,
  "text": "and you spend the longest second of your",
  "end": 207.86
 },
 {
  "i": 72,
  "start": 207.86,
  "speechStart": 207.98,
  "speechEnd": 210.44,
  "text": "life deciding how hard a handshake is.",
  "end": 211.18
 },
 {
  "i": 73,
  "start": 211.18,
  "speechStart": 211.3,
  "speechEnd": 214.2,
  "text": "You go with \"dead fish\". He winces anyway.",
  "end": 214.84
 },
 {
  "i": 74,
  "start": 214.84,
  "speechStart": 214.96,
  "speechEnd": 215.98,
  "text": "Then the coffee machine jams,",
  "end": 216.72
 },
 {
  "i": 75,
  "start": 216.72,
  "speechStart": 216.84,
  "speechEnd": 220.94,
  "text": "everyone sighs, and you give it a little tap to help. It works again.",
  "end": 221.5
 },
 {
  "i": 76,
  "start": 221.5,
  "speechStart": 221.62,
  "speechEnd": 224.56,
  "text": "It's also now part of the wall. You don't get the job.",
  "end": 225.06
 },
 {
  "i": 77,
  "start": 225.06,
  "speechStart": 225.18,
  "speechEnd": 227.44,
  "text": "On the way out, the security guard asks for a selfie.",
  "end": 228.54
 },
 {
  "i": 78,
  "start": 228.54,
  "speechStart": 228.66,
  "speechEnd": 231.24,
  "text": "On day seventeen you're walking home from the supermarket",
  "end": 231.12
 },
 {
  "i": 79,
  "start": 231.12,
  "speechStart": 231.24,
  "speechEnd": 233.48,
  "text": "when a crane on a building site snaps.",
  "end": 234.08
 },
 {
  "i": 80,
  "start": 234.08,
  "speechStart": 234.2,
  "speechEnd": 236.12,
  "text": "A load of steel beams is falling toward",
  "end": 236.0
 },
 {
  "i": 81,
  "start": 236.0,
  "speechStart": 236.12,
  "speechEnd": 239.48,
  "text": "a bus stop full of people. You don't think.",
  "end": 239.84
 },
 {
  "i": 82,
  "start": 239.84,
  "speechStart": 239.96,
  "speechEnd": 242.34,
  "text": "You jump. You catch the first beam,",
  "end": 242.34
 },
 {
  "i": 83,
  "start": 242.34,
  "speechStart": 242.46,
  "speechEnd": 244.94,
  "text": "punch the second one sideways into the empty lot,",
  "end": 244.82
 },
 {
  "i": 84,
  "start": 244.82,
  "speechStart": 244.94,
  "speechEnd": 247.82,
  "text": "and set the third one down on the pavement like a sofa.",
  "end": 247.7
 },
 {
  "i": 85,
  "start": 247.7,
  "speechStart": 247.82,
  "speechEnd": 249.12,
  "text": "Nobody is hurt.",
  "end": 249.6
 },
 {
  "i": 86,
  "start": 249.6,
  "speechStart": 249.72,
  "speechEnd": 251.42,
  "text": "It takes about four seconds.",
  "end": 252.72
 },
 {
  "i": 87,
  "start": 252.72,
  "speechStart": 252.84,
  "speechEnd": 255.76,
  "text": "When the news arrives, a man in a shiny costume",
  "end": 255.64
 },
 {
  "i": 88,
  "start": 255.64,
  "speechStart": 255.76,
  "speechEnd": 258.14,
  "text": "who arrived ten minutes later is giving interviews.",
  "end": 258.5
 },
 {
  "i": 89,
  "start": 258.5,
  "speechStart": 258.62,
  "speechEnd": 261.44,
  "text": "You're holding a bag of groceries with the eggs still intact.",
  "end": 262.02
 },
 {
  "i": 90,
  "start": 262.02,
  "speechStart": 262.14,
  "speechEnd": 265.94,
  "text": "You decide that counts as a win. After the crane,",
  "end": 266.14
 },
 {
  "i": 91,
  "start": 266.14,
  "speechStart": 266.26,
  "speechEnd": 268.52,
  "text": "your oldest friend shows up at your door at",
  "end": 268.4
 },
 {
  "i": 92,
  "start": 268.4,
  "speechStart": 268.52,
  "speechEnd": 270.94,
  "text": "five in the morning in running gear.",
  "end": 271.44
 },
 {
  "i": 93,
  "start": 271.44,
  "speechStart": 271.56,
  "speechEnd": 273.5,
  "text": "\"Teach me,\" they say. \"The routine.",
  "end": 274.14
 },
 {
  "i": 94,
  "start": 274.14,
  "speechStart": 274.26,
  "speechEnd": 276.2,
  "text": "A hundred push-ups, a hundred sit-ups,",
  "end": 276.08
 },
 {
  "i": 95,
  "start": 276.08,
  "speechStart": 276.2,
  "speechEnd": 279.4,
  "text": "a hundred squats, ten kilometres. Every day.\"",
  "end": 279.88
 },
 {
  "i": 96,
  "start": 279.88,
  "speechStart": 280.0,
  "speechEnd": 282.88,
  "text": "So you train together. And here's the thing:",
  "end": 283.2
 },
 {
  "i": 97,
  "start": 283.2,
  "speechStart": 283.32,
  "speechEnd": 284.22,
  "text": "in real life,",
  "end": 284.36
 },
 {
  "i": 98,
  "start": 284.36,
  "speechStart": 284.48,
  "speechEnd": 287.3,
  "text": "that routine works, for a while.",
  "end": 287.78
 },
 {
  "i": 99,
  "start": 287.78,
  "speechStart": 287.9,
  "speechEnd": 289.96,
  "text": "You get fitter fast in the first weeks,",
  "end": 290.24
 },
 {
  "i": 100,
  "start": 290.24,
  "speechStart": 290.36,
  "speechEnd": 291.8,
  "text": "then the progress slows down,",
  "end": 292.42
 },
 {
  "i": 101,
  "start": 292.42,
  "speechStart": 292.54,
  "speechEnd": 294.74,
  "text": "and months of the same hundred push-ups is",
  "end": 294.62
 },
 {
  "i": 102,
  "start": 294.62,
  "speechStart": 294.74,
  "speechEnd": 297.32,
  "text": "how a lot of people end up with sore elbows and shoulders.",
  "end": 298.2
 },
 {
  "i": 103,
  "start": 298.2,
  "speechStart": 298.32,
  "speechEnd": 301.4,
  "text": "After three weeks your friend can run ten kilometres without stopping.",
  "end": 301.84
 },
 {
  "i": 104,
  "start": 301.84,
  "speechStart": 301.96,
  "speechEnd": 305.12,
  "text": "They're proud. They should be. They still can't lift a car.",
  "end": 305.82
 },
 {
  "i": 105,
  "start": 305.82,
  "speechStart": 305.94,
  "speechEnd": 309.42,
  "text": "They ask what your secret really is. You honestly don't know.",
  "end": 310.66
 },
 {
  "i": 106,
  "start": 310.66,
  "speechStart": 310.78,
  "speechEnd": 312.38,
  "text": "On day thirty,",
  "end": 312.26
 },
 {
  "i": 107,
  "start": 312.26,
  "speechStart": 312.38,
  "speechEnd": 315.44,
  "text": "two people in grey suits knock on your door. Very polite.",
  "end": 316.06
 },
 {
  "i": 108,
  "start": 316.06,
  "speechStart": 316.18,
  "speechEnd": 317.64,
  "text": "They'd like to run a few tests.",
  "end": 318.28
 },
 {
  "i": 109,
  "start": 318.28,
  "speechStart": 318.4,
  "speechEnd": 322.08,
  "text": "They bring a machine that measures punching force. You hit it gently.",
  "end": 322.62
 },
 {
  "i": 110,
  "start": 322.62,
  "speechStart": 322.74,
  "speechEnd": 325.08,
  "text": "It stops working. They bring a bigger one.",
  "end": 324.96
 },
 {
  "i": 111,
  "start": 324.96,
  "speechStart": 325.08,
  "speechEnd": 326.32,
  "text": "Same thing.",
  "end": 326.62
 },
 {
  "i": 112,
  "start": 326.62,
  "speechStart": 326.74,
  "speechEnd": 329.3,
  "text": "They bring a block of steel the size of a fridge,",
  "end": 329.18
 },
 {
  "i": 113,
  "start": 329.18,
  "speechStart": 329.3,
  "speechEnd": 331.74,
  "text": "and it folds like a napkin.",
  "end": 332.5
 },
 {
  "i": 114,
  "start": 332.5,
  "speechStart": 332.62,
  "speechEnd": 334.44,
  "text": "At the end of the day they don't have a number.",
  "end": 335.0
 },
 {
  "i": 115,
  "start": 335.0,
  "speechStart": 335.12,
  "speechEnd": 338.7,
  "text": "They have a report with one line: \"Upper limit: not found.\"",
  "end": 339.26
 },
 {
  "i": 116,
  "start": 339.26,
  "speechStart": 339.38,
  "speechEnd": 343.28,
  "text": "And you notice something. You're not nervous. You're not even curious.",
  "end": 344.14
 },
 {
  "i": 117,
  "start": 344.14,
  "speechStart": 344.26,
  "speechEnd": 347.6,
  "text": "You're checking the time, because the supermarket has a sale at six.",
  "end": 348.68
 },
 {
  "i": 118,
  "start": 348.68,
  "speechStart": 348.8,
  "speechEnd": 352.12,
  "text": "Word gets around. Fighters start showing up.",
  "end": 352.62
 },
 {
  "i": 119,
  "start": 352.62,
  "speechStart": 352.74,
  "speechEnd": 353.8,
  "text": "Boxers, wrestlers,",
  "end": 354.42
 },
 {
  "i": 120,
  "start": 354.42,
  "speechStart": 354.54,
  "speechEnd": 357.5,
  "text": "a man who has trained in the mountains for twelve years.",
  "end": 358.22
 },
 {
  "i": 121,
  "start": 358.22,
  "speechStart": 358.34,
  "speechEnd": 359.78,
  "text": "Each of them gets one tap.",
  "end": 360.3
 },
 {
  "i": 122,
  "start": 360.3,
  "speechStart": 360.42,
  "speechEnd": 362.34,
  "text": "You start apologising before you even swing.",
  "end": 363.04
 },
 {
  "i": 123,
  "start": 363.04,
  "speechStart": 363.16,
  "speechEnd": 366.26,
  "text": "One of them asks you to fight seriously, just once.",
  "end": 366.86
 },
 {
  "i": 124,
  "start": 366.86,
  "speechStart": 366.98,
  "speechEnd": 367.52,
  "text": "You can't.",
  "end": 368.08
 },
 {
  "i": 125,
  "start": 368.08,
  "speechStart": 368.2,
  "speechEnd": 370.46,
  "text": "If you did, there would be no one left to ask.",
  "end": 371.54
 },
 {
  "i": 126,
  "start": 371.54,
  "speechStart": 371.66,
  "speechEnd": 374.48,
  "text": "By day sixty you've stopped trying to prove anything.",
  "end": 374.74
 },
 {
  "i": 127,
  "start": 374.74,
  "speechStart": 374.86,
  "speechEnd": 375.56,
  "text": "You just help.",
  "end": 375.98
 },
 {
  "i": 128,
  "start": 375.98,
  "speechStart": 376.1,
  "speechEnd": 378.3,
  "text": "A car stuck in a flooded underpass at night:",
  "end": 378.54
 },
 {
  "i": 129,
  "start": 378.54,
  "speechStart": 378.66,
  "speechEnd": 381.42,
  "text": "you carry it out, with the family still inside,",
  "end": 381.3
 },
 {
  "i": 130,
  "start": 381.3,
  "speechStart": 381.42,
  "speechEnd": 382.9,
  "text": "and set it down on dry road.",
  "end": 383.34
 },
 {
  "i": 131,
  "start": 383.34,
  "speechStart": 383.46,
  "speechEnd": 386.6,
  "text": "A runaway shopping trolley heading for a busy street: one finger.",
  "end": 387.14
 },
 {
  "i": 132,
  "start": 387.14,
  "speechStart": 387.26,
  "speechEnd": 388.04,
  "text": "A cat on a roof:",
  "end": 388.38
 },
 {
  "i": 133,
  "start": 388.38,
  "speechStart": 388.5,
  "speechEnd": 392.1,
  "text": "you jump, very gently. Nobody films those ones.",
  "end": 392.86
 },
 {
  "i": 134,
  "start": 392.86,
  "speechStart": 392.98,
  "speechEnd": 394.02,
  "text": "Nobody writes about them.",
  "end": 394.52
 },
 {
  "i": 135,
  "start": 394.52,
  "speechStart": 394.64,
  "speechEnd": 397.88,
  "text": "A little kid in a window waves at you, and you wave back,",
  "end": 398.52
 },
 {
  "i": 136,
  "start": 398.52,
  "speechStart": 398.64,
  "speechEnd": 401.54,
  "text": "and that's the whole reward. It should feel like enough.",
  "end": 402.18
 },
 {
  "i": 137,
  "start": 402.18,
  "speechStart": 402.3,
  "speechEnd": 403.0,
  "text": "Some nights it does.",
  "end": 403.84
 },
 {
  "i": 138,
  "start": 403.84,
  "speechStart": 403.96,
  "speechEnd": 406.2,
  "text": "This is the part nobody warns you about.",
  "end": 406.52
 },
 {
  "i": 139,
  "start": 406.52,
  "speechStart": 406.64,
  "speechEnd": 409.58,
  "text": "At first, winning felt amazing. Then it felt normal.",
  "end": 410.14
 },
 {
  "i": 140,
  "start": 410.14,
  "speechStart": 410.26,
  "speechEnd": 411.44,
  "text": "Then it felt like nothing.",
  "end": 412.24
 },
 {
  "i": 141,
  "start": 412.24,
  "speechStart": 412.36,
  "speechEnd": 414.46,
  "text": "Psychologists call it hedonic adaptation:",
  "end": 414.94
 },
 {
  "i": 142,
  "start": 414.94,
  "speechStart": 415.06,
  "speechEnd": 416.52,
  "text": "we get used to almost anything,",
  "end": 416.7
 },
 {
  "i": 143,
  "start": 416.7,
  "speechStart": 416.82,
  "speechEnd": 418.68,
  "text": "good or bad, and the thrill fades.",
  "end": 419.22
 },
 {
  "i": 144,
  "start": 419.22,
  "speechStart": 419.34,
  "speechEnd": 423.14,
  "text": "Saitama's real enemy was never a monster. It was boredom.",
  "end": 424.7
 },
 {
  "i": 145,
  "start": 424.7,
  "speechStart": 424.82,
  "speechEnd": 426.72,
  "text": "Every fight ends before it starts.",
  "end": 427.32
 },
 {
  "i": 146,
  "start": 427.32,
  "speechStart": 427.44,
  "speechEnd": 429.22,
  "text": "Every video game feels slow.",
  "end": 429.88
 },
 {
  "i": 147,
  "start": 429.88,
  "speechStart": 430.0,
  "speechEnd": 432.16,
  "text": "Every danger looks like it's standing still.",
  "end": 432.8
 },
 {
  "i": 148,
  "start": 432.8,
  "speechStart": 432.92,
  "speechEnd": 435.62,
  "text": "You'd give anything for one opponent who makes you sweat,",
  "end": 435.5
 },
 {
  "i": 149,
  "start": 435.5,
  "speechStart": 435.62,
  "speechEnd": 438.32,
  "text": "just once, to remember what it felt like to try.",
  "end": 439.16
 },
 {
  "i": 150,
  "start": 439.16,
  "speechStart": 439.28,
  "speechEnd": 442.62,
  "text": "You stop setting goals, because every goal is already done.",
  "end": 443.14
 },
 {
  "i": 151,
  "start": 443.14,
  "speechStart": 443.26,
  "speechEnd": 446.64,
  "text": "You stop telling people about your day, because your day is always the same:",
  "end": 447.24
 },
 {
  "i": 152,
  "start": 447.24,
  "speechStart": 447.36,
  "speechEnd": 449.78,
  "text": "something happens, you hit it once, it's over.",
  "end": 450.26
 },
 {
  "i": 153,
  "start": 450.26,
  "speechStart": 450.38,
  "speechEnd": 452.16,
  "text": "The strongest person in the world,",
  "end": 452.62
 },
 {
  "i": 154,
  "start": 452.62,
  "speechStart": 452.74,
  "speechEnd": 454.88,
  "text": "and the thing you miss most is losing.",
  "end": 456.06
 },
 {
  "i": 155,
  "start": 456.06,
  "speechStart": 456.18,
  "speechEnd": 458.38,
  "text": "One night, just to feel something,",
  "end": 458.52
 },
 {
  "i": 156,
  "start": 458.52,
  "speechStart": 458.64,
  "speechEnd": 462.26,
  "text": "you go to an empty beach and jump. Not a careful jump.",
  "end": 462.5
 },
 {
  "i": 157,
  "start": 462.5,
  "speechStart": 462.62,
  "speechEnd": 463.38,
  "text": "A real one.",
  "end": 463.26
 },
 {
  "i": 158,
  "start": 463.26,
  "speechStart": 463.38,
  "speechEnd": 465.3,
  "text": "The ground cracks.",
  "end": 466.0
 },
 {
  "i": 159,
  "start": 466.0,
  "speechStart": 466.12,
  "speechEnd": 468.24,
  "text": "The clouds go past like you're in an elevator.",
  "end": 468.66
 },
 {
  "i": 160,
  "start": 468.66,
  "speechStart": 468.78,
  "speechEnd": 470.8,
  "text": "Then the sky turns black,",
  "end": 471.44
 },
 {
  "i": 161,
  "start": 471.44,
  "speechStart": 471.56,
  "speechEnd": 473.74,
  "text": "and below you there's the curve of the Earth,",
  "end": 474.28
 },
 {
  "i": 162,
  "start": 474.28,
  "speechStart": 474.4,
  "speechEnd": 476.16,
  "text": "blue and white and silent.",
  "end": 476.76
 },
 {
  "i": 163,
  "start": 476.76,
  "speechStart": 476.88,
  "speechEnd": 480.36,
  "text": "To leave Earth for good you'd need about eleven kilometres per second.",
  "end": 480.82
 },
 {
  "i": 164,
  "start": 480.82,
  "speechStart": 480.94,
  "speechEnd": 482.04,
  "text": "You don't know if you went that fast.",
  "end": 482.66
 },
 {
  "i": 165,
  "start": 482.66,
  "speechStart": 482.78,
  "speechEnd": 485.94,
  "text": "You know you're falling back, and for about twenty seconds,",
  "end": 486.38
 },
 {
  "i": 166,
  "start": 486.38,
  "speechStart": 486.5,
  "speechEnd": 488.36,
  "text": "falling feels like the most exciting",
  "end": 488.24
 },
 {
  "i": 167,
  "start": 488.24,
  "speechStart": 488.36,
  "speechEnd": 492.34,
  "text": "thing that has happened to you in months. You land in the ocean.",
  "end": 492.22
 },
 {
  "i": 168,
  "start": 492.22,
  "speechStart": 492.34,
  "speechEnd": 496.44,
  "text": "It takes you an hour to swim home. You smile the whole way.",
  "end": 497.4
 },
 {
  "i": 169,
  "start": 497.4,
  "speechStart": 497.52,
  "speechEnd": 499.74,
  "text": "And then, on day one hundred",
  "end": 499.62
 },
 {
  "i": 170,
  "start": 499.62,
  "speechStart": 499.74,
  "speechEnd": 502.28,
  "text": "and twenty, the sky turns red.",
  "end": 502.88
 },
 {
  "i": 171,
  "start": 502.88,
  "speechStart": 503.0,
  "speechEnd": 504.44,
  "text": "Something is coming in from space,",
  "end": 504.82
 },
 {
  "i": 172,
  "start": 504.82,
  "speechStart": 504.94,
  "speechEnd": 506.68,
  "text": "a rock the size of a stadium,",
  "end": 507.1
 },
 {
  "i": 173,
  "start": 507.1,
  "speechStart": 507.22,
  "speechEnd": 509.32,
  "text": "and every government on Earth runs",
  "end": 509.2
 },
 {
  "i": 174,
  "start": 509.2,
  "speechStart": 509.32,
  "speechEnd": 512.88,
  "text": "out of time at the same moment. For the first time in months,",
  "end": 513.46
 },
 {
  "i": 175,
  "start": 513.46,
  "speechStart": 513.58,
  "speechEnd": 514.58,
  "text": "your heart is pounding.",
  "end": 515.48
 },
 {
  "i": 176,
  "start": 515.48,
  "speechStart": 515.6,
  "speechEnd": 517.16,
  "text": "Millions of people are looking up,",
  "end": 517.58
 },
 {
  "i": 177,
  "start": 517.58,
  "speechStart": 517.7,
  "speechEnd": 521.12,
  "text": "and for once, so are you. Not because you're scared.",
  "end": 521.0
 },
 {
  "i": 178,
  "start": 521.0,
  "speechStart": 521.12,
  "speechEnd": 522.8,
  "text": "Because, finally,",
  "end": 523.2
 },
 {
  "i": 179,
  "start": 523.2,
  "speechStart": 523.32,
  "speechEnd": 526.42,
  "text": "something is coming that might actually be a fight.",
  "end": 527.38
 },
 {
  "i": 180,
  "start": 527.38,
  "speechStart": 527.5,
  "speechEnd": 527.96,
  "text": "You jump.",
  "end": 528.66
 },
 {
  "i": 181,
  "start": 528.66,
  "speechStart": 528.78,
  "speechEnd": 530.32,
  "text": "You meet it above the clouds,",
  "end": 530.44
 },
 {
  "i": 182,
  "start": 530.44,
  "speechStart": 530.56,
  "speechEnd": 533.68,
  "text": "and for one second you throw a serious punch.",
  "end": 534.26
 },
 {
  "i": 183,
  "start": 534.26,
  "speechStart": 534.38,
  "speechEnd": 536.84,
  "text": "The rock turns into gravel and dust.",
  "end": 537.6
 },
 {
  "i": 184,
  "start": 537.6,
  "speechStart": 537.72,
  "speechEnd": 541.48,
  "text": "A few pieces still rain down on the city. A few roofs get holes,",
  "end": 541.76
 },
 {
  "i": 185,
  "start": 541.76,
  "speechStart": 541.88,
  "speechEnd": 544.78,
  "text": "a few cars get dents. Nobody dies.",
  "end": 545.36
 },
 {
  "i": 186,
  "start": 545.36,
  "speechStart": 545.48,
  "speechEnd": 548.6,
  "text": "The next morning a headline asks who will pay for the damage.",
  "end": 548.48
 },
 {
  "i": 187,
  "start": 548.48,
  "speechStart": 548.6,
  "speechEnd": 552.64,
  "text": "So you do what Saitama does. You go shopping.",
  "end": 553.64
 },
 {
  "i": 188,
  "start": 553.64,
  "speechStart": 553.76,
  "speechEnd": 554.38,
  "text": "Eggs are half price,",
  "end": 555.16
 },
 {
  "i": 189,
  "start": 555.16,
  "speechStart": 555.28,
  "speechEnd": 557.36,
  "text": "and for some reason that makes you",
  "end": 557.24
 },
 {
  "i": 190,
  "start": 557.24,
  "speechStart": 557.36,
  "speechEnd": 559.48,
  "text": "happier than saving the planet did.",
  "end": 560.32
 },
 {
  "i": 191,
  "start": 560.32,
  "speechStart": 560.44,
  "speechEnd": 563.42,
  "text": "That night, you set your alarm for 6:15.",
  "end": 563.3
 },
 {
  "i": 192,
  "start": 563.3,
  "speechStart": 563.42,
  "speechEnd": 564.66,
  "text": "In the morning it rings,",
  "end": 564.54
 },
 {
  "i": 193,
  "start": 564.54,
  "speechStart": 564.66,
  "speechEnd": 567.56,
  "text": "and you reach out and tap it. Gently.",
  "end": 568.14
 },
 {
  "i": 194,
  "start": 568.14,
  "speechStart": 568.26,
  "speechEnd": 569.12,
  "text": "It stops ringing.",
  "end": 569.68
 },
 {
  "i": 195,
  "start": 569.68,
  "speechStart": 569.8,
  "speechEnd": 573.62,
  "text": "The nightstand is still there. Your friend texts: \"Run tomorrow?",
  "end": 573.5
 },
 {
  "i": 196,
  "start": 573.5,
  "speechStart": 573.62,
  "speechEnd": 577.66,
  "text": "Ten kilometres.\" You say yes. Not because you need it.",
  "end": 577.78
 },
 {
  "i": 197,
  "start": 577.78,
  "speechStart": 577.9,
  "speechEnd": 581.24,
  "text": "Because it's the one thing left that you get to do with someone else.",
  "end": 581.12
 },
 {
  "i": 198,
  "start": 581.12,
  "speechStart": 581.24,
  "speechEnd": 585.52,
  "text": "It's the hardest thing you've learned all year. So:",
  "end": 586.06
 },
 {
  "i": 199,
  "start": 586.06,
  "speechStart": 586.18,
  "speechEnd": 589.12,
  "text": "would you take one punch that wins every fight,",
  "end": 589.0
 },
 {
  "i": 200,
  "start": 589.0,
  "speechStart": 589.12,
  "speechEnd": 592.1,
  "text": "if it meant nothing would ever feel hard again?",
  "end": 592.9
 },
 {
  "i": 201,
  "start": 592.9,
  "speechStart": 593.02,
  "speechEnd": 596.06,
  "text": "And what's the first thing you'd punch? Tell us in the comments.",
  "end": 597.66
 }
]