[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 3.44,
  "text": "You've woken up as Pain, from Naruto. In real life.",
  "end": 3.96
 },
 {
  "i": 1,
  "start": 3.96,
  "speechStart": 4.08,
  "speechEnd": 5.48,
  "text": "Six bodies. One mind.",
  "end": 5.9
 },
 {
  "i": 2,
  "start": 5.9,
  "speechStart": 6.02,
  "speechEnd": 8.03,
  "text": "And a dam above a town of three",
  "end": 7.91
 },
 {
  "i": 3,
  "start": 7.91,
  "speechStart": 8.03,
  "speechEnd": 11.62,
  "text": "thousand people that will break by tonight. In the story,",
  "end": 11.98
 },
 {
  "i": 4,
  "start": 11.98,
  "speechStart": 12.1,
  "speechEnd": 14.84,
  "text": "the Six Paths of Pain are controlled from far away,",
  "end": 15.18
 },
 {
  "i": 5,
  "start": 15.18,
  "speechStart": 15.3,
  "speechEnd": 18.32,
  "text": "and if the one controlling them is interrupted, all of them stop.",
  "end": 18.94
 },
 {
  "i": 6,
  "start": 18.94,
  "speechStart": 19.06,
  "speechEnd": 21.2,
  "text": "In your version, that's the whole day.",
  "end": 21.84
 },
 {
  "i": 7,
  "start": 21.84,
  "speechStart": 21.96,
  "speechEnd": 24.42,
  "text": "Keep the six moving, and don't let one fall.",
  "end": 24.3
 },
 {
  "i": 8,
  "start": 24.3,
  "speechStart": 24.42,
  "speechEnd": 26.14,
  "text": "But first,",
  "end": 26.36
 },
 {
  "i": 9,
  "start": 26.36,
  "speechStart": 26.48,
  "speechEnd": 27.94,
  "text": "it's six fifty-eight in the morning,",
  "end": 28.18
 },
 {
  "i": 10,
  "start": 28.18,
  "speechStart": 28.3,
  "speechEnd": 31.18,
  "text": "and you're looking at yourself from six directions at once.",
  "end": 32.18
 },
 {
  "i": 11,
  "start": 32.18,
  "speechStart": 32.3,
  "speechEnd": 34.32,
  "text": "Each body carries one Path.",
  "end": 34.9
 },
 {
  "i": 12,
  "start": 34.9,
  "speechStart": 35.02,
  "speechEnd": 38.1,
  "text": "The Rinnegan shares what every body sees with the user.",
  "end": 38.3
 },
 {
  "i": 13,
  "start": 38.3,
  "speechStart": 38.42,
  "speechEnd": 40.04,
  "text": "So you see a hillside,",
  "end": 40.3
 },
 {
  "i": 14,
  "start": 40.3,
  "speechStart": 40.42,
  "speechEnd": 42.0,
  "text": "a road, the dam wall,",
  "end": 42.28
 },
 {
  "i": 15,
  "start": 42.28,
  "speechStart": 42.4,
  "speechEnd": 45.84,
  "text": "a river, a field of sheep and the back of your own head,",
  "end": 46.44
 },
 {
  "i": 16,
  "start": 46.44,
  "speechStart": 46.56,
  "speechEnd": 47.46,
  "text": "at the same time.",
  "end": 48.06
 },
 {
  "i": 17,
  "start": 48.06,
  "speechStart": 48.18,
  "speechEnd": 50.32,
  "text": "You taste breakfast in six places.",
  "end": 50.2
 },
 {
  "i": 18,
  "start": 50.2,
  "speechStart": 50.32,
  "speechEnd": 54.22,
  "text": "It's a very small cold toast, repeated six times.",
  "end": 55.16
 },
 {
  "i": 19,
  "start": 55.16,
  "speechStart": 55.28,
  "speechEnd": 56.98,
  "text": "Your real body is in a",
  "end": 56.86
 },
 {
  "i": 20,
  "start": 56.86,
  "speechStart": 56.98,
  "speechEnd": 58.84,
  "text": "small stone room at the top of the valley,",
  "end": 59.16
 },
 {
  "i": 21,
  "start": 59.16,
  "speechStart": 59.28,
  "speechEnd": 62.68,
  "text": "in a chair, very still. Thin. Pale.",
  "end": 63.26
 },
 {
  "i": 22,
  "start": 63.26,
  "speechStart": 63.38,
  "speechEnd": 65.38,
  "text": "A little like a man who's forgotten how to move.",
  "end": 66.06
 },
 {
  "i": 23,
  "start": 66.06,
  "speechStart": 66.18,
  "speechEnd": 68.58,
  "text": "In the story, Nagato's body was weak,",
  "end": 68.78
 },
 {
  "i": 24,
  "start": 68.78,
  "speechStart": 68.9,
  "speechEnd": 71.06,
  "text": "and the six bodies did the walking for him.",
  "end": 71.48
 },
 {
  "i": 25,
  "start": 71.48,
  "speechStart": 71.6,
  "speechEnd": 73.62,
  "text": "In your version, you keep your own face,",
  "end": 74.0
 },
 {
  "i": 26,
  "start": 74.0,
  "speechStart": 74.12,
  "speechEnd": 75.4,
  "text": "and the weak body is yours.",
  "end": 75.28
 },
 {
  "i": 27,
  "start": 75.28,
  "speechStart": 75.4,
  "speechEnd": 79.12,
  "text": "The six are hollow vessels. Nobody's inside them.",
  "end": 79.34
 },
 {
  "i": 28,
  "start": 79.34,
  "speechStart": 79.46,
  "speechEnd": 81.44,
  "text": "Nobody's lost. You blink once.",
  "end": 81.86
 },
 {
  "i": 29,
  "start": 81.86,
  "speechStart": 81.98,
  "speechEnd": 83.6,
  "text": "Six bodies blink six times.",
  "end": 84.14
 },
 {
  "i": 30,
  "start": 84.14,
  "speechStart": 84.26,
  "speechEnd": 85.82,
  "text": "Somewhere, a sheep looks up.",
  "end": 86.52
 },
 {
  "i": 31,
  "start": 86.52,
  "speechStart": 86.64,
  "speechEnd": 88.38,
  "text": "You start with the loudest one.",
  "end": 88.82
 },
 {
  "i": 32,
  "start": 88.82,
  "speechStart": 88.94,
  "speechEnd": 90.52,
  "text": "The Deva Path controls gravity.",
  "end": 90.4
 },
 {
  "i": 33,
  "start": 90.4,
  "speechStart": 90.52,
  "speechEnd": 93.42,
  "text": "Shinra Tensei pushes everything away.",
  "end": 93.3
 },
 {
  "i": 34,
  "start": 93.3,
  "speechStart": 93.42,
  "speechEnd": 95.58,
  "text": "Bansho Ten-in pulls it in.",
  "end": 96.1
 },
 {
  "i": 35,
  "start": 96.1,
  "speechStart": 96.22,
  "speechEnd": 98.1,
  "text": "You raise one hand, in a field,",
  "end": 98.4
 },
 {
  "i": 36,
  "start": 98.4,
  "speechStart": 98.52,
  "speechEnd": 102.0,
  "text": "in front of a tower of wooden crates. The crates leave.",
  "end": 101.88
 },
 {
  "i": 37,
  "start": 101.88,
  "speechStart": 102.0,
  "speechEnd": 103.8,
  "text": "All of them. A hundred meters.",
  "end": 103.68
 },
 {
  "i": 38,
  "start": 103.68,
  "speechStart": 103.8,
  "speechEnd": 106.8,
  "text": "They land in a neat circle, like a snapshot.",
  "end": 107.96
 },
 {
  "i": 39,
  "start": 107.96,
  "speechStart": 108.08,
  "speechEnd": 111.78,
  "text": "After a Shinra Tensei, there's a cooldown. At least five seconds.",
  "end": 112.36
 },
 {
  "i": 40,
  "start": 112.36,
  "speechStart": 112.48,
  "speechEnd": 113.18,
  "text": "During that time,",
  "end": 113.5
 },
 {
  "i": 41,
  "start": 113.5,
  "speechStart": 113.62,
  "speechEnd": 116.14,
  "text": "the Deva Path can't use any of its other abilities either.",
  "end": 116.7
 },
 {
  "i": 42,
  "start": 116.7,
  "speechStart": 116.82,
  "speechEnd": 120.54,
  "text": "The next five seconds are the longest of your life. Nothing happens.",
  "end": 120.42
 },
 {
  "i": 43,
  "start": 120.42,
  "speechStart": 120.54,
  "speechEnd": 124.62,
  "text": "A sheep walks calmly through the empty field. You count:",
  "end": 124.5
 },
 {
  "i": 44,
  "start": 124.5,
  "speechStart": 124.62,
  "speechEnd": 126.24,
  "text": "one, two,",
  "end": 126.58
 },
 {
  "i": 45,
  "start": 126.58,
  "speechStart": 126.7,
  "speechEnd": 128.8,
  "text": "three, four, five.",
  "end": 129.44
 },
 {
  "i": 46,
  "start": 129.44,
  "speechStart": 129.56,
  "speechEnd": 133.7,
  "text": "In your version, you can't cheat the number. It's five. Every time.",
  "end": 134.26
 },
 {
  "i": 47,
  "start": 134.26,
  "speechStart": 134.38,
  "speechEnd": 137.7,
  "text": "And everyone you're protecting has to survive those five seconds on their own.",
  "end": 138.48
 },
 {
  "i": 48,
  "start": 138.48,
  "speechStart": 138.6,
  "speechEnd": 142.48,
  "text": "Lesson one: power isn't the problem. Gaps are.",
  "end": 143.1
 },
 {
  "i": 49,
  "start": 143.1,
  "speechStart": 143.22,
  "speechEnd": 146.56,
  "text": "You walk down into the valley, in six directions at once.",
  "end": 147.04
 },
 {
  "i": 50,
  "start": 147.04,
  "speechStart": 147.16,
  "speechEnd": 149.54,
  "text": "The town below the dam has one bakery,",
  "end": 149.88
 },
 {
  "i": 51,
  "start": 149.88,
  "speechStart": 150.0,
  "speechEnd": 152.7,
  "text": "one school and one very loud radio.",
  "end": 153.3
 },
 {
  "i": 52,
  "start": 153.3,
  "speechStart": 153.42,
  "speechEnd": 155.12,
  "text": "A small boy is on a bicycle,",
  "end": 155.0
 },
 {
  "i": 53,
  "start": 155.0,
  "speechStart": 155.12,
  "speechEnd": 157.18,
  "text": "trying to outrun his own shoelaces.",
  "end": 157.82
 },
 {
  "i": 54,
  "start": 157.82,
  "speechStart": 157.94,
  "speechEnd": 161.42,
  "text": "He looks up and sees six men in black cloaks",
  "end": 161.3
 },
 {
  "i": 55,
  "start": 161.3,
  "speechStart": 161.42,
  "speechEnd": 165.22,
  "text": "and nothing in their eyes but violet rings. He waves.",
  "end": 165.96
 },
 {
  "i": 56,
  "start": 165.96,
  "speechStart": 166.08,
  "speechEnd": 168.52,
  "text": "All six of you wave back, at the same moment,",
  "end": 168.4
 },
 {
  "i": 57,
  "start": 168.4,
  "speechStart": 168.52,
  "speechEnd": 169.72,
  "text": "in the same way,",
  "end": 169.8
 },
 {
  "i": 58,
  "start": 169.8,
  "speechStart": 169.92,
  "speechEnd": 172.04,
  "text": "which is the creepiest thing a body can do.",
  "end": 172.7
 },
 {
  "i": 59,
  "start": 172.7,
  "speechStart": 172.82,
  "speechEnd": 175.76,
  "text": "In your version, the bodies don't have faces of their own.",
  "end": 176.2
 },
 {
  "i": 60,
  "start": 176.2,
  "speechStart": 176.32,
  "speechEnd": 178.32,
  "text": "They have yours, a little stretched,",
  "end": 178.64
 },
 {
  "i": 61,
  "start": 178.64,
  "speechStart": 178.76,
  "speechEnd": 180.3,
  "text": "with orange hair you never chose.",
  "end": 181.08
 },
 {
  "i": 62,
  "start": 181.08,
  "speechStart": 181.2,
  "speechEnd": 182.4,
  "text": "The boy rides away laughing.",
  "end": 182.88
 },
 {
  "i": 63,
  "start": 182.88,
  "speechStart": 183.0,
  "speechEnd": 186.1,
  "text": "You don't know his name, but you know exactly where he lives.",
  "end": 186.58
 },
 {
  "i": 64,
  "start": 186.58,
  "speechStart": 186.7,
  "speechEnd": 188.76,
  "text": "His house is the lowest one on the street.",
  "end": 189.62
 },
 {
  "i": 65,
  "start": 189.62,
  "speechStart": 189.74,
  "speechEnd": 191.46,
  "text": "Ruth is the dam's hydrologist,",
  "end": 191.66
 },
 {
  "i": 66,
  "start": 191.66,
  "speechStart": 191.78,
  "speechEnd": 195.64,
  "text": "and she's very angry at the sky. She finds you at the wall,",
  "end": 196.1
 },
 {
  "i": 67,
  "start": 196.1,
  "speechStart": 196.22,
  "speechEnd": 199.64,
  "text": "six identical men in black cloaks standing around her inspection hut.",
  "end": 200.2
 },
 {
  "i": 68,
  "start": 200.2,
  "speechStart": 200.32,
  "speechEnd": 202.16,
  "text": "She's holding a thermos like a weapon.",
  "end": 202.94
 },
 {
  "i": 69,
  "start": 202.94,
  "speechStart": 203.06,
  "speechEnd": 204.44,
  "text": "\"Whatever you are,\" she says,",
  "end": 204.62
 },
 {
  "i": 70,
  "start": 204.62,
  "speechStart": 204.74,
  "speechEnd": 206.9,
  "text": "\"you have the worst timing in the world.\"",
  "end": 207.72
 },
 {
  "i": 71,
  "start": 207.72,
  "speechStart": 207.84,
  "speechEnd": 209.98,
  "text": "The river has been rising for three days.",
  "end": 209.86
 },
 {
  "i": 72,
  "start": 209.86,
  "speechStart": 209.98,
  "speechEnd": 212.4,
  "text": "There's a hairline crack in the wall,",
  "end": 212.28
 },
 {
  "i": 73,
  "start": 212.28,
  "speechStart": 212.4,
  "speechEnd": 213.96,
  "text": "thirty meters from the top.",
  "end": 214.2
 },
 {
  "i": 74,
  "start": 214.2,
  "speechStart": 214.32,
  "speechEnd": 216.22,
  "text": "It will not hold past midnight.",
  "end": 216.8
 },
 {
  "i": 75,
  "start": 216.8,
  "speechStart": 216.92,
  "speechEnd": 219.58,
  "text": "She's been calling for help since Tuesday. Nobody's coming.",
  "end": 220.18
 },
 {
  "i": 76,
  "start": 220.18,
  "speechStart": 220.3,
  "speechEnd": 223.34,
  "text": "In your version, that's why you're here. Not a battle.",
  "end": 223.78
 },
 {
  "i": 77,
  "start": 223.78,
  "speechStart": 223.9,
  "speechEnd": 226.42,
  "text": "A deadline. \"Prove it,\" she says.",
  "end": 227.1
 },
 {
  "i": 78,
  "start": 227.1,
  "speechStart": 227.22,
  "speechEnd": 230.44,
  "text": "The Deva body flicks a hand, and her hat flies thirty meters,",
  "end": 230.58
 },
 {
  "i": 79,
  "start": 230.58,
  "speechStart": 230.7,
  "speechEnd": 234.18,
  "text": "lands on a fence post and stays there. You tell her you can help.",
  "end": 234.66
 },
 {
  "i": 80,
  "start": 234.66,
  "speechStart": 234.78,
  "speechEnd": 238.24,
  "text": "She laughs, and then she realizes none of your six faces is laughing.",
  "end": 238.12
 },
 {
  "i": 81,
  "start": 238.12,
  "speechStart": 238.24,
  "speechEnd": 241.22,
  "text": "Behind her, a bird lands on the wall.",
  "end": 241.1
 },
 {
  "i": 82,
  "start": 241.1,
  "speechStart": 241.22,
  "speechEnd": 242.84,
  "text": "It's an enormous bird.",
  "end": 242.72
 },
 {
  "i": 83,
  "start": 242.72,
  "speechStart": 242.84,
  "speechEnd": 244.52,
  "text": "You didn't summon it yet.",
  "end": 244.4
 },
 {
  "i": 84,
  "start": 244.4,
  "speechStart": 244.52,
  "speechEnd": 246.86,
  "text": "The Animal Path summons creatures.",
  "end": 246.74
 },
 {
  "i": 85,
  "start": 246.74,
  "speechStart": 246.86,
  "speechEnd": 249.92,
  "text": "You do it to carry sandbags up the face of the dam,",
  "end": 249.8
 },
 {
  "i": 86,
  "start": 249.8,
  "speechStart": 249.92,
  "speechEnd": 252.24,
  "text": "one great animal at a time.",
  "end": 252.12
 },
 {
  "i": 87,
  "start": 252.12,
  "speechStart": 252.24,
  "speechEnd": 253.86,
  "text": "The work splits.",
  "end": 253.74
 },
 {
  "i": 88,
  "start": 253.74,
  "speechStart": 253.86,
  "speechEnd": 255.6,
  "text": "And so do you.",
  "end": 255.48
 },
 {
  "i": 89,
  "start": 255.48,
  "speechStart": 255.6,
  "speechEnd": 258.18,
  "text": "The Asura body bolts a steel plate across",
  "end": 258.06
 },
 {
  "i": 90,
  "start": 258.06,
  "speechStart": 258.18,
  "speechEnd": 260.9,
  "text": "the crack with a hand that unfolds into something metal.",
  "end": 260.78
 },
 {
  "i": 91,
  "start": 260.78,
  "speechStart": 260.9,
  "speechEnd": 263.02,
  "text": "The Asura Path modifies",
  "end": 262.9
 },
 {
  "i": 92,
  "start": 262.9,
  "speechStart": 263.02,
  "speechEnd": 264.76,
  "text": "the body with mechanical parts.",
  "end": 264.64
 },
 {
  "i": 93,
  "start": 264.64,
  "speechStart": 264.76,
  "speechEnd": 267.26,
  "text": "The Preta body stands in the river,",
  "end": 267.14
 },
 {
  "i": 94,
  "start": 267.14,
  "speechStart": 267.26,
  "speechEnd": 269.28,
  "text": "with both hands flat on the water,",
  "end": 269.66
 },
 {
  "i": 95,
  "start": 269.66,
  "speechStart": 269.78,
  "speechEnd": 271.62,
  "text": "drinking the current's energy as it comes.",
  "end": 272.58
 },
 {
  "i": 96,
  "start": 272.58,
  "speechStart": 272.7,
  "speechEnd": 274.2,
  "text": "The Preta Path absorbs energy.",
  "end": 274.76
 },
 {
  "i": 97,
  "start": 274.76,
  "speechStart": 274.88,
  "speechEnd": 277.26,
  "text": "In your version, it takes the force out of the river,",
  "end": 277.14
 },
 {
  "i": 98,
  "start": 277.14,
  "speechStart": 277.26,
  "speechEnd": 278.7,
  "text": "so the wall doesn't have to.",
  "end": 279.34
 },
 {
  "i": 99,
  "start": 279.34,
  "speechStart": 279.46,
  "speechEnd": 282.58,
  "text": "The Deva body pushes debris away from the spillway,",
  "end": 282.46
 },
 {
  "i": 100,
  "start": 282.46,
  "speechStart": 282.58,
  "speechEnd": 285.72,
  "text": "every five seconds, like a very strict metronome.",
  "end": 286.1
 },
 {
  "i": 101,
  "start": 286.1,
  "speechStart": 286.22,
  "speechEnd": 288.32,
  "text": "The Animal body carries things you can't.",
  "end": 288.86
 },
 {
  "i": 102,
  "start": 288.86,
  "speechStart": 288.98,
  "speechEnd": 292.22,
  "text": "The Naraka body stands beside your real one, just in case.",
  "end": 292.94
 },
 {
  "i": 103,
  "start": 292.94,
  "speechStart": 293.06,
  "speechEnd": 294.94,
  "text": "And the Human body waits at the edge of the",
  "end": 294.82
 },
 {
  "i": 104,
  "start": 294.82,
  "speechStart": 294.94,
  "speechEnd": 297.08,
  "text": "field with its hands in its sleeves.",
  "end": 297.9
 },
 {
  "i": 105,
  "start": 297.9,
  "speechStart": 298.02,
  "speechEnd": 301.38,
  "text": "In the story, the Human Path can pull a soul out of someone.",
  "end": 301.94
 },
 {
  "i": 106,
  "start": 301.94,
  "speechStart": 302.06,
  "speechEnd": 305.82,
  "text": "In your version, you don't use that one. Not today. Not ever.",
  "end": 306.24
 },
 {
  "i": 107,
  "start": 306.24,
  "speechStart": 306.36,
  "speechEnd": 308.98,
  "text": "You just keep it where you can see it. In the story,",
  "end": 309.36
 },
 {
  "i": 108,
  "start": 309.36,
  "speechStart": 309.48,
  "speechEnd": 311.88,
  "text": "the Naraka Path is the most valuable of the six.",
  "end": 312.32
 },
 {
  "i": 109,
  "start": 312.32,
  "speechStart": 312.44,
  "speechEnd": 314.78,
  "text": "The others will sacrifice themselves to protect it.",
  "end": 315.36
 },
 {
  "i": 110,
  "start": 315.36,
  "speechStart": 315.48,
  "speechEnd": 317.48,
  "text": "In your version, that's the rule you hate most.",
  "end": 318.02
 },
 {
  "i": 111,
  "start": 318.02,
  "speechStart": 318.14,
  "speechEnd": 320.04,
  "text": "You have to decide which one is worth more.",
  "end": 320.68
 },
 {
  "i": 112,
  "start": 320.68,
  "speechStart": 320.8,
  "speechEnd": 322.04,
  "text": "And it isn't the one you'd choose.",
  "end": 322.54
 },
 {
  "i": 113,
  "start": 322.54,
  "speechStart": 322.66,
  "speechEnd": 325.52,
  "text": "By three p.m., you've said \"okay\" in six directions,",
  "end": 325.86
 },
 {
  "i": 114,
  "start": 325.86,
  "speechStart": 325.98,
  "speechEnd": 327.48,
  "text": "and none of them were to the same person.",
  "end": 328.32
 },
 {
  "i": 115,
  "start": 328.32,
  "speechStart": 328.44,
  "speechEnd": 331.72,
  "text": "At four thirty, the crack widens by a finger.",
  "end": 332.34
 },
 {
  "i": 116,
  "start": 332.34,
  "speechStart": 332.46,
  "speechEnd": 334.36,
  "text": "You throw a Shinra Tensei at the water.",
  "end": 334.76
 },
 {
  "i": 117,
  "start": 334.76,
  "speechStart": 334.88,
  "speechEnd": 336.96,
  "text": "The river retreats like a startled cat.",
  "end": 337.52
 },
 {
  "i": 118,
  "start": 337.52,
  "speechStart": 337.64,
  "speechEnd": 339.44,
  "text": "Then, five seconds of nothing,",
  "end": 339.98
 },
 {
  "i": 119,
  "start": 339.98,
  "speechStart": 340.1,
  "speechEnd": 343.4,
  "text": "and it comes back twice as angry. You count.",
  "end": 343.74
 },
 {
  "i": 120,
  "start": 343.74,
  "speechStart": 343.86,
  "speechEnd": 344.52,
  "text": "You can't help it.",
  "end": 344.82
 },
 {
  "i": 121,
  "start": 344.82,
  "speechStart": 344.94,
  "speechEnd": 348.1,
  "text": "One, two, three, four.",
  "end": 348.98
 },
 {
  "i": 122,
  "start": 348.98,
  "speechStart": 349.1,
  "speechEnd": 350.34,
  "text": "The Preta body slips.",
  "end": 350.96
 },
 {
  "i": 123,
  "start": 350.96,
  "speechStart": 351.08,
  "speechEnd": 352.36,
  "text": "The Asura's plate sparks.",
  "end": 352.98
 },
 {
  "i": 124,
  "start": 352.98,
  "speechStart": 353.1,
  "speechEnd": 355.68,
  "text": "The Animal body drops a sandbag on someone's boot.",
  "end": 355.56
 },
 {
  "i": 125,
  "start": 355.56,
  "speechStart": 355.68,
  "speechEnd": 357.84,
  "text": "Five.",
  "end": 357.72
 },
 {
  "i": 126,
  "start": 357.72,
  "speechStart": 357.84,
  "speechEnd": 359.32,
  "text": "The Deva body fires again.",
  "end": 360.3
 },
 {
  "i": 127,
  "start": 360.3,
  "speechStart": 360.42,
  "speechEnd": 363.22,
  "text": "Our guess is that the real danger isn't any single push.",
  "end": 363.66
 },
 {
  "i": 128,
  "start": 363.66,
  "speechStart": 363.78,
  "speechEnd": 365.38,
  "text": "It's the count between pushes,",
  "end": 365.8
 },
 {
  "i": 129,
  "start": 365.8,
  "speechStart": 365.92,
  "speechEnd": 367.42,
  "text": "when everything you love is waiting.",
  "end": 367.88
 },
 {
  "i": 130,
  "start": 367.88,
  "speechStart": 368.0,
  "speechEnd": 369.68,
  "text": "You hold that rhythm for three hours.",
  "end": 370.42
 },
 {
  "i": 131,
  "start": 370.42,
  "speechStart": 370.54,
  "speechEnd": 372.44,
  "text": "Push, five,",
  "end": 372.32
 },
 {
  "i": 132,
  "start": 372.32,
  "speechStart": 372.44,
  "speechEnd": 374.52,
  "text": "push, five.",
  "end": 374.4
 },
 {
  "i": 133,
  "start": 374.4,
  "speechStart": 374.52,
  "speechEnd": 376.72,
  "text": "Ruth brings you coffee you can't taste in six places.",
  "end": 377.4
 },
 {
  "i": 134,
  "start": 377.4,
  "speechStart": 377.52,
  "speechEnd": 380.96,
  "text": "Ruth follows the cables, the way an engineer would.",
  "end": 381.56
 },
 {
  "i": 135,
  "start": 381.56,
  "speechStart": 381.68,
  "speechEnd": 383.36,
  "text": "She finds the stone room at six,",
  "end": 383.58
 },
 {
  "i": 136,
  "start": 383.58,
  "speechStart": 383.7,
  "speechEnd": 385.34,
  "text": "with the weak body in the chair",
  "end": 385.22
 },
 {
  "i": 137,
  "start": 385.22,
  "speechStart": 385.34,
  "speechEnd": 387.92,
  "text": "and the thin black rods in the other six bodies,",
  "end": 387.8
 },
 {
  "i": 138,
  "start": 387.8,
  "speechStart": 387.92,
  "speechEnd": 388.94,
  "text": "glowing faintly.",
  "end": 389.58
 },
 {
  "i": 139,
  "start": 389.58,
  "speechStart": 389.7,
  "speechEnd": 393.72,
  "text": "\"That's you,\" she says. Not a question. \"Don't touch me.\"",
  "end": 394.24
 },
 {
  "i": 140,
  "start": 394.24,
  "speechStart": 394.36,
  "speechEnd": 396.38,
  "text": "\"You're burning. Look at your hands.\"",
  "end": 397.0
 },
 {
  "i": 141,
  "start": 397.0,
  "speechStart": 397.12,
  "speechEnd": 399.58,
  "text": "In the story, if the controller is interrupted",
  "end": 399.46
 },
 {
  "i": 142,
  "start": 399.46,
  "speechStart": 399.58,
  "speechEnd": 400.68,
  "text": "while sending chakra,",
  "end": 401.04
 },
 {
  "i": 143,
  "start": 401.04,
  "speechStart": 401.16,
  "speechEnd": 403.46,
  "text": "every body stops and becomes vulnerable.",
  "end": 404.32
 },
 {
  "i": 144,
  "start": 404.32,
  "speechStart": 404.44,
  "speechEnd": 408.34,
  "text": "In your version, that's all it takes. One touch. One shake.",
  "end": 408.82
 },
 {
  "i": 145,
  "start": 408.82,
  "speechStart": 408.94,
  "speechEnd": 411.78,
  "text": "One raised voice. She doesn't want to hurt you.",
  "end": 412.06
 },
 {
  "i": 146,
  "start": 412.06,
  "speechStart": 412.18,
  "speechEnd": 413.96,
  "text": "She wants you to stop before you break.",
  "end": 414.7
 },
 {
  "i": 147,
  "start": 414.7,
  "speechStart": 414.82,
  "speechEnd": 417.48,
  "text": "She puts a hand on your shoulder. Everything stops.",
  "end": 418.26
 },
 {
  "i": 148,
  "start": 418.26,
  "speechStart": 418.38,
  "speechEnd": 420.98,
  "text": "Six bodies freeze mid-step.",
  "end": 420.86
 },
 {
  "i": 149,
  "start": 420.86,
  "speechStart": 420.98,
  "speechEnd": 423.06,
  "text": "The river shoves at the Preta.",
  "end": 422.94
 },
 {
  "i": 150,
  "start": 422.94,
  "speechStart": 423.06,
  "speechEnd": 425.2,
  "text": "The Asura's plate lets go of its bolts.",
  "end": 425.78
 },
 {
  "i": 151,
  "start": 425.78,
  "speechStart": 425.9,
  "speechEnd": 429.7,
  "text": "The Deva body stands in the middle of the spillway, arm raised,",
  "end": 429.94
 },
 {
  "i": 152,
  "start": 429.94,
  "speechStart": 430.06,
  "speechEnd": 431.24,
  "text": "cooldown still counting,",
  "end": 431.64
 },
 {
  "i": 153,
  "start": 431.64,
  "speechStart": 431.76,
  "speechEnd": 434.24,
  "text": "and the first piece of the wall comes down.",
  "end": 434.96
 },
 {
  "i": 154,
  "start": 434.96,
  "speechStart": 435.08,
  "speechEnd": 438.12,
  "text": "You come back in the dark, with six streams at once",
  "end": 438.0
 },
 {
  "i": 155,
  "start": 438.0,
  "speechStart": 438.12,
  "speechEnd": 440.82,
  "text": "and none of them calm. Four are fine.",
  "end": 441.08
 },
 {
  "i": 156,
  "start": 441.08,
  "speechStart": 441.2,
  "speechEnd": 443.36,
  "text": "The Preta is knee-deep in a mudslide.",
  "end": 443.58
 },
 {
  "i": 157,
  "start": 443.58,
  "speechStart": 443.7,
  "speechEnd": 446.58,
  "text": "And the last one, the Asura, is on the wall,",
  "end": 446.46
 },
 {
  "i": 158,
  "start": 446.46,
  "speechStart": 446.58,
  "speechEnd": 449.48,
  "text": "holding a gate shut with its hands, and falling.",
  "end": 450.02
 },
 {
  "i": 159,
  "start": 450.02,
  "speechStart": 450.14,
  "speechEnd": 450.88,
  "text": "In your version,",
  "end": 451.06
 },
 {
  "i": 160,
  "start": 451.06,
  "speechStart": 451.18,
  "speechEnd": 453.72,
  "text": "if one body falls, you lose what it sees.",
  "end": 454.06
 },
 {
  "i": 161,
  "start": 454.06,
  "speechStart": 454.18,
  "speechEnd": 455.4,
  "text": "You lose what it holds.",
  "end": 455.68
 },
 {
  "i": 162,
  "start": 455.68,
  "speechStart": 455.8,
  "speechEnd": 459.2,
  "text": "And the river keeps all of it. You've got eight seconds.",
  "end": 459.68
 },
 {
  "i": 163,
  "start": 459.68,
  "speechStart": 459.8,
  "speechEnd": 463.04,
  "text": "You can only reinforce one. You see it all at once.",
  "end": 463.3
 },
 {
  "i": 164,
  "start": 463.3,
  "speechStart": 463.42,
  "speechEnd": 464.56,
  "text": "The mud, the gate,",
  "end": 464.78
 },
 {
  "i": 165,
  "start": 464.78,
  "speechStart": 464.9,
  "speechEnd": 467.08,
  "text": "the water, the lights of the town below.",
  "end": 467.48
 },
 {
  "i": 166,
  "start": 467.48,
  "speechStart": 467.6,
  "speechEnd": 470.44,
  "text": "And, in the lowest house on the lowest street,",
  "end": 470.8
 },
 {
  "i": 167,
  "start": 470.8,
  "speechStart": 470.92,
  "speechEnd": 473.46,
  "text": "a boy on a bicycle, standing at his window,",
  "end": 473.34
 },
 {
  "i": 168,
  "start": 473.34,
  "speechStart": 473.46,
  "speechEnd": 476.94,
  "text": "looking up at the dam. He can't see you. He's just looking.",
  "end": 477.34
 },
 {
  "i": 169,
  "start": 477.34,
  "speechStart": 477.46,
  "speechEnd": 478.1,
  "text": "Seven seconds.",
  "end": 478.7
 },
 {
  "i": 170,
  "start": 478.7,
  "speechStart": 478.82,
  "speechEnd": 481.7,
  "text": "Our guess is that the right choice isn't the strongest body,",
  "end": 481.58
 },
 {
  "i": 171,
  "start": 481.58,
  "speechStart": 481.7,
  "speechEnd": 483.08,
  "text": "or the most valuable one.",
  "end": 483.26
 },
 {
  "i": 172,
  "start": 483.26,
  "speechStart": 483.38,
  "speechEnd": 486.8,
  "text": "It's the one the town is standing behind. Six seconds.",
  "end": 487.2
 },
 {
  "i": 173,
  "start": 487.2,
  "speechStart": 487.32,
  "speechEnd": 487.68,
  "text": "Five.",
  "end": 488.24
 },
 {
  "i": 174,
  "start": 488.24,
  "speechStart": 488.36,
  "speechEnd": 491.6,
  "text": "The count is the same count, and it doesn't care that you're not ready.",
  "end": 492.32
 },
 {
  "i": 175,
  "start": 492.32,
  "speechStart": 492.44,
  "speechEnd": 494.14,
  "text": "You let the Naraka body go.",
  "end": 494.38
 },
 {
  "i": 176,
  "start": 494.38,
  "speechStart": 494.5,
  "speechEnd": 495.92,
  "text": "The one that was supposed to be sacred.",
  "end": 496.34
 },
 {
  "i": 177,
  "start": 496.34,
  "speechStart": 496.46,
  "speechEnd": 498.88,
  "text": "You send it down the hill instead of keeping it close.",
  "end": 499.42
 },
 {
  "i": 178,
  "start": 499.42,
  "speechStart": 499.54,
  "speechEnd": 501.62,
  "text": "It takes the gate from the Asura just",
  "end": 501.5
 },
 {
  "i": 179,
  "start": 501.5,
  "speechStart": 501.62,
  "speechEnd": 504.28,
  "text": "before the Asura's hands slip. It holds.",
  "end": 504.74
 },
 {
  "i": 180,
  "start": 504.74,
  "speechStart": 504.86,
  "speechEnd": 506.26,
  "text": "It holds for six minutes.",
  "end": 506.72
 },
 {
  "i": 181,
  "start": 506.72,
  "speechStart": 506.84,
  "speechEnd": 508.52,
  "text": "Long enough for the wall to take the plate.",
  "end": 509.04
 },
 {
  "i": 182,
  "start": 509.04,
  "speechStart": 509.16,
  "speechEnd": 512.8,
  "text": "Long enough for the river to find a lower path. The town doesn't flood.",
  "end": 513.74
 },
 {
  "i": 183,
  "start": 513.74,
  "speechStart": 513.86,
  "speechEnd": 514.42,
  "text": "By dawn,",
  "end": 514.7
 },
 {
  "i": 184,
  "start": 514.7,
  "speechStart": 514.82,
  "speechEnd": 517.84,
  "text": "the six bodies are standing in a circle around the empty dam,",
  "end": 517.72
 },
 {
  "i": 185,
  "start": 517.72,
  "speechStart": 517.84,
  "speechEnd": 519.8,
  "text": "like a very strange sculpture.",
  "end": 520.64
 },
 {
  "i": 186,
  "start": 520.64,
  "speechStart": 520.76,
  "speechEnd": 523.86,
  "text": "Ruth sits beside your real body, wrapped in a yellow raincoat.",
  "end": 524.42
 },
 {
  "i": 187,
  "start": 524.42,
  "speechStart": 524.54,
  "speechEnd": 526.46,
  "text": "She doesn't say thank you. She says:",
  "end": 526.74
 },
 {
  "i": 188,
  "start": 526.74,
  "speechStart": 526.86,
  "speechEnd": 530.5,
  "text": "\"Next time, ask first.\" You promise you will.",
  "end": 530.38
 },
 {
  "i": 189,
  "start": 530.38,
  "speechStart": 530.5,
  "speechEnd": 532.44,
  "text": "Three thousand",
  "end": 532.32
 },
 {
  "i": 190,
  "start": 532.32,
  "speechStart": 532.44,
  "speechEnd": 534.2,
  "text": "people never know you were there.",
  "end": 534.72
 },
 {
  "i": 191,
  "start": 534.72,
  "speechStart": 534.84,
  "speechEnd": 537.38,
  "text": "The boy rides his bicycle past the empty dam at noon,",
  "end": 537.26
 },
 {
  "i": 192,
  "start": 537.26,
  "speechStart": 537.38,
  "speechEnd": 539.64,
  "text": "and the shoelaces are still untied.",
  "end": 539.98
 },
 {
  "i": 193,
  "start": 539.98,
  "speechStart": 540.1,
  "speechEnd": 542.3,
  "text": "You smile, with your real face,",
  "end": 542.18
 },
 {
  "i": 194,
  "start": 542.18,
  "speechStart": 542.3,
  "speechEnd": 544.6,
  "text": "in the stone room, very slowly.",
  "end": 545.44
 },
 {
  "i": 195,
  "start": 545.44,
  "speechStart": 545.56,
  "speechEnd": 549.36,
  "text": "It's the first thing you've done on your own all day. Six bodies.",
  "end": 549.78
 },
 {
  "i": 196,
  "start": 549.78,
  "speechStart": 549.9,
  "speechEnd": 550.44,
  "text": "One mind.",
  "end": 551.36
 },
 {
  "i": 197,
  "start": 551.36,
  "speechStart": 551.48,
  "speechEnd": 553.58,
  "text": "And the only one that hurt was the seventh.",
  "end": 554.18
 },
 {
  "i": 198,
  "start": 554.18,
  "speechStart": 554.3,
  "speechEnd": 558.28,
  "text": "Would you want to feel the whole world through six pairs of eyes? Tell me in the comments.",
  "end": 558.76
 },
 {
  "i": 199,
  "start": 558.76,
  "speechStart": 558.88,
  "speechEnd": 561.4,
  "text": "And if you want the next one, tell me who you want to become.",
  "end": 563.0
 }
]