[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 2.72,
  "text": "You've woken up with a Domain Expansion,",
  "end": 2.6
 },
 {
  "i": 1,
  "start": 2.6,
  "speechStart": 2.72,
  "speechEnd": 5.54,
  "text": "from Jujutsu Kaisen. In real life.",
  "end": 5.98
 },
 {
  "i": 2,
  "start": 5.98,
  "speechStart": 6.1,
  "speechEnd": 9.26,
  "text": "In the story, it's a barrier that closes around a space",
  "end": 9.14
 },
 {
  "i": 3,
  "start": 9.14,
  "speechStart": 9.26,
  "speechEnd": 12.14,
  "text": "and makes your technique impossible to miss.",
  "end": 12.66
 },
 {
  "i": 4,
  "start": 12.66,
  "speechStart": 12.78,
  "speechEnd": 15.26,
  "text": "Right now, it's closing over the whole block,",
  "end": 15.44
 },
 {
  "i": 5,
  "start": 15.44,
  "speechStart": 15.56,
  "speechEnd": 17.7,
  "text": "and nobody inside can leave.",
  "end": 18.06
 },
 {
  "i": 6,
  "start": 18.06,
  "speechStart": 18.18,
  "speechEnd": 21.66,
  "text": "In your version, that's the only rule. No escape.",
  "end": 22.3
 },
 {
  "i": 7,
  "start": 22.3,
  "speechStart": 22.42,
  "speechEnd": 24.56,
  "text": "For anyone. Including you.",
  "end": 25.08
 },
 {
  "i": 8,
  "start": 25.08,
  "speechStart": 25.2,
  "speechEnd": 26.42,
  "text": "On day forty,",
  "end": 26.3
 },
 {
  "i": 9,
  "start": 26.3,
  "speechStart": 26.42,
  "speechEnd": 28.2,
  "text": "a storm will make that rule the only",
  "end": 28.08
 },
 {
  "i": 10,
  "start": 28.08,
  "speechStart": 28.2,
  "speechEnd": 31.06,
  "text": "thing between two hundred children and the sky.",
  "end": 31.74
 },
 {
  "i": 11,
  "start": 31.74,
  "speechStart": 31.86,
  "speechEnd": 34.22,
  "text": "But first, it's eleven twenty at night,",
  "end": 34.1
 },
 {
  "i": 12,
  "start": 34.1,
  "speechStart": 34.22,
  "speechEnd": 36.56,
  "text": "and the red dome is already closing.",
  "end": 37.68
 },
 {
  "i": 13,
  "start": 37.68,
  "speechStart": 37.8,
  "speechEnd": 39.64,
  "text": "A domain isn't a spell.",
  "end": 40.12
 },
 {
  "i": 14,
  "start": 40.12,
  "speechStart": 40.24,
  "speechEnd": 41.96,
  "text": "It's the user's innate domain,",
  "end": 42.12
 },
 {
  "i": 15,
  "start": 42.12,
  "speechStart": 42.24,
  "speechEnd": 45.24,
  "text": "built inside a barrier, and filled with their innate technique.",
  "end": 45.72
 },
 {
  "i": 16,
  "start": 45.72,
  "speechStart": 45.84,
  "speechEnd": 46.8,
  "text": "You don't have a technique.",
  "end": 46.94
 },
 {
  "i": 17,
  "start": 46.94,
  "speechStart": 47.06,
  "speechEnd": 48.96,
  "text": "So the dome decides for you:",
  "end": 49.22
 },
 {
  "i": 18,
  "start": 49.22,
  "speechStart": 49.34,
  "speechEnd": 51.52,
  "text": "yours ties everything inside to",
  "end": 51.4
 },
 {
  "i": 19,
  "start": 51.4,
  "speechStart": 51.52,
  "speechEnd": 53.72,
  "text": "you with thin red threads.",
  "end": 53.6
 },
 {
  "i": 20,
  "start": 53.6,
  "speechStart": 53.72,
  "speechEnd": 55.62,
  "text": "Whatever's in the dome can't walk out.",
  "end": 56.0
 },
 {
  "i": 21,
  "start": 56.0,
  "speechStart": 56.12,
  "speechEnd": 57.64,
  "text": "Your neighbour's cat is in your kitchen.",
  "end": 58.1
 },
 {
  "i": 22,
  "start": 58.1,
  "speechStart": 58.22,
  "speechEnd": 59.54,
  "text": "It has never liked you.",
  "end": 59.94
 },
 {
  "i": 23,
  "start": 59.94,
  "speechStart": 60.06,
  "speechEnd": 63.38,
  "text": "Now it's tied to your ankle, and it's furious about it.",
  "end": 63.96
 },
 {
  "i": 24,
  "start": 63.96,
  "speechStart": 64.08,
  "speechEnd": 66.5,
  "text": "Inside a domain, the attack can't miss.",
  "end": 67.02
 },
 {
  "i": 25,
  "start": 67.02,
  "speechStart": 67.14,
  "speechEnd": 71.14,
  "text": "In your version, neither can the thread. Lesson one:",
  "end": 71.02
 },
 {
  "i": 26,
  "start": 71.02,
  "speechStart": 71.14,
  "speechEnd": 73.36,
  "text": "the barrier closes around everyone,",
  "end": 73.86
 },
 {
  "i": 27,
  "start": 73.86,
  "speechStart": 73.98,
  "speechEnd": 75.2,
  "text": "not just the people you want.",
  "end": 76.12
 },
 {
  "i": 28,
  "start": 76.12,
  "speechStart": 76.24,
  "speechEnd": 79.2,
  "text": "In the morning you try it again, on purpose.",
  "end": 79.82
 },
 {
  "i": 29,
  "start": 79.82,
  "speechStart": 79.94,
  "speechEnd": 83.62,
  "text": "Your dome is the size of your flat. Then the stairwell.",
  "end": 84.22
 },
 {
  "i": 30,
  "start": 84.22,
  "speechStart": 84.34,
  "speechEnd": 88.24,
  "text": "Then, for ten seconds, the whole building. Our guess:",
  "end": 88.12
 },
 {
  "i": 31,
  "start": 88.12,
  "speechStart": 88.24,
  "speechEnd": 90.18,
  "text": "your range grows with how much you want it to.",
  "end": 90.62
 },
 {
  "i": 32,
  "start": 90.62,
  "speechStart": 90.74,
  "speechEnd": 92.14,
  "text": "The lift stops between floors.",
  "end": 92.92
 },
 {
  "i": 33,
  "start": 92.92,
  "speechStart": 93.04,
  "speechEnd": 96.16,
  "text": "A man in a suit stares at the red threads, and then at his shoes.",
  "end": 96.7
 },
 {
  "i": 34,
  "start": 96.7,
  "speechStart": 96.82,
  "speechEnd": 97.7,
  "text": "He says nothing.",
  "end": 98.16
 },
 {
  "i": 35,
  "start": 98.16,
  "speechStart": 98.28,
  "speechEnd": 101.4,
  "text": "He just leans on the wall, very carefully,",
  "end": 102.02
 },
 {
  "i": 36,
  "start": 102.02,
  "speechStart": 102.14,
  "speechEnd": 104.8,
  "text": "as if the wall might be a part of it. Lesson two:",
  "end": 105.52
 },
 {
  "i": 37,
  "start": 105.52,
  "speechStart": 105.64,
  "speechEnd": 107.56,
  "text": "a bigger domain isn't a better domain.",
  "end": 108.3
 },
 {
  "i": 38,
  "start": 108.3,
  "speechStart": 108.42,
  "speechEnd": 109.62,
  "text": "It's just a bigger apology.",
  "end": 110.16
 },
 {
  "i": 39,
  "start": 110.16,
  "speechStart": 110.28,
  "speechEnd": 113.3,
  "text": "At lunch, your boss starts a meeting about the budget.",
  "end": 113.62
 },
 {
  "i": 40,
  "start": 113.62,
  "speechStart": 113.74,
  "speechEnd": 114.38,
  "text": "You're nervous.",
  "end": 115.0
 },
 {
  "i": 41,
  "start": 115.0,
  "speechStart": 115.12,
  "speechEnd": 117.84,
  "text": "A thin dome closes around the table. Eight people.",
  "end": 118.26
 },
 {
  "i": 42,
  "start": 118.26,
  "speechStart": 118.38,
  "speechEnd": 120.78,
  "text": "Eight red threads. In the story,",
  "end": 120.92
 },
 {
  "i": 43,
  "start": 120.92,
  "speechStart": 121.04,
  "speechEnd": 124.1,
  "text": "a Simple Domain can neutralise a domain's guaranteed hit.",
  "end": 124.62
 },
 {
  "i": 44,
  "start": 124.62,
  "speechStart": 124.74,
  "speechEnd": 127.26,
  "text": "In real life, nobody has a Simple Domain.",
  "end": 127.9
 },
 {
  "i": 45,
  "start": 127.9,
  "speechStart": 128.02,
  "speechEnd": 131.32,
  "text": "That means every thread lands. Your boss's.",
  "end": 131.2
 },
 {
  "i": 46,
  "start": 131.2,
  "speechStart": 131.32,
  "speechEnd": 132.74,
  "text": "The intern's. Everybody's.",
  "end": 133.14
 },
 {
  "i": 47,
  "start": 133.14,
  "speechStart": 133.26,
  "speechEnd": 136.74,
  "text": "You feel all of them at once. The budget numbers.",
  "end": 136.98
 },
 {
  "i": 48,
  "start": 136.98,
  "speechStart": 137.1,
  "speechEnd": 138.02,
  "text": "The intern's panic.",
  "end": 138.06
 },
 {
  "i": 49,
  "start": 138.06,
  "speechStart": 138.18,
  "speechEnd": 141.28,
  "text": "Your boss, who is secretly thinking about a sandwich.",
  "end": 142.22
 },
 {
  "i": 50,
  "start": 142.22,
  "speechStart": 142.34,
  "speechEnd": 142.82,
  "text": "Lesson three:",
  "end": 143.34
 },
 {
  "i": 51,
  "start": 143.34,
  "speechStart": 143.46,
  "speechEnd": 144.9,
  "text": "when nobody can resist you,",
  "end": 145.26
 },
 {
  "i": 52,
  "start": 145.26,
  "speechStart": 145.38,
  "speechEnd": 148.26,
  "text": "being careful is the only defence anyone has.",
  "end": 149.24
 },
 {
  "i": 53,
  "start": 149.24,
  "speechStart": 149.36,
  "speechEnd": 150.3,
  "text": "In the story,",
  "end": 150.34
 },
 {
  "i": 54,
  "start": 150.34,
  "speechStart": 150.46,
  "speechEnd": 153.56,
  "text": "an incomplete domain loses the guaranteed hit.",
  "end": 154.04
 },
 {
  "i": 55,
  "start": 154.04,
  "speechStart": 154.16,
  "speechEnd": 157.0,
  "text": "So on day three you stop trying to do big ones.",
  "end": 157.28
 },
 {
  "i": 56,
  "start": 157.28,
  "speechStart": 157.4,
  "speechEnd": 158.76,
  "text": "You practise in the bathroom.",
  "end": 159.3
 },
 {
  "i": 57,
  "start": 159.3,
  "speechStart": 159.42,
  "speechEnd": 162.4,
  "text": "A dome the size of a bathtub works perfectly.",
  "end": 162.84
 },
 {
  "i": 58,
  "start": 162.84,
  "speechStart": 162.96,
  "speechEnd": 165.16,
  "text": "A dome the size of a shed flickers",
  "end": 165.04
 },
 {
  "i": 59,
  "start": 165.04,
  "speechStart": 165.16,
  "speechEnd": 167.16,
  "text": "and fails, and the threads go slack.",
  "end": 167.94
 },
 {
  "i": 60,
  "start": 167.94,
  "speechStart": 168.06,
  "speechEnd": 171.76,
  "text": "You eat a whole loaf of bread. Not hungry. Starving.",
  "end": 172.34
 },
 {
  "i": 61,
  "start": 172.34,
  "speechStart": 172.46,
  "speechEnd": 175.18,
  "text": "A domain takes an immense amount of cursed energy.",
  "end": 175.8
 },
 {
  "i": 62,
  "start": 175.8,
  "speechStart": 175.92,
  "speechEnd": 177.18,
  "text": "Lesson four:",
  "end": 177.06
 },
 {
  "i": 63,
  "start": 177.06,
  "speechStart": 177.18,
  "speechEnd": 179.94,
  "text": "small and complete beats big and broken.",
  "end": 180.94
 },
 {
  "i": 64,
  "start": 180.94,
  "speechStart": 181.06,
  "speechEnd": 183.8,
  "text": "On day six, you open a full one in the supermarket,",
  "end": 183.68
 },
 {
  "i": 65,
  "start": 183.68,
  "speechStart": 183.8,
  "speechEnd": 186.28,
  "text": "just to see how long you can hold it.",
  "end": 186.46
 },
 {
  "i": 66,
  "start": 186.46,
  "speechStart": 186.58,
  "speechEnd": 190.24,
  "text": "You hold it for forty seconds. Then your legs go.",
  "end": 190.72
 },
 {
  "i": 67,
  "start": 190.72,
  "speechStart": 190.84,
  "speechEnd": 192.6,
  "text": "You sit down in front of the frozen peas,",
  "end": 192.48
 },
 {
  "i": 68,
  "start": 192.48,
  "speechStart": 192.6,
  "speechEnd": 195.04,
  "text": "and an employee asks if you need a doctor.",
  "end": 195.86
 },
 {
  "i": 69,
  "start": 195.86,
  "speechStart": 195.98,
  "speechEnd": 199.2,
  "text": "You don't tell anyone that the red threads were still tied to a trolley",
  "end": 199.08
 },
 {
  "i": 70,
  "start": 199.08,
  "speechStart": 199.2,
  "speechEnd": 202.28,
  "text": "when you passed out. Lesson five:",
  "end": 202.16
 },
 {
  "i": 71,
  "start": 202.16,
  "speechStart": 202.28,
  "speechEnd": 203.84,
  "text": "the bill comes after the show,",
  "end": 204.14
 },
 {
  "i": 72,
  "start": 204.14,
  "speechStart": 204.26,
  "speechEnd": 206.4,
  "text": "and it always asks for you.",
  "end": 207.62
 },
 {
  "i": 73,
  "start": 207.62,
  "speechStart": 207.74,
  "speechEnd": 210.88,
  "text": "A boy films a red dome over a corner shop.",
  "end": 211.44
 },
 {
  "i": 74,
  "start": 211.44,
  "speechStart": 211.56,
  "speechEnd": 214.96,
  "text": "It lasts nine seconds. The video spreads.",
  "end": 215.98
 },
 {
  "i": 75,
  "start": 215.98,
  "speechStart": 216.1,
  "speechEnd": 217.82,
  "text": "Half of the comments say it's an effect.",
  "end": 218.56
 },
 {
  "i": 76,
  "start": 218.56,
  "speechStart": 218.68,
  "speechEnd": 221.22,
  "text": "The other half say it's a glitch in the sky.",
  "end": 221.76
 },
 {
  "i": 77,
  "start": 221.76,
  "speechStart": 221.88,
  "speechEnd": 223.84,
  "text": "Nobody says \"domain\".",
  "end": 224.82
 },
 {
  "i": 78,
  "start": 224.82,
  "speechStart": 224.94,
  "speechEnd": 229.22,
  "text": "The only people who know what that means think it's a joke. Lesson six:",
  "end": 230.08
 },
 {
  "i": 79,
  "start": 230.08,
  "speechStart": 230.2,
  "speechEnd": 232.04,
  "text": "the ones who'd understand are",
  "end": 231.92
 },
 {
  "i": 80,
  "start": 231.92,
  "speechStart": 232.04,
  "speechEnd": 233.84,
  "text": "the ones who'd never believe it.",
  "end": 234.52
 },
 {
  "i": 81,
  "start": 234.52,
  "speechStart": 234.64,
  "speechEnd": 237.0,
  "text": "On day twelve you go to a yoga class,",
  "end": 236.88
 },
 {
  "i": 82,
  "start": 236.88,
  "speechStart": 237.0,
  "speechEnd": 239.22,
  "text": "because someone told you it would help with the stress.",
  "end": 239.84
 },
 {
  "i": 83,
  "start": 239.84,
  "speechStart": 239.96,
  "speechEnd": 241.96,
  "text": "The teacher sits cross-legged at the front.",
  "end": 242.4
 },
 {
  "i": 84,
  "start": 242.4,
  "speechStart": 242.52,
  "speechEnd": 246.02,
  "text": "You close a small dome around the room, just to test it.",
  "end": 245.9
 },
 {
  "i": 85,
  "start": 245.9,
  "speechStart": 246.02,
  "speechEnd": 247.74,
  "text": "Eleven threads tie on.",
  "end": 248.18
 },
 {
  "i": 86,
  "start": 248.18,
  "speechStart": 248.3,
  "speechEnd": 249.64,
  "text": "The twelfth, hers,",
  "end": 249.52
 },
 {
  "i": 87,
  "start": 249.52,
  "speechStart": 249.64,
  "speechEnd": 252.62,
  "text": "slides off, like water off a window.",
  "end": 253.16
 },
 {
  "i": 88,
  "start": 253.16,
  "speechStart": 253.28,
  "speechEnd": 254.18,
  "text": "In the story,",
  "end": 254.06
 },
 {
  "i": 89,
  "start": 254.06,
  "speechStart": 254.18,
  "speechEnd": 258.32,
  "text": "a Simple Domain can cancel a domain's guaranteed hit. Our guess:",
  "end": 258.82
 },
 {
  "i": 90,
  "start": 258.82,
  "speechStart": 258.94,
  "speechEnd": 260.68,
  "text": "someone who is completely calm",
  "end": 260.56
 },
 {
  "i": 91,
  "start": 260.56,
  "speechStart": 260.68,
  "speechEnd": 264.14,
  "text": "is the closest thing real life has to one. She opens one eye.",
  "end": 264.66
 },
 {
  "i": 92,
  "start": 264.66,
  "speechStart": 264.78,
  "speechEnd": 266.96,
  "text": "She doesn't say a word. She just smiles,",
  "end": 267.6
 },
 {
  "i": 93,
  "start": 267.6,
  "speechStart": 267.72,
  "speechEnd": 270.96,
  "text": "as if she has seen a thousand of these. Lesson seven:",
  "end": 271.3
 },
 {
  "i": 94,
  "start": 271.3,
  "speechStart": 271.42,
  "speechEnd": 273.3,
  "text": "the only defence against \"can't miss\"",
  "end": 273.18
 },
 {
  "i": 95,
  "start": 273.18,
  "speechStart": 273.3,
  "speechEnd": 275.1,
  "text": "is not caring who's watching.",
  "end": 276.06
 },
 {
  "i": 96,
  "start": 276.06,
  "speechStart": 276.18,
  "speechEnd": 278.86,
  "text": "On day fifteen, you open one in a train station,",
  "end": 278.74
 },
 {
  "i": 97,
  "start": 278.74,
  "speechStart": 278.86,
  "speechEnd": 281.96,
  "text": "and for the first time, the threads aren't eight.",
  "end": 282.46
 },
 {
  "i": 98,
  "start": 282.46,
  "speechStart": 282.58,
  "speechEnd": 285.58,
  "text": "They're two hundred. In the story,",
  "end": 285.86
 },
 {
  "i": 99,
  "start": 285.86,
  "speechStart": 285.98,
  "speechEnd": 289.1,
  "text": "Gojo's Unlimited Void floods the target with information",
  "end": 288.98
 },
 {
  "i": 100,
  "start": 288.98,
  "speechStart": 289.1,
  "speechEnd": 291.94,
  "text": "until they can't move. Yours does it to you.",
  "end": 292.64
 },
 {
  "i": 101,
  "start": 292.64,
  "speechStart": 292.76,
  "speechEnd": 293.94,
  "text": "In nineteen fifty-six,",
  "end": 293.82
 },
 {
  "i": 102,
  "start": 293.82,
  "speechStart": 293.94,
  "speechEnd": 296.46,
  "text": "the psychologist George Miller showed that people hold",
  "end": 296.34
 },
 {
  "i": 103,
  "start": 296.34,
  "speechStart": 296.46,
  "speechEnd": 299.12,
  "text": "only around four to nine things in mind at once.",
  "end": 299.74
 },
 {
  "i": 104,
  "start": 299.74,
  "speechStart": 299.86,
  "speechEnd": 302.06,
  "text": "You're tracking two hundred.",
  "end": 301.94
 },
 {
  "i": 105,
  "start": 301.94,
  "speechStart": 302.06,
  "speechEnd": 304.22,
  "text": "You close the dome, sit on the platform,",
  "end": 304.62
 },
 {
  "i": 106,
  "start": 304.62,
  "speechStart": 304.74,
  "speechEnd": 308.6,
  "text": "and don't speak for twenty minutes. Lesson eight:",
  "end": 308.48
 },
 {
  "i": 107,
  "start": 308.48,
  "speechStart": 308.6,
  "speechEnd": 312.32,
  "text": "sure-hit is easy to want. It's hard to carry.",
  "end": 313.42
 },
 {
  "i": 108,
  "start": 313.42,
  "speechStart": 313.54,
  "speechEnd": 314.36,
  "text": "In the story,",
  "end": 314.72
 },
 {
  "i": 109,
  "start": 314.72,
  "speechStart": 314.84,
  "speechEnd": 318.3,
  "text": "Sukuna's Malevolent Shrine has no closed barrier at all.",
  "end": 318.6
 },
 {
  "i": 110,
  "start": 318.6,
  "speechStart": 318.72,
  "speechEnd": 322.52,
  "text": "It's an open space with a huge reach. Our guess:",
  "end": 323.08
 },
 {
  "i": 111,
  "start": 323.08,
  "speechStart": 323.2,
  "speechEnd": 325.94,
  "text": "that's what a domain without walls would feel like.",
  "end": 325.82
 },
 {
  "i": 112,
  "start": 325.82,
  "speechStart": 325.94,
  "speechEnd": 328.62,
  "text": "On day twenty, you try it from the roof.",
  "end": 329.54
 },
 {
  "i": 113,
  "start": 329.54,
  "speechStart": 329.66,
  "speechEnd": 333.04,
  "text": "The red doesn't close. It spreads.",
  "end": 334.06
 },
 {
  "i": 114,
  "start": 334.06,
  "speechStart": 334.18,
  "speechEnd": 335.08,
  "text": "Over the street,",
  "end": 335.52
 },
 {
  "i": 115,
  "start": 335.52,
  "speechStart": 335.64,
  "speechEnd": 337.98,
  "text": "the park, the river, and the city beyond.",
  "end": 338.78
 },
 {
  "i": 116,
  "start": 338.78,
  "speechStart": 338.9,
  "speechEnd": 340.78,
  "text": "Every window is tied to you.",
  "end": 341.06
 },
 {
  "i": 117,
  "start": 341.06,
  "speechStart": 341.18,
  "speechEnd": 344.32,
  "text": "You can feel the whole city's weight on the other end of the threads:",
  "end": 345.08
 },
 {
  "i": 118,
  "start": 345.08,
  "speechStart": 345.2,
  "speechEnd": 347.38,
  "text": "the late shift, the baby awake,",
  "end": 347.72
 },
 {
  "i": 119,
  "start": 347.72,
  "speechStart": 347.84,
  "speechEnd": 350.44,
  "text": "the dog that won't stop barking.",
  "end": 350.32
 },
 {
  "i": 120,
  "start": 350.32,
  "speechStart": 350.44,
  "speechEnd": 351.36,
  "text": "You close your hand.",
  "end": 351.78
 },
 {
  "i": 121,
  "start": 351.78,
  "speechStart": 351.9,
  "speechEnd": 353.4,
  "text": "The dome snaps shut,",
  "end": 354.22
 },
 {
  "i": 122,
  "start": 354.22,
  "speechStart": 354.34,
  "speechEnd": 358.24,
  "text": "and the sky is just a sky again. Lesson nine:",
  "end": 358.12
 },
 {
  "i": 123,
  "start": 358.12,
  "speechStart": 358.24,
  "speechEnd": 360.9,
  "text": "if there's no wall, there's no one else to blame.",
  "end": 362.02
 },
 {
  "i": 124,
  "start": 362.02,
  "speechStart": 362.14,
  "speechEnd": 365.36,
  "text": "On day twenty-five, you go back to the people you tied.",
  "end": 365.84
 },
 {
  "i": 125,
  "start": 365.84,
  "speechStart": 365.96,
  "speechEnd": 370.26,
  "text": "Your boss. The intern. The man in the lift. You don't explain.",
  "end": 370.68
 },
 {
  "i": 126,
  "start": 370.68,
  "speechStart": 370.8,
  "speechEnd": 371.38,
  "text": "You can't.",
  "end": 371.7
 },
 {
  "i": 127,
  "start": 371.7,
  "speechStart": 371.82,
  "speechEnd": 374.38,
  "text": "So you buy coffee, and you say that you're sorry,",
  "end": 374.78
 },
 {
  "i": 128,
  "start": 374.78,
  "speechStart": 374.9,
  "speechEnd": 376.68,
  "text": "and that you'll make sure it never happens again.",
  "end": 376.56
 },
 {
  "i": 129,
  "start": 376.56,
  "speechStart": 376.68,
  "speechEnd": 379.42,
  "text": "The intern says, \"I felt something.",
  "end": 379.88
 },
 {
  "i": 130,
  "start": 379.88,
  "speechStart": 380.0,
  "speechEnd": 381.68,
  "text": "I thought it was just a very long Monday.\"",
  "end": 382.2
 },
 {
  "i": 131,
  "start": 382.2,
  "speechStart": 382.32,
  "speechEnd": 384.74,
  "text": "Your boss says nothing for a moment, and",
  "end": 384.62
 },
 {
  "i": 132,
  "start": 384.62,
  "speechStart": 384.74,
  "speechEnd": 388.82,
  "text": "then he tells you what he was really thinking about in that meeting: not a sandwich,",
  "end": 389.16
 },
 {
  "i": 133,
  "start": 389.16,
  "speechStart": 389.28,
  "speechEnd": 392.0,
  "text": "but his daughter's birthday, which he'd forgotten.",
  "end": 392.52
 },
 {
  "i": 134,
  "start": 392.52,
  "speechStart": 392.64,
  "speechEnd": 395.42,
  "text": "You'd felt that thread before you ever knew what it was.",
  "end": 395.8
 },
 {
  "i": 135,
  "start": 395.8,
  "speechStart": 395.92,
  "speechEnd": 397.18,
  "text": "Lesson ten:",
  "end": 397.06
 },
 {
  "i": 136,
  "start": 397.06,
  "speechStart": 397.18,
  "speechEnd": 399.42,
  "text": "you can't un-feel what you've tied to.",
  "end": 399.86
 },
 {
  "i": 137,
  "start": 399.86,
  "speechStart": 399.98,
  "speechEnd": 402.38,
  "text": "You can only decide what to do with it.",
  "end": 403.24
 },
 {
  "i": 138,
  "start": 403.24,
  "speechStart": 403.36,
  "speechEnd": 404.9,
  "text": "On day thirty,",
  "end": 404.78
 },
 {
  "i": 139,
  "start": 404.78,
  "speechStart": 404.9,
  "speechEnd": 407.08,
  "text": "a stranger breaks into your car.",
  "end": 407.56
 },
 {
  "i": 140,
  "start": 407.56,
  "speechStart": 407.68,
  "speechEnd": 411.24,
  "text": "You're still holding a small dome from the evening. He runs.",
  "end": 412.08
 },
 {
  "i": 141,
  "start": 412.08,
  "speechStart": 412.2,
  "speechEnd": 414.42,
  "text": "He hits the edge. He can't leave.",
  "end": 415.06
 },
 {
  "i": 142,
  "start": 415.06,
  "speechStart": 415.18,
  "speechEnd": 417.84,
  "text": "In your version, the only door is you.",
  "end": 418.18
 },
 {
  "i": 143,
  "start": 418.18,
  "speechStart": 418.3,
  "speechEnd": 422.14,
  "text": "He's terrified. He doesn't get hurt. You just stand there,",
  "end": 422.6
 },
 {
  "i": 144,
  "start": 422.6,
  "speechStart": 422.72,
  "speechEnd": 425.06,
  "text": "a metre from him, holding the walls.",
  "end": 426.08
 },
 {
  "i": 145,
  "start": 426.08,
  "speechStart": 426.2,
  "speechEnd": 429.46,
  "text": "And you realise that \"no escape\" is a sentence,",
  "end": 429.34
 },
 {
  "i": 146,
  "start": 429.34,
  "speechStart": 429.46,
  "speechEnd": 432.44,
  "text": "not a power, and that you're the one",
  "end": 432.32
 },
 {
  "i": 147,
  "start": 432.32,
  "speechStart": 432.44,
  "speechEnd": 436.4,
  "text": "who has to decide how long it lasts. You open it.",
  "end": 436.74
 },
 {
  "i": 148,
  "start": 436.74,
  "speechStart": 436.86,
  "speechEnd": 440.44,
  "text": "He runs without looking back. Your hands are shaking",
  "end": 440.32
 },
 {
  "i": 149,
  "start": 440.32,
  "speechStart": 440.44,
  "speechEnd": 443.14,
  "text": "so hard that you have to sit down on the kerb,",
  "end": 443.02
 },
 {
  "i": 150,
  "start": 443.02,
  "speechStart": 443.14,
  "speechEnd": 444.24,
  "text": "and you stay there",
  "end": 444.12
 },
 {
  "i": 151,
  "start": 444.12,
  "speechStart": 444.24,
  "speechEnd": 445.9,
  "text": "until the streetlights flicker back",
  "end": 445.78
 },
 {
  "i": 152,
  "start": 445.78,
  "speechStart": 445.9,
  "speechEnd": 447.78,
  "text": "to their normal colour.",
  "end": 447.66
 },
 {
  "i": 153,
  "start": 447.66,
  "speechStart": 447.78,
  "speechEnd": 449.14,
  "text": "Lesson eleven:",
  "end": 449.02
 },
 {
  "i": 154,
  "start": 449.02,
  "speechStart": 449.14,
  "speechEnd": 452.08,
  "text": "the strongest rule you can set is the one you can end.",
  "end": 453.16
 },
 {
  "i": 155,
  "start": 453.16,
  "speechStart": 453.28,
  "speechEnd": 454.94,
  "text": "On day thirty-five,",
  "end": 454.82
 },
 {
  "i": 156,
  "start": 454.82,
  "speechStart": 454.94,
  "speechEnd": 456.96,
  "text": "you take it to an empty playground at night.",
  "end": 456.84
 },
 {
  "i": 157,
  "start": 456.84,
  "speechStart": 456.96,
  "speechEnd": 460.5,
  "text": "You've never tried to keep something out. Only in.",
  "end": 461.18
 },
 {
  "i": 158,
  "start": 461.18,
  "speechStart": 461.3,
  "speechEnd": 463.6,
  "text": "You close a dome the size of the slide,",
  "end": 463.48
 },
 {
  "i": 159,
  "start": 463.48,
  "speechStart": 463.6,
  "speechEnd": 466.06,
  "text": "and throw a handful of gravel at it.",
  "end": 466.34
 },
 {
  "i": 160,
  "start": 466.34,
  "speechStart": 466.46,
  "speechEnd": 469.28,
  "text": "The gravel stops at the wall, and hangs there,",
  "end": 469.36
 },
 {
  "i": 161,
  "start": 469.36,
  "speechStart": 469.48,
  "speechEnd": 473.14,
  "text": "as if the air had gone thick. You stand in the middle,",
  "end": 473.26
 },
 {
  "i": 162,
  "start": 473.26,
  "speechStart": 473.38,
  "speechEnd": 476.42,
  "text": "with the pebbles floating around you like a tiny planet,",
  "end": 476.92
 },
 {
  "i": 163,
  "start": 476.92,
  "speechStart": 477.04,
  "speechEnd": 477.64,
  "text": "and you laugh.",
  "end": 478.2
 },
 {
  "i": 164,
  "start": 478.2,
  "speechStart": 478.32,
  "speechEnd": 481.48,
  "text": "For the first time in thirty-five days, you laugh.",
  "end": 481.36
 },
 {
  "i": 165,
  "start": 481.36,
  "speechStart": 481.48,
  "speechEnd": 482.84,
  "text": "Lesson twelve:",
  "end": 482.72
 },
 {
  "i": 166,
  "start": 482.72,
  "speechStart": 482.84,
  "speechEnd": 484.64,
  "text": "the same wall that",
  "end": 484.52
 },
 {
  "i": 167,
  "start": 484.52,
  "speechStart": 484.64,
  "speechEnd": 486.78,
  "text": "traps can also protect.",
  "end": 488.1
 },
 {
  "i": 168,
  "start": 488.1,
  "speechStart": 488.22,
  "speechEnd": 491.48,
  "text": "On day forty, a storm tears across the city,",
  "end": 491.84
 },
 {
  "i": 169,
  "start": 491.84,
  "speechStart": 491.96,
  "speechEnd": 494.24,
  "text": "and the siren at the primary school goes off.",
  "end": 494.9
 },
 {
  "i": 170,
  "start": 494.9,
  "speechStart": 495.02,
  "speechEnd": 496.84,
  "text": "Two hundred children are in the yard.",
  "end": 497.16
 },
 {
  "i": 171,
  "start": 497.16,
  "speechStart": 497.28,
  "speechEnd": 499.16,
  "text": "The nearest shelter is two minutes away.",
  "end": 499.92
 },
 {
  "i": 172,
  "start": 499.92,
  "speechStart": 500.04,
  "speechEnd": 502.68,
  "text": "In your version, the dome can keep things in.",
  "end": 503.32
 },
 {
  "i": 173,
  "start": 503.32,
  "speechStart": 503.44,
  "speechEnd": 506.66,
  "text": "And it can keep things out. You run.",
  "end": 506.92
 },
 {
  "i": 174,
  "start": 506.92,
  "speechStart": 507.04,
  "speechEnd": 508.4,
  "text": "You spread your arms at the gate.",
  "end": 508.64
 },
 {
  "i": 175,
  "start": 508.64,
  "speechStart": 508.76,
  "speechEnd": 511.84,
  "text": "The red closes over the yard, the roof, and the car park.",
  "end": 512.32
 },
 {
  "i": 176,
  "start": 512.32,
  "speechStart": 512.44,
  "speechEnd": 514.48,
  "text": "Wind, rain, branches.",
  "end": 514.98
 },
 {
  "i": 177,
  "start": 514.98,
  "speechStart": 515.1,
  "speechEnd": 519.24,
  "text": "A trampoline crosses the road like a leaf. Nothing reaches the children.",
  "end": 519.86
 },
 {
  "i": 178,
  "start": 519.86,
  "speechStart": 519.98,
  "speechEnd": 520.78,
  "text": "Your legs shake.",
  "end": 521.2
 },
 {
  "i": 179,
  "start": 521.2,
  "speechStart": 521.32,
  "speechEnd": 522.96,
  "text": "You hold it for four minutes.",
  "end": 523.48
 },
 {
  "i": 180,
  "start": 523.48,
  "speechStart": 523.6,
  "speechEnd": 525.32,
  "text": "The longest four minutes of your life.",
  "end": 525.94
 },
 {
  "i": 181,
  "start": 525.94,
  "speechStart": 526.06,
  "speechEnd": 527.96,
  "text": "When the sky clears, you open your hands.",
  "end": 528.62
 },
 {
  "i": 182,
  "start": 528.62,
  "speechStart": 528.74,
  "speechEnd": 530.68,
  "text": "Two hundred faces look at a red sky",
  "end": 530.56
 },
 {
  "i": 183,
  "start": 530.56,
  "speechStart": 530.68,
  "speechEnd": 532.68,
  "text": "that's turning back into a grey one.",
  "end": 533.54
 },
 {
  "i": 184,
  "start": 533.54,
  "speechStart": 533.66,
  "speechEnd": 535.26,
  "text": "Nobody asks what you are.",
  "end": 535.14
 },
 {
  "i": 185,
  "start": 535.14,
  "speechStart": 535.26,
  "speechEnd": 538.02,
  "text": "The next morning you",
  "end": 537.9
 },
 {
  "i": 186,
  "start": 537.9,
  "speechStart": 538.02,
  "speechEnd": 541.382,
  "text": "can't lift your arms. There's one red thread still tied to your finger. It's the cat's.",
  "end": 541.262
 },
 {
  "i": 187,
  "start": 541.262,
  "speechStart": 541.382,
  "speechEnd": 543.86,
  "text": "It hasn't forgiven you, and it hasn't left either.",
  "end": 544.42
 },
 {
  "i": 188,
  "start": 544.42,
  "speechStart": 544.54,
  "speechEnd": 547.04,
  "text": "You think about the storm, the school, the children,",
  "end": 547.32
 },
 {
  "i": 189,
  "start": 547.32,
  "speechStart": 547.44,
  "speechEnd": 549.68,
  "text": "and how none of them will ever know your name.",
  "end": 550.28
 },
 {
  "i": 190,
  "start": 550.28,
  "speechStart": 550.4,
  "speechEnd": 552.04,
  "text": "Lesson thirteen:",
  "end": 551.92
 },
 {
  "i": 191,
  "start": 551.92,
  "speechStart": 552.04,
  "speechEnd": 554.16,
  "text": "the bravest use of \"no escape\" is the one",
  "end": 554.04
 },
 {
  "i": 192,
  "start": 554.04,
  "speechStart": 554.16,
  "speechEnd": 556.24,
  "text": "where the only person trapped is you,",
  "end": 556.12
 },
 {
  "i": 193,
  "start": 556.12,
  "speechStart": 556.24,
  "speechEnd": 557.66,
  "text": "for as long as it takes.",
  "end": 558.6
 },
 {
  "i": 194,
  "start": 558.6,
  "speechStart": 558.72,
  "speechEnd": 561.76,
  "text": "The next night, at eleven twenty, you're back on the roof.",
  "end": 562.2
 },
 {
  "i": 195,
  "start": 562.2,
  "speechStart": 562.32,
  "speechEnd": 564.88,
  "text": "So if you woke up tomorrow with a Domain Expansion,",
  "end": 565.12
 },
 {
  "i": 196,
  "start": 565.12,
  "speechStart": 565.24,
  "speechEnd": 566.44,
  "text": "what would your technique be?",
  "end": 566.96
 },
 {
  "i": 197,
  "start": 566.96,
  "speechStart": 567.08,
  "speechEnd": 568.84,
  "text": "And would you ever open it all the way,",
  "end": 568.72
 },
 {
  "i": 198,
  "start": 568.72,
  "speechStart": 568.84,
  "speechEnd": 572.0,
  "text": "so that the whole city was inside? Tell me in the comments.",
  "end": 573.6
 }
]