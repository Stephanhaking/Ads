[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 2.36,
  "text": "You miss the last step of the subway stairs.",
  "end": 2.98
 },
 {
  "i": 1,
  "start": 2.98,
  "speechStart": 3.1,
  "speechEnd": 5.22,
  "text": "You're falling backwards into a crowd of strangers.",
  "end": 6.26
 },
 {
  "i": 2,
  "start": 6.26,
  "speechStart": 6.38,
  "speechEnd": 8.32,
  "text": "And then your arm stretches",
  "end": 8.2
 },
 {
  "i": 3,
  "start": 8.2,
  "speechStart": 8.32,
  "speechEnd": 10.68,
  "text": "four metres across the station,",
  "end": 11.08
 },
 {
  "i": 4,
  "start": 11.08,
  "speechStart": 11.2,
  "speechEnd": 14.5,
  "text": "wraps around a railing, and pulls you back like a bungee cord.",
  "end": 15.52
 },
 {
  "i": 5,
  "start": 15.52,
  "speechStart": 15.64,
  "speechEnd": 16.5,
  "text": "Nobody saw it.",
  "end": 16.9
 },
 {
  "i": 6,
  "start": 16.9,
  "speechStart": 17.02,
  "speechEnd": 20.28,
  "text": "Everybody was looking at their phone. You look at your hand.",
  "end": 20.96
 },
 {
  "i": 7,
  "start": 20.96,
  "speechStart": 21.08,
  "speechEnd": 21.88,
  "text": "It's normal again.",
  "end": 22.98
 },
 {
  "i": 8,
  "start": 22.98,
  "speechStart": 23.1,
  "speechEnd": 27.34,
  "text": "Your heart is beating like a drum. Boom. Boom. Boom.",
  "end": 28.18
 },
 {
  "i": 9,
  "start": 28.18,
  "speechStart": 28.3,
  "speechEnd": 32.0,
  "text": "Overnight, you got the powers of Monkey D. Luffy from One Piece.",
  "end": 32.62
 },
 {
  "i": 10,
  "start": 32.62,
  "speechStart": 32.74,
  "speechEnd": 36.1,
  "text": "Not his straw hat. Not his crew. Just his body.",
  "end": 36.68
 },
 {
  "i": 11,
  "start": 36.68,
  "speechStart": 36.8,
  "speechEnd": 39.8,
  "text": "A body made of rubber. Four gears.",
  "end": 40.34
 },
 {
  "i": 12,
  "start": 40.34,
  "speechStart": 40.46,
  "speechEnd": 42.34,
  "text": "And one last form, Gear 5,",
  "end": 42.82
 },
 {
  "i": 13,
  "start": 42.82,
  "speechStart": 42.94,
  "speechEnd": 46.22,
  "text": "so powerful that it leaves Luffy looking like an old man when it ends.",
  "end": 47.04
 },
 {
  "i": 14,
  "start": 47.04,
  "speechStart": 47.16,
  "speechEnd": 48.52,
  "text": "In the next sixty days",
  "end": 48.96
 },
 {
  "i": 15,
  "start": 48.96,
  "speechStart": 49.08,
  "speechEnd": 52.22,
  "text": "you'll learn what rubber can really do, what it can't,",
  "end": 52.58
 },
 {
  "i": 16,
  "start": 52.58,
  "speechStart": 52.7,
  "speechEnd": 55.84,
  "text": "and why the strongest thing you have also costs the most.",
  "end": 56.38
 },
 {
  "i": 17,
  "start": 56.38,
  "speechStart": 56.5,
  "speechEnd": 58.32,
  "text": "First test: the mirror.",
  "end": 58.86
 },
 {
  "i": 18,
  "start": 58.86,
  "speechStart": 58.98,
  "speechEnd": 60.6,
  "text": "You pinch your cheek and pull.",
  "end": 61.08
 },
 {
  "i": 19,
  "start": 61.08,
  "speechStart": 61.2,
  "speechEnd": 63.84,
  "text": "It stretches thirty centimetres and snaps back.",
  "end": 64.38
 },
 {
  "i": 20,
  "start": 64.38,
  "speechStart": 64.5,
  "speechEnd": 67.1,
  "text": "Real rubber is stretchy, but it has limits.",
  "end": 68.12
 },
 {
  "i": 21,
  "start": 68.12,
  "speechStart": 68.24,
  "speechEnd": 71.28,
  "text": "Natural rubber usually breaks when it's stretched to somewhere between four",
  "end": 71.16
 },
 {
  "i": 22,
  "start": 71.16,
  "speechStart": 71.28,
  "speechEnd": 72.46,
  "text": "and ten times its length.",
  "end": 73.18
 },
 {
  "i": 23,
  "start": 73.18,
  "speechStart": 73.3,
  "speechEnd": 75.04,
  "text": "Luffy goes far beyond that.",
  "end": 75.6
 },
 {
  "i": 24,
  "start": 75.6,
  "speechStart": 75.72,
  "speechEnd": 78.28,
  "text": "Your arm just did four metres without tearing.",
  "end": 79.16
 },
 {
  "i": 25,
  "start": 79.16,
  "speechStart": 79.28,
  "speechEnd": 80.52,
  "text": "Then you notice something weird.",
  "end": 81.14
 },
 {
  "i": 26,
  "start": 81.14,
  "speechStart": 81.26,
  "speechEnd": 83.22,
  "text": "When you stretch, your arm gets warm.",
  "end": 83.74
 },
 {
  "i": 27,
  "start": 83.74,
  "speechStart": 83.86,
  "speechEnd": 87.06,
  "text": "When it snaps back, it goes cold. That one's real.",
  "end": 87.38
 },
 {
  "i": 28,
  "start": 87.38,
  "speechStart": 87.5,
  "speechEnd": 89.14,
  "text": "It's called the Gough-Joule effect.",
  "end": 89.76
 },
 {
  "i": 29,
  "start": 89.76,
  "speechStart": 89.88,
  "speechEnd": 92.1,
  "text": "Stretch a rubber band fast and touch it to your lips,",
  "end": 91.98
 },
 {
  "i": 30,
  "start": 91.98,
  "speechStart": 92.1,
  "speechEnd": 93.52,
  "text": "and you'll feel it warm up.",
  "end": 94.22
 },
 {
  "i": 31,
  "start": 94.22,
  "speechStart": 94.34,
  "speechEnd": 96.88,
  "text": "Stretching lines up the long molecules inside the rubber,",
  "end": 96.76
 },
 {
  "i": 32,
  "start": 96.76,
  "speechStart": 96.88,
  "speechEnd": 99.76,
  "text": "and that releases heat. Letting go does the opposite.",
  "end": 100.52
 },
 {
  "i": 33,
  "start": 100.52,
  "speechStart": 100.64,
  "speechEnd": 101.4,
  "text": "So rule one:",
  "end": 101.72
 },
 {
  "i": 34,
  "start": 101.72,
  "speechStart": 101.84,
  "speechEnd": 103.34,
  "text": "every stretch makes you warm.",
  "end": 103.22
 },
 {
  "i": 35,
  "start": 103.22,
  "speechStart": 103.34,
  "speechEnd": 105.48,
  "text": "A hundred stretches, and you're sweating.",
  "end": 106.62
 },
 {
  "i": 36,
  "start": 106.62,
  "speechStart": 106.74,
  "speechEnd": 108.68,
  "text": "Luffy's most famous move is simple.",
  "end": 109.22
 },
 {
  "i": 37,
  "start": 109.22,
  "speechStart": 109.34,
  "speechEnd": 110.92,
  "text": "Stretch your arm back, let go,",
  "end": 111.04
 },
 {
  "i": 38,
  "start": 111.04,
  "speechStart": 111.16,
  "speechEnd": 114.54,
  "text": "and it flies forward like a slingshot. You try it on a punching bag.",
  "end": 114.9
 },
 {
  "i": 39,
  "start": 114.9,
  "speechStart": 115.02,
  "speechEnd": 117.9,
  "text": "You pull your arm back ten metres. You let go.",
  "end": 118.3
 },
 {
  "i": 40,
  "start": 118.3,
  "speechStart": 118.42,
  "speechEnd": 121.7,
  "text": "The bag rips off its chain and lands on the other side of the court.",
  "end": 122.34
 },
 {
  "i": 41,
  "start": 122.34,
  "speechStart": 122.46,
  "speechEnd": 124.88,
  "text": "A slingshot stores energy while you stretch it,",
  "end": 124.92
 },
 {
  "i": 42,
  "start": 124.92,
  "speechStart": 125.04,
  "speechEnd": 126.46,
  "text": "and gives it all back at once.",
  "end": 126.82
 },
 {
  "i": 43,
  "start": 126.82,
  "speechStart": 126.94,
  "speechEnd": 128.52,
  "text": "The further you pull, the more energy.",
  "end": 129.14
 },
 {
  "i": 44,
  "start": 129.14,
  "speechStart": 129.26,
  "speechEnd": 131.4,
  "text": "But there's a catch Luffy never mentions.",
  "end": 131.86
 },
 {
  "i": 45,
  "start": 131.86,
  "speechStart": 131.98,
  "speechEnd": 134.08,
  "text": "Your arm also has to come back.",
  "end": 134.36
 },
 {
  "i": 46,
  "start": 134.36,
  "speechStart": 134.48,
  "speechEnd": 136.2,
  "text": "And it comes back just as fast.",
  "end": 136.8
 },
 {
  "i": 47,
  "start": 136.8,
  "speechStart": 136.92,
  "speechEnd": 140.0,
  "text": "You punch yourself in the face with your own elbow. Twice.",
  "end": 140.88
 },
 {
  "i": 48,
  "start": 140.88,
  "speechStart": 141.0,
  "speechEnd": 141.86,
  "text": "Rule two:",
  "end": 141.74
 },
 {
  "i": 49,
  "start": 141.74,
  "speechStart": 141.86,
  "speechEnd": 143.36,
  "text": "what you throw, comes back.",
  "end": 144.42
 },
 {
  "i": 50,
  "start": 144.42,
  "speechStart": 144.54,
  "speechEnd": 147.34,
  "text": "In One Piece, Luffy beats a man made of lightning,",
  "end": 147.22
 },
 {
  "i": 51,
  "start": 147.22,
  "speechStart": 147.34,
  "speechEnd": 149.88,
  "text": "because his rubber body doesn't conduct electricity.",
  "end": 150.46
 },
 {
  "i": 52,
  "start": 150.46,
  "speechStart": 150.58,
  "speechEnd": 153.14,
  "text": "So on day six, when a thunderstorm rolls in,",
  "end": 153.28
 },
 {
  "i": 53,
  "start": 153.28,
  "speechStart": 153.4,
  "speechEnd": 156.16,
  "text": "you climb to the roof to find out if that's true for you too.",
  "end": 156.98
 },
 {
  "i": 54,
  "start": 156.98,
  "speechStart": 157.1,
  "speechEnd": 158.88,
  "text": "Ordinary rubber would lose this fight.",
  "end": 159.34
 },
 {
  "i": 55,
  "start": 159.34,
  "speechStart": 159.46,
  "speechEnd": 162.66,
  "text": "A typical lightning bolt carries about three hundred million volts.",
  "end": 163.1
 },
 {
  "i": 56,
  "start": 163.1,
  "speechStart": 163.22,
  "speechEnd": 165.58,
  "text": "The thick rubber gloves electricians wear on power lines",
  "end": 165.46
 },
 {
  "i": 57,
  "start": 165.46,
  "speechStart": 165.58,
  "speechEnd": 168.06,
  "text": "are rated for thirty-six thousand.",
  "end": 167.94
 },
 {
  "i": 58,
  "start": 167.94,
  "speechStart": 168.06,
  "speechEnd": 170.42,
  "text": "Lightning is more than eight thousand times that.",
  "end": 170.82
 },
 {
  "i": 59,
  "start": 170.82,
  "speechStart": 170.94,
  "speechEnd": 172.7,
  "text": "Push enough voltage through any insulator",
  "end": 172.86
 },
 {
  "i": 60,
  "start": 172.86,
  "speechStart": 172.98,
  "speechEnd": 174.8,
  "text": "and it suddenly gives up and conducts.",
  "end": 175.48
 },
 {
  "i": 61,
  "start": 175.48,
  "speechStart": 175.6,
  "speechEnd": 177.56,
  "text": "Physicists call it dielectric breakdown.",
  "end": 178.38
 },
 {
  "i": 62,
  "start": 178.38,
  "speechStart": 178.5,
  "speechEnd": 180.28,
  "text": "Even car tyres don't protect you from lightning.",
  "end": 180.58
 },
 {
  "i": 63,
  "start": 180.58,
  "speechStart": 180.7,
  "speechEnd": 182.74,
  "text": "What protects you in a car is the metal body,",
  "end": 182.78
 },
 {
  "i": 64,
  "start": 182.78,
  "speechStart": 182.9,
  "speechEnd": 184.34,
  "text": "which carries the current around you.",
  "end": 184.74
 },
 {
  "i": 65,
  "start": 184.74,
  "speechStart": 184.86,
  "speechEnd": 186.96,
  "text": "But you're not ordinary rubber.",
  "end": 187.44
 },
 {
  "i": 66,
  "start": 187.44,
  "speechStart": 187.56,
  "speechEnd": 189.66,
  "text": "The bolt hits the lightning rod next door,",
  "end": 189.82
 },
 {
  "i": 67,
  "start": 189.82,
  "speechStart": 189.94,
  "speechEnd": 193.04,
  "text": "jumps to you, and nothing happens. No shock.",
  "end": 193.32
 },
 {
  "i": 68,
  "start": 193.32,
  "speechStart": 193.44,
  "speechEnd": 193.86,
  "text": "No pain.",
  "end": 194.48
 },
 {
  "i": 69,
  "start": 194.48,
  "speechStart": 194.6,
  "speechEnd": 197.38,
  "text": "Your body is the one thing in this story that follows the manga.",
  "end": 198.1
 },
 {
  "i": 70,
  "start": 198.1,
  "speechStart": 198.22,
  "speechEnd": 200.66,
  "text": "Your phone, though, is not made of Nika rubber.",
  "end": 200.96
 },
 {
  "i": 71,
  "start": 200.96,
  "speechStart": 201.08,
  "speechEnd": 202.88,
  "text": "And the air around a lightning bolt gets about",
  "end": 202.76
 },
 {
  "i": 72,
  "start": 202.76,
  "speechStart": 202.88,
  "speechEnd": 206.62,
  "text": "five times hotter than the surface of the Sun. Your hoodie is smoking.",
  "end": 207.06
 },
 {
  "i": 73,
  "start": 207.06,
  "speechStart": 207.18,
  "speechEnd": 210.4,
  "text": "Your sneakers have melted to the roof. Rule three:",
  "end": 210.28
 },
 {
  "i": 74,
  "start": 210.28,
  "speechStart": 210.4,
  "speechEnd": 212.48,
  "text": "you beat the voltage. You don't beat the heat.",
  "end": 213.24
 },
 {
  "i": 75,
  "start": 213.24,
  "speechStart": 213.36,
  "speechEnd": 216.52,
  "text": "You get a job loading trucks at a frozen-food warehouse,",
  "end": 216.7
 },
 {
  "i": 76,
  "start": 216.7,
  "speechStart": 216.82,
  "speechEnd": 219.44,
  "text": "because nobody else can carry that many boxes at once.",
  "end": 219.7
 },
 {
  "i": 77,
  "start": 219.7,
  "speechStart": 219.82,
  "speechEnd": 223.34,
  "text": "At minus twenty degrees, your arms feel stiff. Slower.",
  "end": 223.68
 },
 {
  "i": 78,
  "start": 223.68,
  "speechStart": 223.8,
  "speechEnd": 224.7,
  "text": "Like old elastic.",
  "end": 225.54
 },
 {
  "i": 79,
  "start": 225.54,
  "speechStart": 225.66,
  "speechEnd": 227.7,
  "text": "Real rubber has a breaking point in the cold.",
  "end": 228.36
 },
 {
  "i": 80,
  "start": 228.36,
  "speechStart": 228.48,
  "speechEnd": 231.82,
  "text": "Below about minus sixty, natural rubber stops being stretchy",
  "end": 231.7
 },
 {
  "i": 81,
  "start": 231.7,
  "speechStart": 231.82,
  "speechEnd": 233.88,
  "text": "and turns hard and brittle, like glass.",
  "end": 235.04
 },
 {
  "i": 82,
  "start": 235.04,
  "speechStart": 235.16,
  "speechEnd": 237.22,
  "text": "Only a few places on Earth ever get that cold,",
  "end": 237.5
 },
 {
  "i": 83,
  "start": 237.5,
  "speechStart": 237.62,
  "speechEnd": 239.94,
  "text": "deep in Siberia in winter and in Antarctica.",
  "end": 240.5
 },
 {
  "i": 84,
  "start": 240.5,
  "speechStart": 240.62,
  "speechEnd": 243.5,
  "text": "Now you know the two places you'll never take a holiday.",
  "end": 244.68
 },
 {
  "i": 85,
  "start": 244.68,
  "speechStart": 244.8,
  "speechEnd": 246.96,
  "text": "A forklift loses its brakes on a ramp",
  "end": 246.84
 },
 {
  "i": 86,
  "start": 246.84,
  "speechStart": 246.96,
  "speechEnd": 248.84,
  "text": "and rolls toward a coworker.",
  "end": 249.1
 },
 {
  "i": 87,
  "start": 249.1,
  "speechStart": 249.22,
  "speechEnd": 252.24,
  "text": "You do the thing Luffy does when he needs speed. Gear 2.",
  "end": 252.64
 },
 {
  "i": 88,
  "start": 252.64,
  "speechStart": 252.76,
  "speechEnd": 255.9,
  "text": "You pump your blood faster, and your skin starts to steam.",
  "end": 256.38
 },
 {
  "i": 89,
  "start": 256.38,
  "speechStart": 256.5,
  "speechEnd": 258.8,
  "text": "You move faster than anyone in the warehouse can see.",
  "end": 259.38
 },
 {
  "i": 90,
  "start": 259.38,
  "speechStart": 259.5,
  "speechEnd": 261.38,
  "text": "The forklift stops against your hands.",
  "end": 262.22
 },
 {
  "i": 91,
  "start": 262.22,
  "speechStart": 262.34,
  "speechEnd": 264.3,
  "text": "Here's what Gear 2 does to a real body.",
  "end": 264.18
 },
 {
  "i": 92,
  "start": 264.18,
  "speechStart": 264.3,
  "speechEnd": 267.22,
  "text": "A healthy heart's maximum is roughly two hundred",
  "end": 267.1
 },
 {
  "i": 93,
  "start": 267.1,
  "speechStart": 267.22,
  "speechEnd": 268.68,
  "text": "and twenty minus your age.",
  "end": 268.56
 },
 {
  "i": 94,
  "start": 268.56,
  "speechStart": 268.68,
  "speechEnd": 271.66,
  "text": "For a twenty-year-old, around two hundred beats a minute.",
  "end": 272.18
 },
 {
  "i": 95,
  "start": 272.18,
  "speechStart": 272.3,
  "speechEnd": 274.46,
  "text": "Gear 2 pushes past that, on purpose.",
  "end": 275.14
 },
 {
  "i": 96,
  "start": 275.14,
  "speechStart": 275.26,
  "speechEnd": 278.6,
  "text": "In the early story, people warned Luffy that it was shortening his life.",
  "end": 279.08
 },
 {
  "i": 97,
  "start": 279.08,
  "speechStart": 279.2,
  "speechEnd": 283.46,
  "text": "You sit on a crate afterwards, your heart racing for an hour. Rule four:",
  "end": 284.12
 },
 {
  "i": 98,
  "start": 284.12,
  "speechStart": 284.24,
  "speechEnd": 288.84,
  "text": "speed is borrowed. You pay it back. Gear 3.",
  "end": 288.72
 },
 {
  "i": 99,
  "start": 288.72,
  "speechStart": 288.84,
  "speechEnd": 292.32,
  "text": "You bite your thumb and blow into it, and your bones inflate.",
  "end": 292.78
 },
 {
  "i": 100,
  "start": 292.78,
  "speechStart": 292.9,
  "speechEnd": 294.82,
  "text": "Your fist becomes the size of a car.",
  "end": 295.4
 },
 {
  "i": 101,
  "start": 295.4,
  "speechStart": 295.52,
  "speechEnd": 297.0,
  "text": "A steel beam slips off a crane.",
  "end": 296.88
 },
 {
  "i": 102,
  "start": 296.88,
  "speechStart": 297.0,
  "speechEnd": 300.1,
  "text": "You catch it with a hand as big as a garage door.",
  "end": 299.98
 },
 {
  "i": 103,
  "start": 299.98,
  "speechStart": 300.1,
  "speechEnd": 302.42,
  "text": "And then, like early Luffy,",
  "end": 302.68
 },
 {
  "i": 104,
  "start": 302.68,
  "speechStart": 302.8,
  "speechEnd": 304.58,
  "text": "your body shrinks back down for a while.",
  "end": 305.16
 },
 {
  "i": 105,
  "start": 305.16,
  "speechStart": 305.28,
  "speechEnd": 307.38,
  "text": "You walk home the size of a ten-year-old,",
  "end": 307.26
 },
 {
  "i": 106,
  "start": 307.26,
  "speechStart": 307.38,
  "speechEnd": 310.5,
  "text": "in clothes that are far too big. Rule five:",
  "end": 311.08
 },
 {
  "i": 107,
  "start": 311.08,
  "speechStart": 311.2,
  "speechEnd": 314.96,
  "text": "big now, small later. By now there are videos.",
  "end": 315.48
 },
 {
  "i": 108,
  "start": 315.48,
  "speechStart": 315.6,
  "speechEnd": 317.16,
  "text": "A forklift. A crane.",
  "end": 317.62
 },
 {
  "i": 109,
  "start": 317.62,
  "speechStart": 317.74,
  "speechEnd": 320.62,
  "text": "A kid who suddenly got very small, very fast.",
  "end": 321.6
 },
 {
  "i": 110,
  "start": 321.6,
  "speechStart": 321.72,
  "speechEnd": 322.86,
  "text": "Nobody has your name yet.",
  "end": 323.14
 },
 {
  "i": 111,
  "start": 323.14,
  "speechStart": 323.26,
  "speechEnd": 326.04,
  "text": "But two people in suits knock on your door",
  "end": 325.92
 },
 {
  "i": 112,
  "start": 325.92,
  "speechStart": 326.04,
  "speechEnd": 330.1,
  "text": "and ask, very politely, if you'd like a job. You say no.",
  "end": 330.96
 },
 {
  "i": 113,
  "start": 330.96,
  "speechStart": 331.08,
  "speechEnd": 333.62,
  "text": "They leave a card. They don't seem surprised.",
  "end": 334.58
 },
 {
  "i": 114,
  "start": 334.58,
  "speechStart": 334.7,
  "speechEnd": 338.04,
  "text": "That night you try the strongest form you know: Gear 4.",
  "end": 338.84
 },
 {
  "i": 115,
  "start": 338.84,
  "speechStart": 338.96,
  "speechEnd": 342.06,
  "text": "You blow air into your muscles until they swell like armour,",
  "end": 341.94
 },
 {
  "i": 116,
  "start": 341.94,
  "speechStart": 342.06,
  "speechEnd": 344.18,
  "text": "and your arms and legs turn black and hard.",
  "end": 344.94
 },
 {
  "i": 117,
  "start": 344.94,
  "speechStart": 345.06,
  "speechEnd": 348.22,
  "text": "In One Piece that black coating is Armament Haki,",
  "end": 348.1
 },
 {
  "i": 118,
  "start": 348.1,
  "speechStart": 348.22,
  "speechEnd": 350.48,
  "text": "a willpower that hardens the skin like steel.",
  "end": 351.32
 },
 {
  "i": 119,
  "start": 351.32,
  "speechStart": 351.44,
  "speechEnd": 353.36,
  "text": "For about a minute, nothing can touch you.",
  "end": 354.22
 },
 {
  "i": 120,
  "start": 354.22,
  "speechStart": 354.34,
  "speechEnd": 357.22,
  "text": "Then it ends, and Luffy's rule hits you too.",
  "end": 358.08
 },
 {
  "i": 121,
  "start": 358.08,
  "speechStart": 358.2,
  "speechEnd": 359.54,
  "text": "No armour.",
  "end": 359.42
 },
 {
  "i": 122,
  "start": 359.42,
  "speechStart": 359.54,
  "speechEnd": 361.42,
  "text": "No Haki.",
  "end": 361.3
 },
 {
  "i": 123,
  "start": 361.3,
  "speechStart": 361.42,
  "speechEnd": 364.86,
  "text": "Ten whole minutes where you're just a tired person in a parking lot.",
  "end": 365.8
 },
 {
  "i": 124,
  "start": 365.8,
  "speechStart": 365.92,
  "speechEnd": 367.68,
  "text": "The next night, you notice a drone.",
  "end": 368.34
 },
 {
  "i": 125,
  "start": 368.34,
  "speechStart": 368.46,
  "speechEnd": 370.72,
  "text": "It has been following you since you left the warehouse.",
  "end": 371.32
 },
 {
  "i": 126,
  "start": 371.32,
  "speechStart": 371.44,
  "speechEnd": 375.0,
  "text": "The people in suits didn't come back to talk. They came back to watch.",
  "end": 374.88
 },
 {
  "i": 127,
  "start": 374.88,
  "speechStart": 375.0,
  "speechEnd": 377.2,
  "text": "And now they know exactly",
  "end": 377.08
 },
 {
  "i": 128,
  "start": 377.08,
  "speechStart": 377.2,
  "speechEnd": 379.14,
  "text": "how long your strongest form lasts,",
  "end": 379.02
 },
 {
  "i": 129,
  "start": 379.02,
  "speechStart": 379.14,
  "speechEnd": 382.0,
  "text": "and exactly how long you're open afterwards.",
  "end": 381.88
 },
 {
  "i": 130,
  "start": 381.88,
  "speechStart": 382.0,
  "speechEnd": 384.82,
  "text": "Ten minutes is enough for a net,",
  "end": 385.44
 },
 {
  "i": 131,
  "start": 385.44,
  "speechStart": 385.56,
  "speechEnd": 387.76,
  "text": "a van, and a very quiet drive.",
  "end": 388.62
 },
 {
  "i": 132,
  "start": 388.62,
  "speechStart": 388.74,
  "speechEnd": 391.42,
  "text": "So you make a new rule, the one Luffy never needed",
  "end": 391.3
 },
 {
  "i": 133,
  "start": 391.3,
  "speechStart": 391.42,
  "speechEnd": 393.08,
  "text": "because he always had his crew:",
  "end": 393.78
 },
 {
  "i": 134,
  "start": 393.78,
  "speechStart": 393.9,
  "speechEnd": 397.82,
  "text": "never use Gear 4 alone. Rule six:",
  "end": 397.7
 },
 {
  "i": 135,
  "start": 397.7,
  "speechStart": 397.82,
  "speechEnd": 399.68,
  "text": "your strongest minute is also",
  "end": 399.56
 },
 {
  "i": 136,
  "start": 399.56,
  "speechStart": 399.68,
  "speechEnd": 402.94,
  "text": "your weakest ten. Day forty.",
  "end": 402.82
 },
 {
  "i": 137,
  "start": 402.82,
  "speechStart": 402.94,
  "speechEnd": 405.88,
  "text": "A gas main explodes under a busy square.",
  "end": 406.48
 },
 {
  "i": 138,
  "start": 406.48,
  "speechStart": 406.6,
  "speechEnd": 407.2,
  "text": "Cars tip over.",
  "end": 407.34
 },
 {
  "i": 139,
  "start": 407.34,
  "speechStart": 407.46,
  "speechEnd": 409.34,
  "text": "A bus is sliding toward the hole.",
  "end": 409.84
 },
 {
  "i": 140,
  "start": 409.84,
  "speechStart": 409.96,
  "speechEnd": 413.12,
  "text": "Your heart starts to drum. Boom. Boom.",
  "end": 413.0
 },
 {
  "i": 141,
  "start": 413.0,
  "speechStart": 413.12,
  "speechEnd": 417.28,
  "text": "Boom-boom. Gear 5. Your hair turns white.",
  "end": 417.92
 },
 {
  "i": 142,
  "start": 417.92,
  "speechStart": 418.04,
  "speechEnd": 419.76,
  "text": "You laugh, and you don't know why.",
  "end": 419.88
 },
 {
  "i": 143,
  "start": 419.88,
  "speechStart": 420.0,
  "speechEnd": 421.78,
  "text": "And the rules stop applying.",
  "end": 422.4
 },
 {
  "i": 144,
  "start": 422.4,
  "speechStart": 422.52,
  "speechEnd": 424.5,
  "text": "You turn the road itself into rubber.",
  "end": 424.94
 },
 {
  "i": 145,
  "start": 424.94,
  "speechStart": 425.06,
  "speechEnd": 427.42,
  "text": "The bus bounces back onto the street like a toy.",
  "end": 428.1
 },
 {
  "i": 146,
  "start": 428.1,
  "speechStart": 428.22,
  "speechEnd": 430.8,
  "text": "You stretch the falling streetlights into soft loops",
  "end": 430.68
 },
 {
  "i": 147,
  "start": 430.68,
  "speechStart": 430.8,
  "speechEnd": 432.16,
  "text": "and lay them down gently.",
  "end": 432.74
 },
 {
  "i": 148,
  "start": 432.74,
  "speechStart": 432.86,
  "speechEnd": 435.62,
  "text": "For thirty seconds, the whole city is a cartoon,",
  "end": 435.9
 },
 {
  "i": 149,
  "start": 435.9,
  "speechStart": 436.02,
  "speechEnd": 437.98,
  "text": "and you are the only one drawing it.",
  "end": 438.48
 },
 {
  "i": 150,
  "start": 438.48,
  "speechStart": 438.6,
  "speechEnd": 441.12,
  "text": "The people in the square don't scream. They stare.",
  "end": 441.72
 },
 {
  "i": 151,
  "start": 441.72,
  "speechStart": 441.84,
  "speechEnd": 444.0,
  "text": "One woman laughs with you without knowing why.",
  "end": 444.42
 },
 {
  "i": 152,
  "start": 444.42,
  "speechStart": 444.54,
  "speechEnd": 446.78,
  "text": "A man films everything with his mouth open.",
  "end": 447.44
 },
 {
  "i": 153,
  "start": 447.44,
  "speechStart": 447.56,
  "speechEnd": 449.32,
  "text": "And you can't stop laughing.",
  "end": 450.1
 },
 {
  "i": 154,
  "start": 450.1,
  "speechStart": 450.22,
  "speechEnd": 451.7,
  "text": "It isn't happiness exactly.",
  "end": 452.06
 },
 {
  "i": 155,
  "start": 452.06,
  "speechStart": 452.18,
  "speechEnd": 454.04,
  "text": "It's the power itself, loud",
  "end": 453.92
 },
 {
  "i": 156,
  "start": 453.92,
  "speechStart": 454.04,
  "speechEnd": 456.44,
  "text": "and free, like a song you can't turn off.",
  "end": 457.26
 },
 {
  "i": 157,
  "start": 457.26,
  "speechStart": 457.38,
  "speechEnd": 460.2,
  "text": "Somewhere in the back of your head, a quieter voice is counting.",
  "end": 460.84
 },
 {
  "i": 158,
  "start": 460.84,
  "speechStart": 460.96,
  "speechEnd": 463.14,
  "text": "Because every second of this is being paid for.",
  "end": 464.06
 },
 {
  "i": 159,
  "start": 464.06,
  "speechStart": 464.18,
  "speechEnd": 465.6,
  "text": "Then it ends.",
  "end": 465.98
 },
 {
  "i": 160,
  "start": 465.98,
  "speechStart": 466.1,
  "speechEnd": 469.3,
  "text": "And the cost of Gear 5 arrives all at once,",
  "end": 469.5
 },
 {
  "i": 161,
  "start": 469.5,
  "speechStart": 469.62,
  "speechEnd": 470.78,
  "text": "just like it does for Luffy.",
  "end": 471.42
 },
 {
  "i": 162,
  "start": 471.42,
  "speechStart": 471.54,
  "speechEnd": 472.96,
  "text": "Your face goes wrinkled.",
  "end": 473.1
 },
 {
  "i": 163,
  "start": 473.1,
  "speechStart": 473.22,
  "speechEnd": 474.54,
  "text": "Your legs won't hold you.",
  "end": 474.82
 },
 {
  "i": 164,
  "start": 474.82,
  "speechStart": 474.94,
  "speechEnd": 476.32,
  "text": "You look eighty years old,",
  "end": 476.3
 },
 {
  "i": 165,
  "start": 476.3,
  "speechStart": 476.42,
  "speechEnd": 480.62,
  "text": "sitting on the curb, laughing at nothing. It wears off by morning.",
  "end": 481.16
 },
 {
  "i": 166,
  "start": 481.16,
  "speechStart": 481.28,
  "speechEnd": 482.16,
  "text": "But now you know:",
  "end": 482.68
 },
 {
  "i": 167,
  "start": 482.68,
  "speechStart": 482.8,
  "speechEnd": 485.1,
  "text": "the most powerful thing you can do is",
  "end": 484.98
 },
 {
  "i": 168,
  "start": 484.98,
  "speechStart": 485.1,
  "speechEnd": 487.04,
  "text": "also the thing you can do least.",
  "end": 488.08
 },
 {
  "i": 169,
  "start": 488.08,
  "speechStart": 488.2,
  "speechEnd": 491.02,
  "text": "So if you woke up tomorrow made of rubber,",
  "end": 491.44
 },
 {
  "i": 170,
  "start": 491.44,
  "speechStart": 491.56,
  "speechEnd": 492.9,
  "text": "which gear would you use first?",
  "end": 493.42
 },
 {
  "i": 171,
  "start": 493.42,
  "speechStart": 493.54,
  "speechEnd": 496.68,
  "text": "And which one would you never touch? Tell us in the comments.",
  "end": 498.28
 }
]